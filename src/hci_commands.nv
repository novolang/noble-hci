// orbit/noble-hci/src/hci_commands.nv — typed HCI Command / Event table.
//
// Core Vol 4 Part E §7.  OpCodes + EventCodes for the subset this
// stack uses: HCI_Reset, HCI_Read_BD_ADDR, LE_Read_Buffer_Size,
// LE_Set_Advertising_Parameters / Data / ScanResponseData /
// Enable, LE_Set_Scan_Parameters / Enable, LE_Create_Connection,
// HCI_Disconnect, LE_Read_Local_Supported_Features.  Commands
// outside that list have no entry here.
//
// Two flavours per command:
//   1. `opcode_<name>()` — returns the 16-bit wire OpCode.
//      Used by the framing layer + the controller-side
//      dispatcher to select on a raw OpCode value.
//   2. `build_<name>(...)` — returns a `[u8]` payload ready to
//      drop into the HCI Command frame's variable tail.  Only
//      wired for commands with non-trivial parameters; no-param
//      commands (HCI_Reset, LE_Read_Buffer_Size) just need the
//      opcode + length=0.
//
// Satisfies: REQ-BLE-HCI-004 (HCI_Reset) through REQ-BLE-HCI-018
// (LE_Set_Advertising_Enable), REQ-BLE-HCI-050 (event code
// coverage — partial: only the events the list above can provoke).

use std.test
use std.bits

// ═════════════════════════════════════════════════════════════════════
// Link-control commands  (OGF 0x01)
// ═════════════════════════════════════════════════════════════════════

@tier(embedded)
@no_alloc
fn opcode_hci_disconnect() -> Int
    // OGF=0x01, OCF=0x0006 → 0x0406.
    (0x01 << 10) | 0x006

// Reason Remote User Terminated Connection (0x13), one of the Reason
// values the Disconnect command takes ([Vol 4] Part E, Section 7.1.6).
const DISCONNECT_REASON_REMOTE_USER_TERMINATED = 0x13

// Reason Remote Device Terminated Connection due to Low Resources (0x14):
// the Reason of a Host that ends a connection it has no slot for ([Vol 4]
// Part E, Section 7.1.6).
const DISCONNECT_REASON_LOW_RESOURCES = 0x14

// The parameters of the Disconnect command ([Vol 4] Part E, Section
// 7.1.6): Connection_Handle, 2 octets least significant first, then
// Reason.
@tier(embedded)
fn build_disconnect(connection_handle: Int, reason: Int) -> [u8]
    [(connection_handle & 0xFF) as u8, ((connection_handle >>> 8) & 0x0F) as u8, reason as u8]

// ═════════════════════════════════════════════════════════════════════
// Controller + Baseband commands  (OGF 0x03)
// ═════════════════════════════════════════════════════════════════════

@satisfies("REQ-BLE-HCI-004")
@tier(embedded)
@no_alloc
fn opcode_hci_reset() -> Int
    // OGF=0x03, OCF=0x0003 → 0x0C03.
    (0x03 << 10) | 0x003

@satisfies("REQ-BLE-HCI-009")
@tier(embedded)
@no_alloc
fn opcode_hci_set_event_mask() -> Int
    // OGF=0x03, OCF=0x0001 → 0x0C01.
    (0x03 << 10) | 0x001

// ── Controller-to-Host flow control ─────────────────────────────────
//
// A Host that cannot take every ACL packet a Controller may send tells it
// its buffers and counts the packets it frees ([Vol 4] Part E, Section
// 4.1.1 and Sections 7.3.38 to 7.3.40).  The Host sends Host Buffer Size
// first, then Set Controller To Host Flow Control to turn the flow control
// on; from then on the Controller sends no ACL packet longer than the
// Host_ACL_Data_Packet_Length and no more packets than the
// Host_Total_Num_ACL_Data_Packets it has not seen returned, and the Host
// returns each buffer with Host Number Of Completed Packets, which has no
// event in answer.  A Controller lists the three commands in Supported_Commands
// octet 10, bits 5 to 7, and a Host sends them only to one that does.

// [Vol 4] Part E, Section 7.3.38 — Set Controller To Host Flow Control.
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
@no_alloc
fn opcode_set_controller_to_host_flow_control() -> Int
    // OGF=0x03, OCF=0x0031 → 0x0C31.
    (0x03 << 10) | 0x031

// [Vol 4] Part E, Section 7.3.39 — Host Buffer Size.
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
@no_alloc
fn opcode_host_buffer_size() -> Int
    // OGF=0x03, OCF=0x0033 → 0x0C33.
    (0x03 << 10) | 0x033

// [Vol 4] Part E, Section 7.3.40 — Host Number Of Completed Packets.
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
@no_alloc
fn opcode_host_number_of_completed_packets() -> Int
    // OGF=0x03, OCF=0x0035 → 0x0C35.
    (0x03 << 10) | 0x035

// Flow_Control_Enable values of Set Controller To Host Flow Control.
const FLOW_CONTROL_OFF = 0x00
const FLOW_CONTROL_ACL = 0x01

// The parameter of Set Controller To Host Flow Control: Flow_Control_Enable.
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
fn build_set_controller_to_host_flow_control(enable: Int) -> [u8]
    [enable as u8]

// The 7 parameter octets of Host Buffer Size: Host_ACL_Data_Packet_Length
// (2), Host_Synchronous_Data_Packet_Length (1), Host_Total_Num_ACL_Data_Packets
// (2) and Host_Total_Num_Synchronous_Data_Packets (2).  A Host with no
// synchronous data gives 0 for the last two ([Vol 4] Part E, Section 7.3.39).
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
fn build_host_buffer_size(acl_length: Int, acl_total: Int) -> [u8]
    [(acl_length & 0xFF) as u8, ((acl_length >>> 8) & 0xFF) as u8, 0x00,
     (acl_total & 0xFF) as u8, ((acl_total >>> 8) & 0xFF) as u8, 0x00, 0x00]

// The parameters of Host Number Of Completed Packets for one handle:
// Num_Handles (1), Connection_Handle (2) and Host_Num_Of_Completed_Packets
// (2) ([Vol 4] Part E, Section 7.3.40).
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
fn build_host_number_of_completed_packets(connection_handle: Int, count: Int) -> [u8]
    [0x01, (connection_handle & 0xFF) as u8, ((connection_handle >>> 8) & 0x0F) as u8,
     (count & 0xFF) as u8, ((count >>> 8) & 0xFF) as u8]

// The parameters of Host Number Of Completed Packets for several handles:
// Num_Handles (1), then Connection_Handle[i] (2 each) and
// Host_Num_Of_Completed_Packets[i] (2 each), the handles first and the counts
// after them ([Vol 4] Part E, Section 7.3.40).  `handles` and `counts` are
// as long as each other.
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
fn build_host_number_of_completed_packets_list(handles: [Int], counts: [Int]) -> [u8]
    var out: [u8] = [list.len(handles) as u8]
    for h in handles
        list.push(out, (h & 0xFF) as u8)
        list.push(out, ((h >>> 8) & 0x0F) as u8)
    for n in counts
        list.push(out, (n & 0xFF) as u8)
        list.push(out, ((n >>> 8) & 0xFF) as u8)
    out

// Whether `commands`, the 64 octets of Supported_Commands, lists Host Buffer
// Size, octet 10 bit 6 ([Vol 4] Part E, Section 6.27).
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
@no_alloc
fn has_host_buffer_size(commands: [u8]) -> Bool
    list.len(commands) > 10 and ((commands[10] as Int) & 0x40) == 0x40

// Whether `commands`, the 64 octets of Supported_Commands, lists the three
// commands of Controller-to-Host flow control: Set Controller To Host Flow
// Control, Host Buffer Size and Host Number Of Completed Packets, octet 10
// bits 5, 6 and 7 ([Vol 4] Part E, Section 6.27).  An answer too short to
// reach the octet, or none at all, lists nothing.
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
@no_alloc
fn has_controller_to_host_flow_control(commands: [u8]) -> Bool
    list.len(commands) > 10 and ((commands[10] as Int) & 0xE0) == 0xE0

@test
@satisfies("REQ-BLE-HCI-059")
fn test_flow_control_opcodes_and_parameters()
    test.assert_eq(opcode_set_controller_to_host_flow_control(), 0x0C31)
    test.assert_eq(opcode_host_buffer_size(), 0x0C33)
    test.assert_eq(opcode_host_number_of_completed_packets(), 0x0C35)
    test.assert_eq(build_set_controller_to_host_flow_control(FLOW_CONTROL_ACL)[0] as Int, 0x01)
    let size = build_host_buffer_size(251, 3)
    test.assert_eq(list.len(size), 7)
    test.assert_eq(size[0] as Int, 251)
    test.assert_eq(size[1] as Int, 0)
    test.assert_eq(size[2] as Int, 0)
    test.assert_eq(size[3] as Int, 3)
    test.assert_eq(size[4] as Int, 0)
    test.assert_eq(size[5] as Int, 0)
    test.assert_eq(size[6] as Int, 0)
    let done = build_host_number_of_completed_packets(0x0123, 1)
    test.assert_eq(list.len(done), 5)
    test.assert_eq(done[0] as Int, 1)
    test.assert_eq(done[1] as Int, 0x23)
    test.assert_eq(done[2] as Int, 0x01)
    test.assert_eq(done[3] as Int, 1)
    test.assert_eq(done[4] as Int, 0)
    // Two handles: the count, both handles, then both counts.
    let two = build_host_number_of_completed_packets_list([0x0040, 0x0041], [3, 0x0102])
    test.assert_eq(list.len(two), 9)
    test.assert_eq(two[0] as Int, 2)
    test.assert_eq(two[1] as Int, 0x40)
    test.assert_eq(two[3] as Int, 0x41)
    test.assert_eq(two[5] as Int, 3)
    test.assert_eq(two[7] as Int, 0x02)
    test.assert_eq(two[8] as Int, 0x01)

@test
@satisfies("REQ-BLE-HCI-059")
fn test_the_flow_control_supported_command_bits()
    var listed: [u8] = []
    for i in 0..64
        list.push(listed, if i == 10 then 0xE0 else 0x00)
    test.assert_eq(has_controller_to_host_flow_control(listed), true)
    // Read Transmit Power Level (bit 2) is not one of the three, and a
    // Controller that lists only some of them is not served.
    listed[10] = 0x04
    test.assert_eq(has_controller_to_host_flow_control(listed), false)
    listed[10] = 0xA0
    test.assert_eq(has_controller_to_host_flow_control(listed), false)
    listed[10] = 0xFF
    test.assert_eq(has_controller_to_host_flow_control(listed), true)
    test.assert_eq(has_controller_to_host_flow_control([0xFF]), false)
    // Host Buffer Size alone is bit 6.
    listed[10] = 0x40
    test.assert_eq(has_host_buffer_size(listed), true)
    listed[10] = 0xA0
    test.assert_eq(has_host_buffer_size(listed), false)
    test.assert_eq(has_host_buffer_size([]), false)
    test.assert_eq(has_controller_to_host_flow_control([]), false)

