    (0x04 << 10) | 0x001

// The opcode of the Read Local Supported Commands command, 0x1002 ([Vol 4] Part E, Section 7.4.2).
pub @satisfies("REQ-BLE-HCI-007")
@tier(embedded)
@no_alloc
fn opcode_read_local_supported_commands() -> Int
    // OGF=0x04, OCF=0x0002 → 0x1002.
    (0x04 << 10) | 0x002

// The opcode of the Read Local Supported Features command, 0x1003 ([Vol 4] Part E, Section 7.4.3).
pub @satisfies("REQ-BLE-HCI-008")
@tier(embedded)
@no_alloc
fn opcode_read_local_supported_features() -> Int
    // OGF=0x04, OCF=0x0003 → 0x1003.
    (0x04 << 10) | 0x003

// The opcode of the Read BD_ADDR command, 0x1009 ([Vol 4] Part E, Section 7.4.6).
pub @satisfies("REQ-BLE-HCI-005")
@tier(embedded)
@no_alloc
fn opcode_read_bd_addr() -> Int
    // OGF=0x04, OCF=0x0009 → 0x1009.
    (0x04 << 10) | 0x009

// The opcode of the Read Buffer Size command, 0x1005 ([Vol 4] Part E, Section 7.4.5).
//
// It is the BR/EDR form of the buffer query; an LE-only Controller answers it with zero sizes, and the LE form is
// `opcode_le_read_buffer_size`.
pub @tier(embedded)
@no_alloc
fn opcode_read_buffer_size() -> Int
    // OGF=0x04, OCF=0x0005 → 0x1005.
    (0x04 << 10) | 0x005

