// ── Periodic advertising (Vol 4 Part E §7.8.61-7.8.63) ──────────────
//
// Periodic advertising belongs to an advertising set: the set carries
// the periodic advertising parameters, the data and the enable, and the
// Controller transmits the periodic advertising train beside the
// advertising events.  A set that carries periodic advertising shall not
// use connectable, scannable, legacy or anonymous advertising
// ([Vol 4] Part E, Section 7.8.53).

// [Vol 4] Part E, Section 7.8.61 — LE Set Periodic Advertising Parameters
// command [v1].
pub @satisfies("REQ-BLE-HCI-052")
@tier(embedded)
@no_alloc
fn opcode_le_set_periodic_advertising_parameters() -> Int
    // OGF=0x08, OCF=0x003E → 0x203E.
    (0x08 << 10) | 0x03E

// [Vol 4] Part E, Section 7.8.61 — LE Set Periodic Advertising Parameters
// command [v2], the form a train with responses takes: the same four
// parameters as the first form and then the five that describe the
// subevents ([Vol 4] Part E, Section 7.8.61, "Num_Subevents ... if
// Num_Subevents is greater than 0, then the Periodic Advertising is
// PAwR").  A Host that wants no responses sends the first form and a
// Controller tells the two apart by the parameter length.
pub @satisfies("REQ-BLE-HCI-056")
@tier(embedded)
@no_alloc
fn opcode_le_set_periodic_advertising_parameters_v2() -> Int
    // OGF=0x08, OCF=0x0086 → 0x2086.
    (0x08 << 10) | 0x086

// [Vol 4] Part E, Section 7.8.62 — LE Set Periodic Advertising Data
// command.
pub @satisfies("REQ-BLE-HCI-052")
@tier(embedded)
@no_alloc
fn opcode_le_set_periodic_advertising_data() -> Int
    // OGF=0x08, OCF=0x003F → 0x203F.
    (0x08 << 10) | 0x03F

// [Vol 4] Part E, Section 7.8.63 — LE Set Periodic Advertising Enable
// command.
pub @satisfies("REQ-BLE-HCI-052")
@tier(embedded)
@no_alloc
fn opcode_le_set_periodic_advertising_enable() -> Int
    // OGF=0x08, OCF=0x0040 → 0x2040.
    (0x08 << 10) | 0x040

// ── Periodic advertising synchronization (Vol 4 Part E §7.8.88-7.8.92) ─
//
// The Periodic Advertising Synchronization Transfer procedure moves the
// synchronization information of a periodic advertising train from a
// device that has it — a synchronized Observer or Central, or the
// Periodic Advertiser itself — to the peer of an LE connection
// ([Vol 3] Part C, Section 9.5.4).  On the wire it is the Link Layer
// procedure of [Vol 6] Part B, Section 5.1.13, and the Host drives it
// with the commands below: the receiver states how it will treat the
// information, and the sender hands over the train it knows.

// [Vol 4] Part E, Section 7.8.64 — LE Set Extended Scan Parameters command
// [v1], the scanning counterpart of the extended advertising commands: it
// takes the PHYs to scan and one set of parameters per PHY.  This Host
// uses it for the scan a periodic advertising synchronization needs,
// because that synchronization is an extended advertising procedure and
// the Controller holds the two families apart (Section 3.1.1): a legacy
// scan command pins the session to the legacy family and the
// synchronization commands are then answered Command Disallowed.
pub @tier(embedded)
@no_alloc
fn opcode_le_set_extended_scan_parameters() -> Int
    // OGF=0x08, OCF=0x0041 → 0x2041.
    (0x08 << 10) | 0x041

// The opcode of the LE Set Extended Scan Enable command, 0x2042 ([Vol 4] Part E, Section 7.8.65).
pub @tier(embedded)
@no_alloc
fn opcode_le_set_extended_scan_enable() -> Int
    // OGF=0x08, OCF=0x0042 → 0x2042.
    (0x08 << 10) | 0x042

// [Vol 4] Part E, Section 7.8.67 — LE Periodic Advertising Create Sync
// command, the Observer's: it asks the Controller to find the periodic
// advertising train an Advertising SID and an advertiser address name,
// synchronize to it, and report the train with the LE Periodic
// Advertising Sync Established event.  The command is answered by a
// Command Status event; the sync follows on its own.
pub @satisfies("REQ-BLE-HCI-055")
@tier(embedded)
@no_alloc
fn opcode_le_periodic_advertising_create_sync() -> Int
    // OGF=0x08, OCF=0x0044 → 0x2044.
    (0x08 << 10) | 0x044

// [Vol 4] Part E, Section 7.8.68 — LE Periodic Advertising Create Sync
// Cancel command, which ends one that is still pending.
pub @satisfies("REQ-BLE-HCI-055")
@tier(embedded)
@no_alloc
fn opcode_le_periodic_advertising_create_sync_cancel() -> Int
    // OGF=0x08, OCF=0x0045 → 0x2045.
    (0x08 << 10) | 0x045

// [Vol 4] Part E, Section 7.8.69 — LE Periodic Advertising Terminate Sync
// command, which stops reception of the train a Sync_Handle names.
pub @satisfies("REQ-BLE-HCI-055")
@tier(embedded)
@no_alloc
fn opcode_le_periodic_advertising_terminate_sync() -> Int
    // OGF=0x08, OCF=0x0046 → 0x2046.
    (0x08 << 10) | 0x046

// [Vol 4] Part E, Section 7.8.88 — LE Set Periodic Advertising Receive
// Enable command, which starts or stops reports for a train the device
// is synchronized to.
pub @tier(embedded)
@no_alloc
fn opcode_le_set_periodic_advertising_receive_enable() -> Int
    // OGF=0x08, OCF=0x0059 → 0x2059.
    (0x08 << 10) | 0x059

// [Vol 4] Part E, Section 7.8.89 — LE Periodic Advertising Sync Transfer
// command: send what is known about the train Sync_Handle names to the
// peer of Connection_Handle.
pub @satisfies("REQ-BLE-HCI-053")
@tier(embedded)
@no_alloc
fn opcode_le_periodic_advertising_sync_transfer() -> Int
    // OGF=0x08, OCF=0x005A → 0x205A.
    (0x08 << 10) | 0x05A

// [Vol 4] Part E, Section 7.8.90 — LE Periodic Advertising Set Info
// Transfer command: send the synchronization information of the periodic
// advertising in an advertising set this device is advertising, which is
// what a Periodic Advertiser transfers with.
pub @satisfies("REQ-BLE-HCI-053")
@tier(embedded)
@no_alloc
fn opcode_le_periodic_advertising_set_info_transfer() -> Int
    // OGF=0x08, OCF=0x005B → 0x205B.
    (0x08 << 10) | 0x05B

// [Vol 4] Part E, Section 7.8.91 — LE Set Periodic Advertising Sync
// Transfer Parameters command: what to do with synchronization
// information the peer of Connection_Handle sends.
pub @satisfies("REQ-BLE-HCI-054")
@tier(embedded)
@no_alloc
fn opcode_le_set_periodic_advertising_sync_transfer_parameters() -> Int
    // OGF=0x08, OCF=0x005C → 0x205C.
    (0x08 << 10) | 0x05C

// [Vol 4] Part E, Section 7.8.92 — LE Set Default Periodic Advertising
// Sync Transfer Parameters command: the same, for every connection that
// follows.
pub @tier(embedded)
@no_alloc
fn opcode_le_set_default_periodic_advertising_sync_transfer_parameters() -> Int
    // OGF=0x08, OCF=0x005D → 0x205D.
    (0x08 << 10) | 0x05D

// ── Periodic advertising with responses (Vol 4 Part E §7.8.125-127) ──
//
// A train with responses carries a number of subevents per periodic
// advertising event and, inside a subevent, a number of response slots a
// synchronized device may answer in ([Vol 6] Part B, Section 2.3.4.6).
// The Advertiser splits the data of a periodic event across its
// subevents, so what it sends is subevent data and not periodic
// advertising data: the Controller asks for it with the LE Periodic
// Advertising Subevent Data Request event and the Host answers with the
// LE Set Periodic Advertising Subevent Data command, each subevent
// naming the response slots it will listen in.  What the synchronized
// devices answered comes back as the LE Periodic Advertising Response
// Report event.
//
// The other end of the train, which is synchronized to it, answers in a
// response slot with the LE Set Periodic Advertising Response Data
// command (Section 7.8.126) and picks the subevents it listens to with
// the LE Set Periodic Sync Subevent command (Section 7.8.127).  Those
// two are the Observer's and this Host does not serve them yet.

// [Vol 4] Part E, Section 7.8.125 — LE Set Periodic Advertising Subevent
// Data command: the advertising data of one or more subevents, in reply
// to an LE Periodic Advertising Subevent Data Request event.
pub @satisfies("REQ-BLE-HCI-056")
@tier(embedded)
@no_alloc
fn opcode_le_set_periodic_advertising_subevent_data() -> Int
    // OGF=0x08, OCF=0x0082 → 0x2082.
    (0x08 << 10) | 0x082

// ── Encryption commands (Vol 4 Part E §7.8.22-26) ──────────────────

// The opcode of the LE Encrypt command, 0x2017 ([Vol 4] Part E, Section 7.8.22).
pub @tier(embedded)
@no_alloc
fn opcode_le_encrypt() -> Int
    // OGF=0x08, OCF=0x0017 → 0x2017.
    (0x08 << 10) | 0x017

// The opcode of the LE Rand command, 0x2018 ([Vol 4] Part E, Section 7.8.23).
pub @tier(embedded)
@no_alloc
fn opcode_le_rand() -> Int
    // OGF=0x08, OCF=0x0018 → 0x2018.
    (0x08 << 10) | 0x018

// The opcode of the LE Enable Encryption command, 0x2019 ([Vol 4] Part E, Section 7.8.24).
pub @satisfies("REQ-BLE-HCI-033")
@tier(embedded)
@no_alloc
fn opcode_le_start_encryption() -> Int
    // OGF=0x08, OCF=0x0019 → 0x2019.
    (0x08 << 10) | 0x019

// The opcode of the LE Long Term Key Request Reply command, 0x201A ([Vol 4] Part E, Section 7.8.25).
pub @satisfies("REQ-BLE-HCI-034")
@tier(embedded)
@no_alloc
fn opcode_le_long_term_key_request_reply() -> Int
    // OGF=0x08, OCF=0x001A → 0x201A.
    (0x08 << 10) | 0x01A

// The opcode of the LE Long Term Key Request Negative Reply command, 0x201B ([Vol 4] Part E, Section 7.8.26).
pub @satisfies("REQ-BLE-HCI-035")
@tier(embedded)
@no_alloc
fn opcode_le_long_term_key_request_negative_reply() -> Int
    // OGF=0x08, OCF=0x001B → 0x201B.
    (0x08 << 10) | 0x01B

// ═════════════════════════════════════════════════════════════════════
// Command builders (parameter-packing helpers)
// ═════════════════════════════════════════════════════════════════════

// Build LE_Set_Advertising_Enable parameters: one byte,
// 0x00=disable, 0x01=enable (Vol 4 Part E §7.8.9).
pub @satisfies("REQ-BLE-HCI-018")
@tier(embedded)
fn build_le_set_advertising_enable(enable: Bool) -> [u8]
    var out = hci_buf.buf(1)
    hci_buf.put8(var out, if enable then 0x01 else 0x00)
    out

// Build LE_Set_Random_Address parameters: 6-byte address
// (Vol 4 Part E §7.8.4).  Byte ordering is the HCI convention
// (little-endian: byte[0] is least significant octet).
pub @satisfies("REQ-BLE-HCI-013")
@tier(embedded)
fn build_le_set_random_address(bd_addr: [u8]) -> [u8]
    var out = hci_buf.buf(6)
    for i in 0..6
        hci_buf.put8(var out, bd_addr[i] as Int)
    out

// ── Advertising-parameter helpers ───────────────────────────────────
//
// LE_Set_Advertising_Parameters is a 15-byte structured payload
// (Vol 4 Part E §7.8.5):
//
//   Advertising_Interval_Min  (u16, 0.625 ms units) — 0x0020-0x4000
//   Advertising_Interval_Max  (u16, same units)
//   Advertising_Type          (u8, enum 0x00-0x04)
//   Own_Address_Type          (u8, enum 0x00-0x03)
//   Peer_Address_Type         (u8, enum 0x00-0x01)
//   Peer_Address              ([u8])
//   Advertising_Channel_Map   (u8, bitmask of ch 37/38/39)
//   Advertising_Filter_Policy (u8, enum 0x00-0x03)
//
// What this module supplies for that command is the opcode and
// the enumerated field values below.  There is no builder for the
// payload itself — callers assemble the 15 bytes in the order
// above.

// Advertising type constants (Vol 4 Part E §7.8.5).
pub const ADV_TYPE_ADV_IND = 0x00

// Advertising_Type 0x01: connectable high duty cycle directed advertising, ADV_DIRECT_IND ([Vol 4] Part E, Section 7.8.5).
pub const ADV_TYPE_ADV_DIRECT_IND_HDC = 0x01

// Advertising_Type 0x02: scannable undirected advertising, ADV_SCAN_IND ([Vol 4] Part E, Section 7.8.5).
pub const ADV_TYPE_ADV_SCAN_IND = 0x02

// Advertising_Type 0x03: non-connectable and non-scannable undirected advertising, ADV_NONCONN_IND ([Vol 4] Part E,
// Section 7.8.5).
pub const ADV_TYPE_ADV_NONCONN_IND = 0x03

// Advertising_Type 0x04: connectable low duty cycle directed advertising, ADV_DIRECT_IND ([Vol 4] Part E, Section 7.8.5).
pub const ADV_TYPE_ADV_DIRECT_IND_LDC = 0x04

// Own_Address_Type enumeration.
pub const OWN_ADDR_TYPE_PUBLIC = 0x00

// Own_Address_Type 0x01: the Controller uses the random device address set by LE Set Random Address.
pub const OWN_ADDR_TYPE_RANDOM = 0x01

// Advertising channel-map bitmask.  Bit 0 = channel 37, bit 1 =
// 38, bit 2 = 39.  All-three is 0x07 (the usual choice).
pub const ADV_CHANNEL_MAP_ALL = 0x07

// Advertising filter policy constants (Vol 6 Part B §4.3.4).
pub const ADV_FILTER_NONE = 0x00

// Advertising_Filter_Policy 0x01: scan requests are processed only from devices on the Filter Accept List, connection requests
// from any device ([Vol 4] Part E, Section 7.8.5).
pub const ADV_FILTER_SCAN_WHITELIST = 0x01

// Advertising_Filter_Policy 0x02: connection requests are processed only from devices on the Filter Accept List, scan requests
// from any device ([Vol 4] Part E, Section 7.8.5).
pub const ADV_FILTER_CONNECT_WHITELIST = 0x02

// Advertising_Filter_Policy 0x03: scan requests and connection requests are processed only from devices on the Filter Accept
// List ([Vol 4] Part E, Section 7.8.5).
pub const ADV_FILTER_BOTH_WHITELIST = 0x03

// 0x0020 = 20 ms × 0.625 ms units → effective 20 ms floor.
pub @satisfies("REQ-BLE-LL-013")
@satisfies("REQ-BLE-LL-014")
fn adv_interval_min_default() -> Int
    0x00A0   // 100 ms (160 × 0.625 ms)

// The default Advertising_Interval_Max, 0x00A0 in 0.625 ms units: 100 ms.
pub const ADV_INTERVAL_MAX_DEFAULT = 0x00A0

// The range LE_Set_Advertising_Parameters admits for either
// interval, in 0.625 ms units: 20 ms to 10.24 s.
pub const ADV_INTERVAL_RANGE_MIN = 0x0020

// The longest advertising interval LE Set Advertising Parameters admits, 0x4000 in 0.625 ms units: 10.24 s.
pub const ADV_INTERVAL_RANGE_MAX = 0x4000

// An advertising interval in milliseconds, as the 0.625 ms units
// the command carries.  `None` when it falls outside the range
// above.
pub @tier(embedded)
fn adv_interval_units(ms: Int) -> ?Int
    let units = ms * 8 / 5
    if units < ADV_INTERVAL_RANGE_MIN or units > ADV_INTERVAL_RANGE_MAX
        None
    else
        Some(units)

// The longest advertising data or scan response data of a legacy advertising set, 31 octets.
//
// LE Set Advertising Data and LE Set Scan Response Data ([Vol 4] Part E, Sections 7.8.7 and 7.8.8) take the same 32-octet
// parameter block: a length octet, then a 31-octet field holding the data and zeros.
pub const ADV_DATA_MAX_LEN = 31

// The 32-byte parameter block for `data`.  `None` when `data` is
// longer than 31 bytes.
pub @satisfies("REQ-BLE-HCI-016")
@satisfies("REQ-BLE-HCI-017")
@tier(embedded)
fn build_le_adv_data_block(data: [u8]) -> ?[u8]
    let n = list.len(data)
    if n > ADV_DATA_MAX_LEN
        None
    else
        var block = hci_buf.buf(1 + ADV_DATA_MAX_LEN)
        hci_buf.put8(var block, n)
        hci_buf.put_bytes(var block, data)
        hci_buf.put_zeros(var block, ADV_DATA_MAX_LEN - n)
        Some(block)

// ── Extended advertising and periodic advertising ───────────────────
//
// The three 25-octet, 6-octet and 2-octet parameter lists below are the
// commands that create an advertising set, give it periodic advertising
// and start both.  Where the legacy commands above carry one advertising
// type octet and a 32-byte data block, these carry a 25-octet parameter
// list with an event-property bit field, three-octet intervals and two
// PHYs, and a data block of up to 255 octets sent as one operation.

// Advertising_Event_Properties bit field of the LE Set Extended
// Advertising Parameters command ([Vol 4] Part E, Section 7.8.53).
pub const ADV_EVENT_PROP_CONNECTABLE = 0x0001

// Bit 1 of Advertising_Event_Properties: the advertising set is scannable.
pub const ADV_EVENT_PROP_SCANNABLE = 0x0002

// Bit 2 of Advertising_Event_Properties: the advertising is directed at one peer.
pub const ADV_EVENT_PROP_DIRECTED = 0x0004

// Bit 3 of Advertising_Event_Properties: high duty cycle directed connectable advertising; meaningful with
// `ADV_EVENT_PROP_DIRECTED`.
pub const ADV_EVENT_PROP_HIGH_DUTY_DIRECTED = 0x0008

// Bit 4: legacy advertising PDUs.  A set that carries periodic
// advertising shall leave it clear.
pub const ADV_EVENT_PROP_LEGACY = 0x0010

// Bit 5 of Advertising_Event_Properties: the advertiser's address is omitted from the PDUs.
pub const ADV_EVENT_PROP_ANONYMOUS = 0x0020

// Bit 6 of Advertising_Event_Properties: the TxPower field is included in the extended header.
pub const ADV_EVENT_PROP_INCLUDE_TX_POWER = 0x0040

// Operation of the LE Set Extended Advertising Data command and of the
// LE Set Periodic Advertising Data command ([Vol 4] Part E, Sections
// 7.8.54 and 7.8.62).  The Host sends the whole data in one COMPLETE
// operation unless the Controller's maximum advertising data length
// forces it to split it.
pub const EXT_ADV_DATA_INTERMEDIATE = 0x00

// Operation 0x01: the first fragment of advertising data.
pub const EXT_ADV_DATA_FIRST = 0x01

// Operation 0x02: the last fragment of advertising data.
pub const EXT_ADV_DATA_LAST = 0x02

// Operation 0x03: the whole advertising data in one command.
pub const EXT_ADV_DATA_COMPLETE = 0x03

// Fragment_Preference: 0x00 is "the Controller may fragment all
// advertising data".
pub const EXT_ADV_FRAGMENT_ANY = 0x00

// Primary_Advertising_PHY and Secondary_Advertising_PHY ([Vol 4] Part E,
// Section 7.8.53).  The primary channel is LE 1M in every case here;
// the secondary PHY is the one that carries the auxiliary PDUs, which
// is where the advertising data of an extended set goes.
pub const LE_PHY_1M = 0x01

// The LE 2M PHY, value 0x02 of the PHY parameters.
pub const LE_PHY_2M = 0x02

// The LE Coded PHY, value 0x03 of the PHY parameters.
pub const LE_PHY_CODED = 0x03

// Advertising_TX_Power 0x7F: the Host has no preference ([Vol 4] Part E,
// Section 7.8.53).
pub const ADV_TX_POWER_NO_PREFERENCE = 0x7F

// Periodic_Advertising_Properties of the LE Set Periodic Advertising
// Parameters command ([Vol 4] Part E, Section 7.8.61): bit 0 puts the
// TxPower field in the AUX_SYNC_IND PDU.
pub const PERIODIC_ADV_PROP_INCLUDE_TX_POWER = 0x0001

// The range the two periodic advertising intervals may take, in 0.625 ms
// units: 7.5 ms to 81.91875 s ([Vol 4] Part E, Section 7.8.61).
pub const PERIODIC_INTERVAL_RANGE_MIN = 0x0006

// The longest periodic advertising interval, 0xFFFF in 1.25 ms units: 81.91875 s.
pub const PERIODIC_INTERVAL_RANGE_MAX = 0xFFFF

// A periodic advertising interval in milliseconds, as the 1.25 ms units
// the command carries ([Vol 4] Part E, Section 7.8.61).  `None` when it
// falls outside the range above.
@tier(embedded)
fn periodic_interval_units(ms: Int) -> ?Int
    let units = ms * 4 / 5
    if units < PERIODIC_INTERVAL_RANGE_MIN or units > PERIODIC_INTERVAL_RANGE_MAX
        None
    else
        Some(units)

// Mode of the LE Set Periodic Advertising Sync Transfer Parameters
// command ([Vol 4] Part E, Section 7.8.91): what the Controller does
// with synchronization information a peer sends.
pub const PERIODIC_TRANSFER_IGNORE = 0x00

// Mode 0x01: the Controller synchronizes to the train a peer transfers and sends no periodic advertising reports.
pub const PERIODIC_TRANSFER_NO_REPORTS = 0x01

// Mode 0x02: the Controller synchronizes to the train a peer transfers and sends reports with duplicate filtering off.
pub const PERIODIC_TRANSFER_REPORTS = 0x02

// Mode 0x03: the Controller synchronizes to the train a peer transfers and sends reports with duplicate filtering on.
pub const PERIODIC_TRANSFER_REPORTS_FILTERED = 0x03

// Sync_CTE_Type 0: the presence or absence of a Constant Tone Extension
// is irrelevant.
pub const PERIODIC_TRANSFER_CTE_ANY = 0x00

// Options of the LE Periodic Advertising Create Sync command
// ([Vol 4] Part E, Section 7.8.67): bit 0 makes the Controller take the
// advertiser from the Periodic Advertiser List instead of the
// Advertising_SID and Advertiser_Address parameters, bit 1 disables the
// reports of the train it synchronizes to, and bit 2 filters duplicates.
// A Host with no Periodic Advertiser List — this one has none — leaves
// bit 0 clear, and a device performing the Periodic Advertising
// Synchronization Establishment procedure without listening for periodic
// advertising sets bit 1 ([Vol 3] Part C, Section 9.5.3.3).
pub const PERIODIC_SYNC_OPTIONS_USE_LIST = 0x01

// Bit 1 of the Options of LE Periodic Advertising Create Sync: the reports of the train are disabled.
pub const PERIODIC_SYNC_OPTIONS_REPORTS_DISABLED = 0x02

// Bit 2 of the Options of LE Periodic Advertising Create Sync: duplicate reports are filtered.
pub const PERIODIC_SYNC_OPTIONS_DUPLICATE_FILTERING = 0x04

// Sync_CTE_Type 0: synchronize to a train whatever its Constant Tone
// Extension.
pub const PERIODIC_SYNC_CTE_ANY = 0x00

// The range the LE Periodic Advertising Create Sync command admits for
// Sync_Timeout, in 10 ms units: 100 ms to 163.84 s.  It is the maximum
// time between two periodic advertising packets of the train before the
// Controller reports the synchronization lost.
pub const PERIODIC_SYNC_TIMEOUT_RANGE_MIN = 0x000A

// The longest Sync_Timeout, 0x4000 in 10 ms units: 163.84 s.
pub const PERIODIC_SYNC_TIMEOUT_RANGE_MAX = 0x4000

// Scanning_PHYs of the LE Set Extended Scan Parameters command
// ([Vol 4] Part E, Section 7.8.64): bit 0 is the LE 1M PHY, bit 2 the LE
// Coded one.
pub const SCANNING_PHY_1M = 0x01

// The parameters of the LE Set Extended Scan Parameters command for one
// PHY ([Vol 4] Part E, Section 7.8.64): Own_Address_Type,
// Scanning_Filter_Policy, Scanning_PHYs, and then that PHY's Scan_Type,
// Scan_Interval and Scan_Window in 0.625 ms units.
pub @tier(embedded)
fn build_le_set_extended_scan_parameters(own_address_type: Int, filter_policy: Int,
                                         scanning_phys: Int, scan_type: Int, interval: Int,
                                         window: Int) -> [u8]
    var out = hci_buf.buf(8)
    hci_buf.put8(var out, own_address_type)
    hci_buf.put8(var out, filter_policy)
    hci_buf.put8(var out, scanning_phys)
    hci_buf.put8(var out, scan_type)
    hci_buf.put16(var out, interval)
    hci_buf.put16(var out, window)
    out

// The 6 parameter octets of the LE Set Extended Scan Enable command
// ([Vol 4] Part E, Section 7.8.65): Enable, Filter_Duplicates, and the
// Duration and Period a scan of its own would take, both 0x0000 for one
// that lasts until it is disabled.
pub @tier(embedded)
fn build_le_set_extended_scan_enable(enable: Bool, filter_duplicates: Bool) -> [u8]
    var out = hci_buf.buf(6)
    hci_buf.put8(var out, if enable then 0x01 else 0x00)
    hci_buf.put8(var out, if filter_duplicates then 0x01 else 0x00)
    hci_buf.put_zeros(var out, 4)
    out

// The 25 parameter octets of the LE Set Extended Advertising Parameters
// command ([Vol 4] Part E, Section 7.8.53): the handle, the event
// properties, the two three-octet primary advertising intervals, the
// channel map, this device's own address type, the peer's address type
// and address, the filter policy, the TX power, the primary PHY, the
// secondary skip count and PHY, the advertising SID and the scan request
// notification.  An undirected set carries the all-zero peer address and
// Peer_Address_Type 0x00.
pub @satisfies("REQ-BLE-HCI-051")
@tier(embedded)
fn build_le_set_extended_advertising_parameters(advertising_handle: Int, event_properties: Int,
                                                interval_min: Int, interval_max: Int,
                                                channel_map: Int, own_address_type: Int,
                                                peer_address_type: Int, peer_address: [u8],
                                                filter_policy: Int, tx_power: Int, primary_phy: Int,
                                                secondary_max_skip: Int, secondary_phy: Int,
                                                sid: Int, scan_request_notification: Int) -> [u8]
    var out = hci_buf.buf(25)
    hci_buf.put8(var out, advertising_handle)
    hci_buf.put16(var out, event_properties)
    hci_buf.put24(var out, interval_min)
    hci_buf.put24(var out, interval_max)
    hci_buf.put8(var out, channel_map)
    hci_buf.put8(var out, own_address_type)
    hci_buf.put8(var out, peer_address_type)
    hci_buf.put_range(var out, peer_address, 0, 6)
    hci_buf.put8(var out, filter_policy)
    hci_buf.put8(var out, tx_power)
    hci_buf.put8(var out, primary_phy)
    hci_buf.put8(var out, secondary_max_skip)
    hci_buf.put8(var out, secondary_phy)
    hci_buf.put8(var out, sid)
    hci_buf.put8(var out, scan_request_notification)
    out

// The parameter octets of the LE Set Extended Advertising Data command
// ([Vol 4] Part E, Section 7.8.54) and of the LE Set Extended Scan
// Response Data command (Section 7.8.55), which share their layout:
// Advertising_Handle, Operation, Fragment_Preference, then the data
// length and the data.  The length is one octet, so one operation
// carries at most 255 octets.
pub @satisfies("REQ-BLE-HCI-051")
@tier(embedded)
fn build_le_set_extended_data(advertising_handle: Int, operation: Int, fragment_preference: Int,
                              data: [u8]) -> ?[u8]
    if list.len(data) > 255
        None
    else
        var out = hci_buf.buf(4 + list.len(data))
        hci_buf.put8(var out, advertising_handle)
        hci_buf.put8(var out, operation)
        hci_buf.put8(var out, fragment_preference)
        hci_buf.put8(var out, list.len(data))
        hci_buf.put_bytes(var out, data)
        Some(out)

// The 7 parameter octets of the LE Set Advertising Set Random Address
// command ([Vol 4] Part E, Section 7.8.52): Advertising_Handle and
// Random_Address.  This is the address an advertising set advertises
// from; the legacy LE Set Random Address command does not reach a set,
// and a Controller answers the LE Set Extended Advertising Enable
// command Invalid HCI Command Parameters when the set's own address was
// never set (observed on a Nordic SoftDevice Controller).
pub @satisfies("REQ-BLE-HCI-051")
@tier(embedded)
fn build_le_set_advertising_set_random_address(advertising_handle: Int, address: [u8]) -> [u8]
    var out = hci_buf.buf(7)
    hci_buf.put8(var out, advertising_handle)
    hci_buf.put_range(var out, address, 0, 6)
    out

// The 6 parameter octets of the LE Set Extended Advertising Enable
// command ([Vol 4] Part E, Section 7.8.56) for one advertising set:
// Enable, Num_Sets 1, then the handle, the Duration in 10 ms units and
// Max_Extended_Advertising_Events.  A Duration of 0x0000 and a
// Max_Extended_Advertising_Events of 0x00 both mean no limit.
pub @satisfies("REQ-BLE-HCI-051")
@tier(embedded)
fn build_le_set_extended_advertising_enable(enable: Bool, advertising_handle: Int, duration: Int,
                                            max_events: Int) -> [u8]
    var out = hci_buf.buf(6)
    hci_buf.put8(var out, if enable then 0x01 else 0x00)
    hci_buf.put8(var out, 0x01)
    hci_buf.put8(var out, advertising_handle)
    hci_buf.put16(var out, duration)
    hci_buf.put8(var out, max_events)
    out

// The one parameter octet of the LE Remove Advertising Set command
// ([Vol 4] Part E, Section 7.8.59).
pub @tier(embedded)
fn build_le_remove_advertising_set(advertising_handle: Int) -> [u8]
    var out = hci_buf.buf(1)
    hci_buf.put8(var out, advertising_handle)
    out

// The 6 parameter octets of the LE Set Periodic Advertising Parameters
// command ([Vol 4] Part E, Section 7.8.61): Advertising_Handle, the two
// periodic advertising intervals in 1.25 ms units, and
// Periodic_Advertising_Properties, two octets like the intervals.  All
// seven octets go out: a Controller reads the parameter length off the
// command, so a command one octet short is a malformed one and the Nordic
// SoftDevice Controller answers it Unsupported Feature or Parameter Value
// (0x11) whatever the intervals say.
pub @satisfies("REQ-BLE-HCI-052")
@tier(embedded)
fn build_le_set_periodic_advertising_parameters(advertising_handle: Int, interval_min: Int,
                                                interval_max: Int, properties: Int) -> [u8]
    var out = hci_buf.buf(7)
    hci_buf.put8(var out, advertising_handle)
    hci_buf.put16(var out, interval_min)
    hci_buf.put16(var out, interval_max)
    hci_buf.put16(var out, properties)
    out

// The parameter octets of the LE Set Periodic Advertising Data command
// ([Vol 4] Part E, Section 7.8.62): Advertising_Handle, Operation, then
// the data length and the data.  Unlike the extended advertising data
// the command takes no fragment preference.
pub @satisfies("REQ-BLE-HCI-052")
@tier(embedded)
fn build_le_set_periodic_advertising_data(advertising_handle: Int, operation: Int,
                                          data: [u8]) -> ?[u8]
    if list.len(data) > 255
        None
    else
        var out = hci_buf.buf(3 + list.len(data))
        hci_buf.put8(var out, advertising_handle)
        hci_buf.put8(var out, operation)
        hci_buf.put8(var out, list.len(data))
        hci_buf.put_bytes(var out, data)
        Some(out)

// The 12 parameter octets of the LE Set Periodic Advertising Parameters
// command [v2] ([Vol 4] Part E, Section 7.8.61): the same four the first
// form carries — Advertising_Handle, the two intervals and
// Periodic_Advertising_Properties — and then Num_Subevents,
// Subevent_Interval, Response_Slot_Delay, Response_Slot_Spacing and
// Num_Response_Slots.  A Num_Subevents of 0x00 makes the train a plain
// one and the Controller ignores the four parameters after it, so this
// Host sends the first form for a plain train and this one only when the
// train carries responses.  Like the first form, every octet goes out: a
// Controller reads the parameter length off the command, and one octet
// short is Unsupported Feature or Parameter Value (0x11) on a Nordic
// SoftDevice Controller whichever the parameters are.
pub @satisfies("REQ-BLE-HCI-056")
@tier(embedded)
fn build_le_set_periodic_advertising_parameters_v2(advertising_handle: Int, interval_min: Int,
                                                   interval_max: Int, properties: Int,
                                                   num_subevents: Int, subevent_interval: Int,
                                                   response_slot_delay: Int,
                                                   response_slot_spacing: Int,
                                                   num_response_slots: Int) -> [u8]
    var out = hci_buf.buf(12)
    hci_buf.put8(var out, advertising_handle)
    hci_buf.put16(var out, interval_min)
    hci_buf.put16(var out, interval_max)
    hci_buf.put16(var out, properties)
    hci_buf.put8(var out, num_subevents)
    hci_buf.put8(var out, subevent_interval)
    hci_buf.put8(var out, response_slot_delay)
    hci_buf.put8(var out, response_slot_spacing)
    hci_buf.put8(var out, num_response_slots)
    out

// The parameter octets of the LE Set Periodic Advertising Subevent Data
// command ([Vol 4] Part E, Section 7.8.125): Advertising_Handle,
// Num_Subevents_With_Data, and then one element per subevent —
// Subevent[i], Response_Slot_Start[i], Response_Slot_Count[i],
// Subevent_Data_Length[i] and Subevent_Data[i].  The parameters are
// arrayed together, so the elements go out in the order the HCI
// conventions give ([Vol 4] Part E, Section 5.4): Subevent[0],
// Response_Slot_Start[0], Response_Slot_Count[0], Subevent_Data_Length[0],
// Subevent_Data[0], then the same five of element 1, and so on.  `None`
// when there is no subevent to name, more than the 0x0F the field holds,
// or a data block one subevent cannot carry.
pub @satisfies("REQ-BLE-HCI-056")
@tier(embedded)
fn build_le_set_periodic_advertising_subevent_data(advertising_handle: Int,
                                                   subevents: [PawrSubevent]) -> ?[u8]
    let n = list.len(subevents)
    if n < 1 or n > PAWR_SUBEVENTS_MAX
        None
    else
        var size = 2
        for s in subevents
            size = size + 4 + list.len(s.data)
        var out = hci_buf.buf(size)
        hci_buf.put8(var out, advertising_handle)
        hci_buf.put8(var out, n)
        var too_long = false
        for s in subevents
            if s.subevent > PAWR_SUBEVENT_MAX or list.len(s.data) > PAWR_SUBEVENT_DATA_MAX
                too_long = true
            else
                hci_buf.put8(var out, s.subevent)
                hci_buf.put8(var out, s.response_slot_start)
                hci_buf.put8(var out, s.response_slot_count)
                hci_buf.put8(var out, list.len(s.data))
                hci_buf.put_bytes(var out, s.data)
        if too_long
            None
        else
            Some(out)

// One subevent of the LE Set Periodic Advertising Subevent Data command:
// the index, the first response slot it listens in, how many slots it
// listens in (0 when it expects no response), and the advertising data of
// the subevent.
pub struct PawrSubevent
    subevent: Int
    response_slot_start: Int
    response_slot_count: Int
    data: [u8]

// The subevent numbers and the data a subevent carries, from the fields
// of the command ([Vol 4] Part E, Section 7.8.125): Subevent[i] is 0x00
// to 0x7F, 0x01 to 0x0F elements go in one command, and
// Subevent_Data_Length[i] is up to 251 octets.
pub const PAWR_SUBEVENT_MAX = 0x7F

// The most subevent entries one LE Set Periodic Advertising Subevent Data command carries, 0x0F.
pub const PAWR_SUBEVENTS_MAX = 0x0F

// The most data octets one subevent of LE Set Periodic Advertising Subevent Data carries, 251.
pub const PAWR_SUBEVENT_DATA_MAX = 251

// The ranges the LE Set Periodic Advertising Parameters command [v2]
// puts on the subevent parameters ([Vol 4] Part E, Section 7.8.61):
// Num_Subevents is 0x01 to 0x80, Subevent_Interval 0x06 to 0xFF in
// 1.25 ms units, Response_Slot_Delay 0x01 to 0xFE in 1.25 ms units,
// Response_Slot_Spacing 0x02 to 0xFF in 0.125 ms units and
// Num_Response_Slots 0x01 to 0xFF.  On top of the ranges,
// Subevent_Interval is at most the minimum periodic advertising interval
// divided by Num_Subevents, and Response_Slot_Delay is below the
// Subevent_Interval.  Both one-octet fields can hold 0x00, which a
// Controller refuses: a Nordic SoftDevice Controller answers Invalid
// HCI Command Parameters (0x12) below a Subevent_Interval of 0x06 and
// below a Response_Slot_Delay of 0x01, and above the quotient, which is
// the same two to the same two.
pub const PAWR_SUBEVENTS_RANGE_MAX = 0x80

// The shortest Subevent_Interval, 0x06 in 1.25 ms units: 7.5 ms.
pub const PAWR_SUBEVENT_INTERVAL_MIN = 0x06

// The shortest Response_Slot_Delay, 0x01 in 1.25 ms units.
pub const PAWR_RESPONSE_SLOT_DELAY_MIN = 0x01

// The longest Response_Slot_Delay, 0xFE in 1.25 ms units.
pub const PAWR_RESPONSE_SLOT_DELAY_MAX = 0xFE

// The shortest Response_Slot_Spacing, 0x02 in 0.125 ms units: 0.25 ms.
pub const PAWR_RESPONSE_SLOT_SPACING_MIN = 0x02

// The 2 parameter octets of the LE Set Periodic Advertising Enable
// command ([Vol 4] Part E, Section 7.8.63): Enable and
// Advertising_Handle.
pub @satisfies("REQ-BLE-HCI-052")
@tier(embedded)
fn build_le_set_periodic_advertising_enable(enable: Bool, advertising_handle: Int) -> [u8]
    var out = hci_buf.buf(2)
    hci_buf.put8(var out, if enable then 0x01 else 0x00)
    hci_buf.put8(var out, advertising_handle)
    out

// The 8 parameter octets of the LE Set Periodic Advertising Sync
// Transfer Parameters command ([Vol 4] Part E, Section 7.8.91):
// Connection_Handle, Mode, Skip, Sync_Timeout in 10 ms units and
// CTE_Type.
pub @satisfies("REQ-BLE-HCI-054")
@tier(embedded)
fn build_le_set_periodic_advertising_sync_transfer_parameters(connection_handle: Int, mode: Int,
                                                              skip: Int, sync_timeout: Int,
                                                              cte_type: Int) -> [u8]
    var out = hci_buf.buf(8)
    hci_buf.put12(var out, connection_handle)
    hci_buf.put8(var out, mode)
    hci_buf.put16(var out, skip)
    hci_buf.put16(var out, sync_timeout)
    hci_buf.put8(var out, cte_type)
    out

// The 5 parameter octets of the LE Periodic Advertising Set Info
// Transfer command ([Vol 4] Part E, Section 7.8.90):
// Connection_Handle, Service_Data and the Advertising_Handle of the set
// whose periodic advertising is handed over.
pub @satisfies("REQ-BLE-HCI-053")
@tier(embedded)
fn build_le_periodic_advertising_set_info_transfer(connection_handle: Int, service_data: Int,
                                                   advertising_handle: Int) -> [u8]
    var out = hci_buf.buf(5)
    hci_buf.put12(var out, connection_handle)
    hci_buf.put16(var out, service_data)
    hci_buf.put8(var out, advertising_handle)
    out

// The 6 parameter octets of the LE Periodic Advertising Sync Transfer
// command ([Vol 4] Part E, Section 7.8.89): Connection_Handle,
// Service_Data and the Sync_Handle of the periodic advertising train.
pub @satisfies("REQ-BLE-HCI-053")
@tier(embedded)
fn build_le_periodic_advertising_sync_transfer(connection_handle: Int, service_data: Int,
                                               sync_handle: Int) -> [u8]
    var out = hci_buf.buf(6)
    hci_buf.put12(var out, connection_handle)
    hci_buf.put16(var out, service_data)
    hci_buf.put16(var out, sync_handle)
    out

// The default Event_Mask of a Controller, 0x00001FFFFFFFFFFF: bits 0 to 44 set and the LE Meta event, bit 61, clear.
//
// The Set Event Mask command ([Vol 4] Part E, Section 7.3.1) takes the 8-octet Event_Mask.  For an LE Controller bit 61 enables
// or disables every LE event inside the LE Meta event, the LE Advertising Report event among them.
pub const EVENT_MASK_DEFAULT = 0x00001FFFFFFFFFFF

// Bit 61 of the Event_Mask: the LE Meta event, which carries every LE event.
pub const EVENT_MASK_LE_META = 0x2000000000000000

// Bit 47, the Encryption Key Refresh Complete event ([Vol 4] Part E,
// Section 7.7.39), which the default leaves clear.  A pairing on a link
// that is already encrypted ends its encryption with this event rather
// than Encryption Change, and the Security Manager distributes its keys
// only after it ([Vol 3] Part H, Section 3.6).
pub const EVENT_MASK_ENCRYPTION_KEY_REFRESH_COMPLETE = 0x0000800000000000

// The 8 parameter octets of the Set Event Mask command, least
// significant first.
pub @tier(embedded)
fn build_set_event_mask(mask: Int) -> [u8]
    var out = hci_buf.buf(8)
    hci_buf.put64(var out, mask)
    out

// ── Scanning ────────────────────────────────────────────────────────
//
// The LE Set Scan Parameters command ([Vol 4] Part E, Section 7.8.10)
// takes LE_Scan_Type, LE_Scan_Interval, LE_Scan_Window,
// Own_Address_Type and Scanning_Filter_Policy, 7 octets.  The two
// intervals are in 0.625 ms units, 0x0004 to 0x4000, and LE_Scan_Window
// shall be less than or equal to LE_Scan_Interval.

// LE_Scan_Type: Passive Scanning sends no scanning PDUs; Active scanning
// may send them.
pub const LE_SCAN_TYPE_PASSIVE = 0x00

// LE_Scan_Type 0x01: active scanning, which may send scan requests.
pub const LE_SCAN_TYPE_ACTIVE = 0x01

// Scanning_Filter_Policy 0x00, the basic unfiltered scanning filter
// policy.
pub const SCAN_FILTER_BASIC_UNFILTERED = 0x00

// Initiator_Filter_Policy of the LE Create Connection command ([Vol 4]
// Part E, Section 7.8.12): 0x01 is "use the filter accept list and ignore
// the peer address fields", which is the spelling the Auto Connection
// Establishment procedure uses — the command carries the all-zero peer
// address and this policy.
pub const INITIATOR_FILTER_ACCEPT_LIST = 0x01

// The parameter of the LE Add Device To Filter Accept List command
// ([Vol 4] Part E, Section 7.8.16): Address_Type and Address.
pub @tier(embedded)
fn build_le_add_device_to_filter_accept_list(address_type: Int, address: [u8]) -> [u8]
    var out = hci_buf.buf(7)
    hci_buf.put8(var out, address_type)
    hci_buf.put_range(var out, address, 0, 6)
    out

// The 7 parameter octets of the LE Set Scan Parameters command.
pub @tier(embedded)
fn build_le_set_scan_parameters(scan_type: Int, interval: Int, window: Int, own_address_type: Int,
                                filter_policy: Int) -> [u8]
    var out = hci_buf.buf(7)
    hci_buf.put8(var out, scan_type)
    hci_buf.put16(var out, interval)
    hci_buf.put16(var out, window)
    hci_buf.put8(var out, own_address_type)
    hci_buf.put8(var out, filter_policy)
    out

// The LE_Scan_Enable and Filter_Duplicates octets of the LE Set Scan
// Enable command ([Vol 4] Part E, Section 7.8.11).  The Controller
// ignores Filter_Duplicates when scanning is disabled.
pub @tier(embedded)
fn build_le_set_scan_enable(enable: Bool, filter_duplicates: Bool) -> [u8]
    var out = hci_buf.buf(2)
    hci_buf.put8(var out, if enable then 0x01 else 0x00)
    hci_buf.put8(var out, if filter_duplicates then 0x01 else 0x00)
    out

// The parameters of the LE Add Device To Resolving List command ([Vol 4] Part E, Section 7.8.38):
// Peer_Identity_Address_Type, Peer_Identity_Address, Peer_IRK and Local_IRK, 39 octets.  A Local_IRK of
// 16 zero octets tells the Controller the Host uses no Resolvable Private Address of its own for the peer.
pub @tier(embedded)
fn build_le_add_device_to_resolving_list(address_type: Int, address: [u8], peer_irk: [u8],
                                         local_irk: [u8]) -> [u8]
    var out = hci_buf.buf(39)
    hci_buf.put8(var out, address_type)
    hci_buf.put_range(var out, address, 0, 6)
    hci_buf.put_range(var out, peer_irk, 0, 16)
    hci_buf.put_range(var out, local_irk, 0, 16)
    out

// The Address_Resolution_Enable octet of the LE Set Address Resolution Enable command.
pub @tier(embedded)
fn build_le_set_address_resolution_enable(enable: Bool) -> [u8]
    var out = hci_buf.buf(1)
    hci_buf.put8(var out, if enable then 0x01 else 0x00)
    out

// The default LE_Event_Mask, 0x000000000000001F: bits 0 to 4.
//
// The LE Set Event Mask command ([Vol 4] Part E, Section 7.8.1) takes the 8-octet LE_Event_Mask in the layout of
// `build_set_event_mask`.  Bits 0 to 4 are LE Connection Complete, LE Advertising Report, LE Connection Update Complete, LE Read
// Remote Features Page 0 Complete and LE Long Term Key Request.
pub const LE_EVENT_MASK_DEFAULT = 0x000000000000001F

// Bit 5 of the LE_Event_Mask: the LE Remote Connection Parameter Request event, which a Host must see to answer the peer's
// Connection Parameters Request procedure.
pub const LE_EVENT_MASK_REMOTE_CONNECTION_PARAMETER_REQUEST = 0x0000000000000020

// Bit 12 is the LE Extended Advertising Report event ([Vol 4] Part E, Section
// 7.7.65.13), which a Controller sends in place of the LE Advertising Report while
// the Host scans with LE Set Extended Scan Enable.  A Controller sends none while
// the bit is clear.
pub const LE_EVENT_MASK_EXTENDED_ADVERTISING_REPORT = 0x0000000000001000

// Bits 13 to 15 of the LE event mask are the Observer's periodic
// advertising events ([Vol 4] Part E, Section 7.8.1): LE Periodic
// Advertising Sync Established, LE Periodic Advertising Report and LE
// Periodic Advertising Sync Lost.  Bit 23 is the fourth event of the
// family, LE Periodic Advertising Sync Transfer Received, which a
// Peripheral's Link Layer sends when the Central's hands it a train it
// is synchronized to ([Vol 3] Part C, Section 9.5.4); it is not bit 16,
// which is LE Scan Timeout, nor bit 17, which is LE Advertising Set
// Terminated.  The Controller sends none of the four while its bit is
// clear, the SoftDevice Controller among them: without bit 23 the
// transfer arrives, and the Host is never told.
pub const LE_EVENT_MASK_PERIODIC_ADVERTISING = 0x000000000080E000

// Bits 38 and 39 of the LE event mask are the two events a train with
// responses goes on ([Vol 4] Part E, Section 7.8.1): LE Periodic
// Advertising Subevent Data Request, which asks the advertiser for the
// data of the subevents of the next periodic advertising event, and LE
// Periodic Advertising Response Report, which carries what the
// synchronized devices answered in the response slots of a subevent.
// The two are LE Meta subevents 0x27 and 0x28.  The Subevent Data
// Request is the one the Advertiser cannot do without: the train runs
// without it, and carries no subevent data — a Nordic SoftDevice
// Controller sends it only while bit 38 is set, and sets none of the
// neighbouring bits.
// Both events are inside the LE Meta event, so the Event_Mask bit 61
// has to be set as well, which `EVENT_MASK_LE_META` is.
pub const LE_EVENT_MASK_PERIODIC_ADVERTISING_RESPONSES = 0x000000C000000000

// ── Isochronous channels (Vol 4 Part E §7.8.2, §7.8.96-7.8.116) ─────
//
// Isochronous data goes over a Connected Isochronous Stream (CIS), which
// belongs to a Connected Isochronous Group (CIG) and rides an ACL
// connection, or over a Broadcast Isochronous Stream (BIS), which
// belongs to a Broadcast Isochronous Group (BIG) the Controller
// transmits or follows.  The Host sets the stream up with the commands
// below, opens a data path for each stream with the LE Setup ISO Data
// Path command and then exchanges HCI ISO Data packets on the
// Connection_Handle of the stream (`hci_codec.nv`).
//
// A Host that wants isochronous channels sets the Connected Isochronous
// Stream (Host Support) bit of the Link Layer FeatureSet before the first
// connection with the LE Set Host Feature command (Section 7.8.115).  Every builder below returns
// the parameter octets of its command.  A builder whose parameters cannot
// be encoded, a count above the width of its field or a Broadcast_Code
// that is not 16 octets, returns None; the value ranges a Controller
// checks, and answers with Invalid HCI Command Parameters (0x12) or
// Unsupported Feature or Parameter Value (0x11), are left to the
// Controller so that the Host can send the parameters a conformance test
// asks it to send.
//
// An arrayed parameter is written element by element ([Vol 4] Part E,
// Section 5.4): CIS_ID[0], Max_SDU_C_To_P[0], ..., RTN_P_To_C[0], then
// CIS_ID[1], and so on.

// [Vol 4] Part E, Section 7.8.2 — LE Read Buffer Size command [v2]: the
// form that also answers ISO_Data_Packet_Length and
// Total_Num_ISO_Data_Packets.  A Controller that supports HCI ISO Data
// packets answers both with non-zero values.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_read_buffer_size_v2() -> Int
    // OGF=0x08, OCF=0x0060 → 0x2060.
    (0x08 << 10) | 0x060

// The opcode of the LE Read ISO TX Sync command, 0x2061 ([Vol 4] Part E, Section 7.8.96).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_read_iso_tx_sync() -> Int
    // OGF=0x08, OCF=0x0061 → 0x2061.
    (0x08 << 10) | 0x061

// The opcode of the LE Set CIG Parameters command, 0x2062 ([Vol 4] Part E, Section 7.8.97).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_set_cig_parameters() -> Int
    // OGF=0x08, OCF=0x0062 → 0x2062.
    (0x08 << 10) | 0x062

// The opcode of the LE Set CIG Parameters Test command, 0x2063 ([Vol 4] Part E, Section 7.8.98).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_set_cig_parameters_test() -> Int
    // OGF=0x08, OCF=0x0063 → 0x2063.
    (0x08 << 10) | 0x063

// The opcode of the LE Create CIS command, 0x2064 ([Vol 4] Part E, Section 7.8.99).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_create_cis() -> Int
    // OGF=0x08, OCF=0x0064 → 0x2064.
    (0x08 << 10) | 0x064

// The opcode of the LE Remove CIG command, 0x2065 ([Vol 4] Part E, Section 7.8.100).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_remove_cig() -> Int
    // OGF=0x08, OCF=0x0065 → 0x2065.
    (0x08 << 10) | 0x065

// The opcode of the LE Accept CIS Request command, 0x2066 ([Vol 4] Part E, Section 7.8.101).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_accept_cis_request() -> Int
    // OGF=0x08, OCF=0x0066 → 0x2066.
    (0x08 << 10) | 0x066

// The opcode of the LE Reject CIS Request command, 0x2067 ([Vol 4] Part E, Section 7.8.102).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_reject_cis_request() -> Int
    // OGF=0x08, OCF=0x0067 → 0x2067.
    (0x08 << 10) | 0x067

// The opcode of the LE Create BIG command, 0x2068 ([Vol 4] Part E, Section 7.8.103).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_create_big() -> Int
    // OGF=0x08, OCF=0x0068 → 0x2068.
    (0x08 << 10) | 0x068

// The opcode of the LE Create BIG Test command, 0x2069 ([Vol 4] Part E, Section 7.8.104).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_create_big_test() -> Int
    // OGF=0x08, OCF=0x0069 → 0x2069.
    (0x08 << 10) | 0x069

// The opcode of the LE Terminate BIG command, 0x206A ([Vol 4] Part E, Section 7.8.105).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_terminate_big() -> Int
    // OGF=0x08, OCF=0x006A → 0x206A.
    (0x08 << 10) | 0x06A

// The opcode of the LE BIG Create Sync command, 0x206B ([Vol 4] Part E, Section 7.8.106).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_big_create_sync() -> Int
    // OGF=0x08, OCF=0x006B → 0x206B.
    (0x08 << 10) | 0x06B

// The opcode of the LE BIG Terminate Sync command, 0x206C ([Vol 4] Part E, Section 7.8.107).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_big_terminate_sync() -> Int
    // OGF=0x08, OCF=0x006C → 0x206C.
    (0x08 << 10) | 0x06C

// The opcode of the LE Setup ISO Data Path command, 0x206E ([Vol 4] Part E, Section 7.8.109).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_setup_iso_data_path() -> Int
    // OGF=0x08, OCF=0x006E → 0x206E.
    (0x08 << 10) | 0x06E

// The opcode of the LE Remove ISO Data Path command, 0x206F ([Vol 4] Part E, Section 7.8.110).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_remove_iso_data_path() -> Int
    // OGF=0x08, OCF=0x006F → 0x206F.
    (0x08 << 10) | 0x06F

// The opcode of the LE ISO Transmit Test command, 0x2070 ([Vol 4] Part E, Section 7.8.111).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_iso_transmit_test() -> Int
    // OGF=0x08, OCF=0x0070 → 0x2070.
    (0x08 << 10) | 0x070

// The opcode of the LE ISO Receive Test command, 0x2071 ([Vol 4] Part E, Section 7.8.112).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_iso_receive_test() -> Int
    // OGF=0x08, OCF=0x0071 → 0x2071.
    (0x08 << 10) | 0x071

// The opcode of the LE ISO Read Test Counters command, 0x2072 ([Vol 4] Part E, Section 7.8.113).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_iso_read_test_counters() -> Int
    // OGF=0x08, OCF=0x0072 → 0x2072.
    (0x08 << 10) | 0x072

// The opcode of the LE ISO Test End command, 0x2073 ([Vol 4] Part E, Section 7.8.114).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_iso_test_end() -> Int
    // OGF=0x08, OCF=0x0073 → 0x2073.
    (0x08 << 10) | 0x073

// [Vol 4] Part E, Section 7.8.115 — LE Set Host Feature command [v1],
// with a one-octet Bit_Number.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_set_host_feature() -> Int
    // OGF=0x08, OCF=0x0074 → 0x2074.
    (0x08 << 10) | 0x074

// [Vol 4] Part E, Section 7.8.115 — LE Set Host Feature command [v2],
// with a two-octet Bit_Number (0x0000 to 0x07BF).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_set_host_feature_v2() -> Int
    // OGF=0x08, OCF=0x0097 → 0x2097.
    (0x08 << 10) | 0x097

// The opcode of the LE Read ISO Link Quality command, 0x2075 ([Vol 4] Part E, Section 7.8.116).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
@no_alloc
fn opcode_le_read_iso_link_quality() -> Int
    // OGF=0x08, OCF=0x0075 → 0x2075.
    (0x08 << 10) | 0x075

// Bit 32 of the Link Layer FeatureSet is Connected Isochronous Stream
// (Host Support) ([Vol 6] Part B, Section 4.6.33.1): the Host sets it
// with the LE Set Host Feature command: it says the Host supports
// creating CISes.  A Controller refuses the command while it has a
// connection to another device (Command Disallowed, 0x0C).
pub const FEATURE_CONNECTED_ISOCHRONOUS_STREAM_HOST_SUPPORT = 32

// Framing of the LE Set CIG Parameters command ([Vol 4] Part E, Section
// 7.8.97): unframed PDUs, framed PDUs in Segmentable mode and framed
// PDUs in Unsegmented mode.  The LE Create BIG command takes the first
// two of the three (Section 7.8.103).
pub const ISO_FRAMING_UNFRAMED = 0x00

// Framing 0x01: framed PDUs in Segmentable mode ([Vol 4] Part E, Section 7.8.97).
pub const ISO_FRAMING_FRAMED_SEGMENTABLE = 0x01

// Framing 0x02: framed PDUs in Unsegmented mode ([Vol 4] Part E, Section 7.8.97).  LE Create BIG does not take it.
pub const ISO_FRAMING_FRAMED_UNSEGMENTED = 0x02

// Packing of the CIG and the BIG: Sequential or Interleaved
// arrangement of the subevents of several streams ([Vol 6] Part B,
// Section 4.5.14.2).
pub const ISO_PACKING_SEQUENTIAL = 0x00

// Packing 0x01: the subevents of the several streams of a CIG or a BIG are interleaved ([Vol 6] Part B, Section 4.5.14.2).
pub const ISO_PACKING_INTERLEAVED = 0x01

// Data_Path_Direction of the LE Setup ISO Data Path and LE Remove ISO
// Data Path commands ([Vol 4] Part E, Section 7.8.109): Input is data
// the Host sends to the Controller, Output is data the Controller sends
// to the Host.  Data_Path_ID 0x00 is the HCI transport.
pub const ISO_DATA_PATH_INPUT = 0x00

// Data_Path_Direction 0x01: data the Controller sends to the Host ([Vol 4] Part E, Section 7.8.109).
pub const ISO_DATA_PATH_OUTPUT = 0x01

// Data_Path_ID 0x00: the data path is the HCI transport ([Vol 4] Part E, Section 7.8.109).
pub const ISO_DATA_PATH_HCI = 0x00

// Payload_Type of the LE ISO Transmit Test and LE ISO Receive Test
// commands ([Vol 4] Part E, Section 7.8.111).
pub const ISO_TEST_PAYLOAD_ZERO_LENGTH = 0x00

// Payload_Type 0x01 of the LE ISO Transmit Test and LE ISO Receive Test commands: payloads of variable length
// ([Vol 4] Part E, Section 7.8.111).
pub const ISO_TEST_PAYLOAD_VARIABLE_LENGTH = 0x01

// Payload_Type 0x02 of the LE ISO Transmit Test and LE ISO Receive Test commands: payloads of the maximum length
// ([Vol 4] Part E, Section 7.8.111).
pub const ISO_TEST_PAYLOAD_MAXIMUM_LENGTH = 0x02

// The ranges the encoding of the commands below can carry, from the
// parameter tables of Section 7.8.97 to Section 7.8.115.
pub const ISO_CIS_COUNT_MAX = 0x1F

// The most BISes a BIG carries in the encoding of these commands, 0x1F.
pub const ISO_BIS_COUNT_MAX = 0x1F

// The largest Connection_Handle, 0x0EFF.
pub const ISO_CONNECTION_HANDLE_MAX = 0x0EFF

// The length of a Broadcast_Code in octets, 16.
pub const ISO_BROADCAST_CODE_LENGTH = 16

// SDU_Interval, in microseconds, of the commands that set up a CIG or a
// BIG: 0x0000FF to 0x0FFFFF ([Vol 4] Part E, Sections 7.8.97, 7.8.98,
// 7.8.103 and 7.8.104).  The field is three octets wide, so a value above
// 0xFFFFFF would be cut silently, and a value between 0x100000 and
// 0xFFFFFF is a reserved one; a builder refuses both.  A direction no CIS
// of the CIG uses still carries a value in this range.
pub const ISO_SDU_INTERVAL_MIN = 0x0000FF

// The longest SDU_Interval the commands that set up a CIG or a BIG take, 0x0FFFFF microseconds.
pub const ISO_SDU_INTERVAL_MAX = 0x0FFFFF

// Whether `sdu_interval`, in microseconds, lies in `ISO_SDU_INTERVAL_MIN` to `ISO_SDU_INTERVAL_MAX`, the range of the commands that
// set up a CIG or a BIG.
pub @tier(embedded)
@no_alloc
fn iso_sdu_interval_ok(sdu_interval: Int) -> Bool
    sdu_interval >= ISO_SDU_INTERVAL_MIN and sdu_interval <= ISO_SDU_INTERVAL_MAX

// The parameter octets of the LE Set Host Feature command [v1] ([Vol 4]
// Part E, Section 7.8.115): Bit_Number and Bit_Value.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_set_host_feature(bit_number: Int, enable: Bool) -> [u8]
    var out = hci_buf.buf(2)
    hci_buf.put8(var out, bit_number)
    hci_buf.put8(var out, if enable then 0x01 else 0x00)
    out

// The parameter octets of the LE Set Host Feature command [v2]: a
// two-octet Bit_Number, then Bit_Value.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_set_host_feature_v2(bit_number: Int, enable: Bool) -> [u8]
    var out = hci_buf.buf(3)
    hci_buf.put16(var out, bit_number)
    hci_buf.put8(var out, if enable then 0x01 else 0x00)
    out

// The parameter octets of the LE Read ISO TX Sync, LE Accept CIS Request,
// LE ISO Read Test Counters, LE ISO Test End and LE Read ISO Link
// Quality commands, which take a Connection_Handle and nothing else
// (Section 7.8.96, 7.8.101, 7.8.113, 7.8.114 and 7.8.116).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_iso_connection_handle(connection_handle: Int) -> [u8]
    var out = hci_buf.buf(2)
    hci_buf.put12(var out, connection_handle)
    out

// The CIG-wide parameters of the LE Set CIG Parameters command ([Vol 4]
// Part E, Section 7.8.97).  The two SDU intervals are in microseconds,
// the two transport latencies in milliseconds; Worst_Case_SCA, Packing
// and Framing are the codes of the specification.
pub @value
struct CigParameters
    cig_id: Int
    sdu_interval_c_to_p: Int
    sdu_interval_p_to_c: Int
    worst_case_sca: Int
    packing: Int
    framing: Int
    max_transport_latency_c_to_p: Int
    max_transport_latency_p_to_c: Int

// One CIS configuration of the LE Set CIG Parameters command: the
// elements CIS_ID[i] to RTN_P_To_C[i].  The two PHY fields are bit
// fields (bit 0 LE 1M, bit 1 LE 2M, bit 2 LE Coded).
pub @value
struct CisParameters
    cis_id: Int
    max_sdu_c_to_p: Int
    max_sdu_p_to_c: Int
    phy_c_to_p: Int
    phy_p_to_c: Int
    rtn_c_to_p: Int
    rtn_p_to_c: Int

// The parameter octets of the LE Set CIG Parameters command ([Vol 4]
// Part E, Section 7.8.97): the CIG-wide parameters, CIS_Count and then
// one 9-octet element per CIS.  `None` for more CISes than the 0x1F the
// count holds, and for an SDU_Interval outside 0x0000FF to 0x0FFFFF.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_set_cig_parameters(cig: CigParameters, cis: [CisParameters]) -> ?[u8]
    let n = list.len(cis)
    if n > ISO_CIS_COUNT_MAX or not iso_sdu_interval_ok(cig.sdu_interval_c_to_p) or not iso_sdu_interval_ok(cig.sdu_interval_p_to_c)
        return None
    var out = hci_buf.buf(15 + 9 * n)
    hci_buf.put8(var out, cig.cig_id)
    hci_buf.put24(var out, cig.sdu_interval_c_to_p)
    hci_buf.put24(var out, cig.sdu_interval_p_to_c)
    hci_buf.put8(var out, cig.worst_case_sca)
    hci_buf.put8(var out, cig.packing)
    hci_buf.put8(var out, cig.framing)
    hci_buf.put16(var out, cig.max_transport_latency_c_to_p)
    hci_buf.put16(var out, cig.max_transport_latency_p_to_c)
    hci_buf.put8(var out, n)
    for c in cis
        hci_buf.put8(var out, c.cis_id)
        hci_buf.put16(var out, c.max_sdu_c_to_p)
        hci_buf.put16(var out, c.max_sdu_p_to_c)
        hci_buf.put8(var out, c.phy_c_to_p)
        hci_buf.put8(var out, c.phy_p_to_c)
        hci_buf.put8(var out, c.rtn_c_to_p)
        hci_buf.put8(var out, c.rtn_p_to_c)
    Some(out)

// The CIG-wide parameters of the LE Set CIG Parameters Test command
// ([Vol 4] Part E, Section 7.8.98): the flush timeouts and the
// ISO_Interval (1.25 ms units) the Host fixes in place of the two
// transport latencies.
pub @value
struct CigTestParameters
    cig_id: Int
    sdu_interval_c_to_p: Int
    sdu_interval_p_to_c: Int
    ft_c_to_p: Int
    ft_p_to_c: Int
    iso_interval: Int
    worst_case_sca: Int
    packing: Int
    framing: Int

// One CIS configuration of the LE Set CIG Parameters Test command: the
// elements CIS_ID[i] to BN_P_To_C[i].
pub @value
struct CisTestParameters
    cis_id: Int
    nse: Int
    max_sdu_c_to_p: Int
    max_sdu_p_to_c: Int
    max_pdu_c_to_p: Int
    max_pdu_p_to_c: Int
    phy_c_to_p: Int
    phy_p_to_c: Int
    bn_c_to_p: Int
    bn_p_to_c: Int

// The parameter octets of the LE Set CIG Parameters Test command
// ([Vol 4] Part E, Section 7.8.98): the CIG-wide parameters,
// CIS_Count and one 14-octet element per CIS.  `None` for more CISes than
// the 0x1F the count holds and for an SDU_Interval outside 0x0000FF to
// 0x0FFFFF.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_set_cig_parameters_test(cig: CigTestParameters, cis: [CisTestParameters]) -> ?[u8]
    let n = list.len(cis)
    if n > ISO_CIS_COUNT_MAX or not iso_sdu_interval_ok(cig.sdu_interval_c_to_p) or not iso_sdu_interval_ok(cig.sdu_interval_p_to_c)
        return None
    var out = hci_buf.buf(15 + 14 * n)
    hci_buf.put8(var out, cig.cig_id)
    hci_buf.put24(var out, cig.sdu_interval_c_to_p)
    hci_buf.put24(var out, cig.sdu_interval_p_to_c)
    hci_buf.put8(var out, cig.ft_c_to_p)
    hci_buf.put8(var out, cig.ft_p_to_c)
    hci_buf.put16(var out, cig.iso_interval)
    hci_buf.put8(var out, cig.worst_case_sca)
    hci_buf.put8(var out, cig.packing)
    hci_buf.put8(var out, cig.framing)
    hci_buf.put8(var out, n)
    for c in cis
        hci_buf.put8(var out, c.cis_id)
        hci_buf.put8(var out, c.nse)
        hci_buf.put16(var out, c.max_sdu_c_to_p)
        hci_buf.put16(var out, c.max_sdu_p_to_c)
        hci_buf.put16(var out, c.max_pdu_c_to_p)
        hci_buf.put16(var out, c.max_pdu_p_to_c)
        hci_buf.put8(var out, c.phy_c_to_p)
        hci_buf.put8(var out, c.phy_p_to_c)
        hci_buf.put8(var out, c.bn_c_to_p)
        hci_buf.put8(var out, c.bn_p_to_c)
    Some(out)

// One CIS the LE Create CIS command opens: the handle the LE Set CIG
// Parameters command returned for it and the handle of the ACL
// connection to the Peripheral that carries it.
pub @value
struct CisLink
    cis_connection_handle: Int
    acl_connection_handle: Int

// The parameter octets of the LE Create CIS command ([Vol 4] Part E,
// Section 7.8.99): CIS_Count, then CIS_Connection_Handle[i] and
// ACL_Connection_Handle[i] element by element.  `None` for no CIS or for
// more than the 0x1F the count holds.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_create_cis(links: [CisLink]) -> ?[u8]
    let n = list.len(links)
    if n < 1 or n > ISO_CIS_COUNT_MAX
        return None
    var out = hci_buf.buf(1 + 4 * n)
    hci_buf.put8(var out, n)
    for l in links
        hci_buf.put12(var out, l.cis_connection_handle)
        hci_buf.put12(var out, l.acl_connection_handle)
    Some(out)

// The parameter octet of the LE Remove CIG command ([Vol 4] Part E,
// Section 7.8.100): CIG_ID.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_remove_cig(cig_id: Int) -> [u8]
    var out = hci_buf.buf(1)
    hci_buf.put8(var out, cig_id)
    out

// The parameter octets of the LE Accept CIS Request command ([Vol 4] Part
// E, Section 7.8.101): the Connection_Handle of the CIS.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_accept_cis_request(connection_handle: Int) -> [u8]
    var out = hci_buf.buf(2)
    hci_buf.put12(var out, connection_handle)
    out

// The parameter octets of the LE Reject CIS Request command ([Vol 4]
// Part E, Section 7.8.102): Connection_Handle of the CIS and the
// Reason, a Controller error code.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_reject_cis_request(connection_handle: Int, reason: Int) -> [u8]
    var out = hci_buf.buf(3)
    hci_buf.put12(var out, connection_handle)
    hci_buf.put8(var out, reason)
    out

// The 31 parameter octets of the LE Create BIG command ([Vol 4] Part E,
// Section 7.8.103): BIG_Handle, Advertising_Handle, Num_BIS, SDU_Interval
// (microseconds), Max_SDU, Max_Transport_Latency (milliseconds), RTN,
// PHY (bit field), Packing, Framing, Encryption and the 16-octet
// Broadcast_Code.  `None` for no BIS, more than the 0x1F the count
// holds, an SDU_Interval outside 0x0000FF to 0x0FFFFF, or a Broadcast_Code
// of another length.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_create_big(big_handle: Int, advertising_handle: Int, num_bis: Int, sdu_interval: Int,
                       max_sdu: Int, max_transport_latency: Int, rtn: Int, phy: Int, packing: Int,
                       framing: Int, encryption: Bool, broadcast_code: [u8]) -> ?[u8]
    if num_bis < 1 or num_bis > ISO_BIS_COUNT_MAX or not iso_sdu_interval_ok(sdu_interval) or list.len(broadcast_code) != ISO_BROADCAST_CODE_LENGTH
        return None
    var out = hci_buf.buf(15 + ISO_BROADCAST_CODE_LENGTH)
    hci_buf.put8(var out, big_handle)
    hci_buf.put8(var out, advertising_handle)
    hci_buf.put8(var out, num_bis)
    hci_buf.put24(var out, sdu_interval)
    hci_buf.put16(var out, max_sdu)
    hci_buf.put16(var out, max_transport_latency)
    hci_buf.put8(var out, rtn)
    hci_buf.put8(var out, phy)
    hci_buf.put8(var out, packing)
    hci_buf.put8(var out, framing)
    hci_buf.put8(var out, if encryption then 0x01 else 0x00)
    hci_buf.put_bytes(var out, broadcast_code)
    Some(out)

// The 36 parameter octets of the LE Create BIG Test command ([Vol 4]
// Part E, Section 7.8.104): BIG_Handle, Advertising_Handle, Num_BIS,
// SDU_Interval, ISO_Interval (1.25 ms units), NSE, Max_SDU, Max_PDU,
// PHY, Packing, Framing, BN, IRC, PTO, Encryption and the Broadcast_Code.
// `None` for the refusals of `build_le_create_big`.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_create_big_test(big_handle: Int, advertising_handle: Int, num_bis: Int,
                            sdu_interval: Int, iso_interval: Int, nse: Int, max_sdu: Int,
                            max_pdu: Int, phy: Int, packing: Int, framing: Int, bn: Int, irc: Int,
                            pto: Int, encryption: Bool, broadcast_code: [u8]) -> ?[u8]
    if num_bis < 1 or num_bis > ISO_BIS_COUNT_MAX or not iso_sdu_interval_ok(sdu_interval) or list.len(broadcast_code) != ISO_BROADCAST_CODE_LENGTH
        return None
    var out = hci_buf.buf(20 + ISO_BROADCAST_CODE_LENGTH)
    hci_buf.put8(var out, big_handle)
    hci_buf.put8(var out, advertising_handle)
    hci_buf.put8(var out, num_bis)
    hci_buf.put24(var out, sdu_interval)
    hci_buf.put16(var out, iso_interval)
    hci_buf.put8(var out, nse)
    hci_buf.put16(var out, max_sdu)
    hci_buf.put16(var out, max_pdu)
    hci_buf.put8(var out, phy)
    hci_buf.put8(var out, packing)
    hci_buf.put8(var out, framing)
    hci_buf.put8(var out, bn)
    hci_buf.put8(var out, irc)
    hci_buf.put8(var out, pto)
    hci_buf.put8(var out, if encryption then 0x01 else 0x00)
    hci_buf.put_bytes(var out, broadcast_code)
    Some(out)

// The parameter octets of the LE Terminate BIG command ([Vol 4] Part E,
// Section 7.8.105): BIG_Handle and Reason.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_terminate_big(big_handle: Int, reason: Int) -> [u8]
    var out = hci_buf.buf(2)
    hci_buf.put8(var out, big_handle)
    hci_buf.put8(var out, reason)
    out

// The parameter octets of the LE BIG Create Sync command ([Vol 4] Part
// E, Section 7.8.106): BIG_Handle, Sync_Handle of the periodic
// advertising train that carries the BIGInfo, Encryption, the Broadcast_Code,
// MSE, BIG_Sync_Timeout (10 ms units), Num_BIS and BIS[i], the index of
// each BIS to synchronize to.  `None` for no BIS, more than the 0x1F the
// count holds, or a Broadcast_Code of another length.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_big_create_sync(big_handle: Int, sync_handle: Int, encryption: Bool,
                            broadcast_code: [u8], mse: Int, big_sync_timeout: Int,
                            bis: [Int]) -> ?[u8]
    let n = list.len(bis)
    if n < 1 or n > ISO_BIS_COUNT_MAX or list.len(broadcast_code) != ISO_BROADCAST_CODE_LENGTH
        return None
    var out = hci_buf.buf(7 + ISO_BROADCAST_CODE_LENGTH + n + 3)
    hci_buf.put8(var out, big_handle)
    hci_buf.put12(var out, sync_handle)
    hci_buf.put8(var out, if encryption then 0x01 else 0x00)
    hci_buf.put_bytes(var out, broadcast_code)
    hci_buf.put8(var out, mse)
    hci_buf.put16(var out, big_sync_timeout)
    hci_buf.put8(var out, n)
    for b in bis
        hci_buf.put8(var out, b)
    Some(out)

// The parameter octet of the LE BIG Terminate Sync command ([Vol 4] Part
// E, Section 7.8.107): BIG_Handle.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_big_terminate_sync(big_handle: Int) -> [u8]
    var out = hci_buf.buf(1)
    hci_buf.put8(var out, big_handle)
    out

// The Codec_ID of the LE Setup ISO Data Path command, 5 octets: the
// Coding_Format, then the Company_ID and the Vendor_Specific_Codec_ID,
// which are meaningful only for the Vendor Specific coding format 0xFF
// ([Vol 4] Part E, Section 7.8.109).
pub const ISO_CODING_FORMAT_TRANSPARENT = 0x03

// Coding_Format 0x06: LC3 ([Vol 4] Part E, Section 7.8.109).
pub const ISO_CODING_FORMAT_LC3 = 0x06

// Coding_Format 0xFF: a vendor-specific codec, named by the Company_ID and Vendor_Specific_Codec_ID that follow it.
pub const ISO_CODING_FORMAT_VENDOR_SPECIFIC = 0xFF

// The Codec_ID of the LE Setup ISO Data Path command: 5 octets, `coding_format` and then `company_id` and
// `vendor_specific_codec_id`, each 2 octets least significant first.
//
// The last two are meaningful only for `ISO_CODING_FORMAT_VENDOR_SPECIFIC` ([Vol 4] Part E, Section 7.8.109).
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn iso_codec_id(coding_format: Int, company_id: Int, vendor_specific_codec_id: Int) -> [u8]
    var out = hci_buf.buf(5)
    hci_buf.put8(var out, coding_format)
    hci_buf.put16(var out, company_id)
    hci_buf.put16(var out, vendor_specific_codec_id)
    out

// The parameter octets of the LE Setup ISO Data Path command ([Vol 4]
// Part E, Section 7.8.109): Connection_Handle, Data_Path_Direction,
// Data_Path_ID, the 5-octet Codec_ID, Controller_Delay (microseconds, 3
// octets), Codec_Configuration_Length and Codec_Configuration.  `None`
// for a Codec_ID that is not 5 octets or a configuration of more than the
// 255 octets its length holds.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_setup_iso_data_path(connection_handle: Int, direction: Int, data_path_id: Int,
                                codec_id: [u8], controller_delay: Int,
                                codec_configuration: [u8]) -> ?[u8]
    if list.len(codec_id) != 5 or list.len(codec_configuration) > 255
        return None
    var out = hci_buf.buf(13 + list.len(codec_configuration))
    hci_buf.put12(var out, connection_handle)
    hci_buf.put8(var out, direction)
    hci_buf.put8(var out, data_path_id)
    hci_buf.put_bytes(var out, codec_id)
    hci_buf.put24(var out, controller_delay)
    hci_buf.put8(var out, list.len(codec_configuration))
    hci_buf.put_bytes(var out, codec_configuration)
    Some(out)

// The parameter octets of the LE Remove ISO Data Path command ([Vol 4]
// Part E, Section 7.8.110): Connection_Handle and Data_Path_Direction,
// a bit field here: bit 0 the input path, bit 1 the output path.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_remove_iso_data_path(connection_handle: Int, data_path_direction: Int) -> [u8]
    var out = hci_buf.buf(3)
    hci_buf.put12(var out, connection_handle)
    hci_buf.put8(var out, data_path_direction)
    out

// The parameter octets of the LE ISO Transmit Test and LE ISO Receive
// Test commands ([Vol 4] Part E, Section 7.8.111 and 7.8.112):
// Connection_Handle and Payload_Type.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn build_le_iso_test(connection_handle: Int, payload_type: Int) -> [u8]
    var out = hci_buf.buf(3)
    hci_buf.put12(var out, connection_handle)
    hci_buf.put8(var out, payload_type)
    out

// Bits 24 to 29, 33 and 41 of the LE event mask are the events of the
// isochronous channels ([Vol 4] Part E, Section 7.8.1): LE CIS
// Established [v1] (24), LE CIS Request (25), LE Create BIG Complete
// (26), LE Terminate BIG Complete (27), LE BIG Sync Established (28), LE
// BIG Sync Lost (29), LE BIGInfo Advertising Report (33) and LE CIS
// Established [v2] (41).  The two CIS Established events are LE Meta
// subevents 0x19 and 0x2A; the specification gives the [v2] form the
// fields of the [v1] form and six more, and it does not say which of the
// two a Controller sends when both bits are set, so a Host that sets
// both reads either (`le_cis_established` decodes both).  The bit of an
// LE Meta subevent is its Subevent_Code minus one.
pub const LE_EVENT_MASK_CIS_ESTABLISHED = 0x0000000001000000

// Bit 25 of the LE_Event_Mask: the LE CIS Request event, which a Peripheral needs to accept a CIS.
pub const LE_EVENT_MASK_CIS_REQUEST = 0x0000000002000000

// Bit 41 of the LE_Event_Mask: the LE CIS Established [v2] event, which carries the fields of the [v1] event and six more.
pub const LE_EVENT_MASK_CIS_ESTABLISHED_V2 = 0x0000020000000000

// LE Create BIG Complete, LE Terminate BIG Complete, LE BIG Sync
// Established and LE BIG Sync Lost: bits 26 to 29, the events of the
// Broadcast Isochronous Group the Host transmits or follows.
pub const LE_EVENT_MASK_BIG = 0x000000003C000000

// The two halves of the four: an Isochronous Broadcaster needs LE Create
// BIG Complete and LE Terminate BIG Complete (bits 26 and 27), a
// Synchronized Receiver LE BIG Sync Established and LE BIG Sync Lost
// (bits 28 and 29).
pub const LE_EVENT_MASK_BIG_BROADCASTER = 0x000000000C000000

// Bits 28 and 29 of the LE_Event_Mask: LE BIG Sync Established and LE BIG Sync Lost, the events of a Synchronized Receiver.
pub const LE_EVENT_MASK_BIG_RECEIVER = 0x0000000030000000

// Bit 33 of the LE_Event_Mask: the LE BIGInfo Advertising Report event.
pub const LE_EVENT_MASK_BIG_INFO_ADVERTISING_REPORT = 0x0000000200000000

// The CIS events a Central or a Peripheral needs, with the [v2] form of
// the CIS Established event; and the BIG events with the BIGInfo report.
pub const LE_EVENT_MASK_ISOCHRONOUS = 0x000002023F000000

// ── LE feature set ──────────────────────────────────────────────────
//
// The LE Read Local Supported Features command ([Vol 4] Part E, Section
// 7.8.3) answers with LE_Features, 8 octets whose bit N is feature N.
// Bit 1 is the Connection Parameters Request Procedure ([Vol 6] Part B,
// Section 5.1.7): a Controller that sets it runs the procedure itself,
// and one that leaves it clear leaves a Peripheral's Host the
// L2CAP_CONNECTION_PARAMETER_UPDATE_REQ command ([Vol 3] Part C,
// Section 9.3.9.2).  A Nordic SoftDevice Controller keeps the
// bit clear.

// Whether the feature set `features` has the Connection Parameters
// Request Procedure, bit 1 of the first octet.  An empty set — a
// Controller that was never asked — answers false, the reading that
// sends the procedure over L2CAP.
pub @tier(embedded)
@no_alloc
fn has_connection_parameters_request(features: [u8]) -> Bool
    list.len(features) > 0 and (features[0] as Int & 0x02) != 0

// Whether `commands`, the 64 octets of Supported_Commands, lists LE
// Extended Create Connection (0x2043): octet 37 bit 7 ([Vol 4] Part E,
// Section 6.27; octet 38 bit 0 is LE Periodic Advertising Create Sync).  An answer too short to reach the octet, or none at all,
// lists nothing.
pub @tier(embedded)
@no_alloc
fn has_le_extended_create_connection(commands: [u8]) -> Bool
    list.len(commands) > 37 and (commands[37] as Int & 0x80) != 0

// Whether `commands`, the 64 octets of Supported_Commands, lists the three commands that write the resolving list and turn
// address resolution on: LE Add Device To Resolving List (octet 34 bit 3), LE Clear Resolving List (octet 34 bit 5) and LE Set
// Address Resolution Enable (octet 35 bit 1) ([Vol 4] Part E, Section 6.27).  An answer too short to reach the octets lists nothing.
pub @tier(embedded)
@no_alloc
fn has_le_resolving_list(commands: [u8]) -> Bool
    list.len(commands) > 35 and (commands[34] as Int & 0x28) == 0x28 and (commands[35] as Int & 0x02) != 0

// ── Connection parameters ───────────────────────────────────────────

// The opcode of the LE Connection Update command, 0x2013 ([Vol 4] Part E, Section 7.8.18).
pub @tier(embedded)
@no_alloc
fn opcode_le_connection_update() -> Int
    // OGF=0x08, OCF=0x0013 → 0x2013.
    (0x08 << 10) | 0x013

// [Vol 4] Part E, Section 7.8.31 — LE Remote Connection Parameter
// Request Reply command.
pub @tier(embedded)
@no_alloc
fn opcode_le_remote_connection_parameter_request_reply() -> Int
    // OGF=0x08, OCF=0x0020 → 0x2020.
    (0x08 << 10) | 0x020

// [Vol 4] Part E, Section 7.8.32 — LE Remote Connection Parameter
// Request Negative Reply command.
pub @tier(embedded)
@no_alloc
fn opcode_le_remote_connection_parameter_request_negative_reply() -> Int
    // OGF=0x08, OCF=0x0021 → 0x2021.
    (0x08 << 10) | 0x021

// Reason Unacceptable Connection Parameters (0x3B), the Reason of the LE
// Remote Connection Parameter Request Negative Reply command.
pub const REASON_UNACCEPTABLE_CONNECTION_PARAMETERS = 0x3B

// The 14 parameter octets the LE Connection Update command and the LE
// Remote Connection Parameter Request Reply command share:
// Connection_Handle, the minimum and maximum connection interval, the
// maximum Peripheral latency, the supervision timeout, Min_CE_Length and
// Max_CE_Length, each 2 octets least significant first.  The intervals
// are in 1.25 ms units, the timeout in 10 ms units and the two lengths
// in 0.625 ms units.
pub @tier(embedded)
fn build_connection_parameters(connection_handle: Int, interval_min: Int, interval_max: Int,
                               latency: Int, timeout: Int, min_ce_length: Int,
                               max_ce_length: Int) -> [u8]
    var out = hci_buf.buf(14)
    hci_buf.put12(var out, connection_handle)
    hci_buf.put16(var out, interval_min)
    hci_buf.put16(var out, interval_max)
    hci_buf.put16(var out, latency)
    hci_buf.put16(var out, timeout)
    hci_buf.put16(var out, min_ce_length)
    hci_buf.put16(var out, max_ce_length)
    out

// The 25 parameter octets of the LE Create Connection command: the
// scanning intervals and the initiator filter policy, the peer's
// address type and address, this Host's own address type, the
// connection interval range, the Peripheral latency and supervision
// timeout, and Min_CE_Length and Max_CE_Length, each 2 octets least
// significant first ([Vol 4] Part E, Section 7.8.12).  The intervals
// are in 1.25 ms units, the timeout in 10 ms units and the two lengths
// in 0.625 ms units.
pub @tier(embedded)
fn build_le_create_connection(scan_interval: Int, scan_window: Int, filter_policy: Int,
                              peer_address_type: Int, peer_address: [u8], own_address_type: Int,
                              interval_min: Int, interval_max: Int, latency: Int, timeout: Int,
                              min_ce_length: Int, max_ce_length: Int) -> [u8]
    var out = hci_buf.buf(25)
    hci_buf.put16(var out, scan_interval)
    hci_buf.put16(var out, scan_window)
    hci_buf.put8(var out, filter_policy)
    hci_buf.put8(var out, peer_address_type)
    hci_buf.put_range(var out, peer_address, 0, 6)
    hci_buf.put8(var out, own_address_type)
    hci_buf.put16(var out, interval_min)
    hci_buf.put16(var out, interval_max)
    hci_buf.put16(var out, latency)
    hci_buf.put16(var out, timeout)
    hci_buf.put16(var out, min_ce_length)
    hci_buf.put16(var out, max_ce_length)
    out

// The 26 parameter octets of the LE Extended Create Connection command on the LE 1M
// PHY alone ([Vol 4] Part E, Section 7.8.66): the initiator filter policy, this
// Host's own address type, the peer's address type and address, Initiating_PHYs
// (0x01, LE 1M), then for that PHY the scan interval and window, the connection
// interval range, the Peripheral latency, the supervision timeout and
// Min_CE_Length and Max_CE_Length, each 2 octets least significant first.  The
// units are those of LE Create Connection.
pub @tier(embedded)
fn build_le_extended_create_connection(scan_interval: Int, scan_window: Int, filter_policy: Int,
                                       peer_address_type: Int, peer_address: [u8],
                                       own_address_type: Int, interval_min: Int, interval_max: Int,
                                       latency: Int, timeout: Int, min_ce_length: Int,
                                       max_ce_length: Int) -> [u8]
    var out = hci_buf.buf(26)
    hci_buf.put8(var out, filter_policy)
    hci_buf.put8(var out, own_address_type)
    hci_buf.put8(var out, peer_address_type)
    hci_buf.put_range(var out, peer_address, 0, 6)
    hci_buf.put8(var out, 0x01)
    hci_buf.put16(var out, scan_interval)
    hci_buf.put16(var out, scan_window)
    hci_buf.put16(var out, interval_min)
    hci_buf.put16(var out, interval_max)
    hci_buf.put16(var out, latency)
    hci_buf.put16(var out, timeout)
    hci_buf.put16(var out, min_ce_length)
    hci_buf.put16(var out, max_ce_length)
    out

// The parameters of a command that names only a connection and one
// octet after it: the LE Remote Connection Parameter Request Negative
// Reply command takes Connection_Handle and Reason.
pub @tier(embedded)
fn build_handle_and_reason(connection_handle: Int, reason: Int) -> [u8]
    var out = hci_buf.buf(3)
    hci_buf.put12(var out, connection_handle)
    hci_buf.put8(var out, reason)
    out

// The parameter of the LE Long Term Key Request Negative Reply command
// ([Vol 4] Part E, Section 7.8.26): Connection_Handle.
pub @tier(embedded)
fn build_connection_handle(connection_handle: Int) -> [u8]
    var out = hci_buf.buf(2)
    hci_buf.put12(var out, connection_handle)
    out

// The 14 parameter octets of the LE Periodic Advertising Create Sync
// command ([Vol 4] Part E, Section 7.8.67): Options, Advertising_SID,
// the advertiser's address type and address, Skip, Sync_Timeout in 10 ms
// units and Sync_CTE_Type.  `None` when an option bit above bit 1 is set
// or Sync_Timeout falls outside the range the command admits.
pub @satisfies("REQ-BLE-HCI-055")
@tier(embedded)
fn build_le_periodic_advertising_create_sync(options: Int, advertising_sid: Int,
                                             advertiser_address_type: Int, advertiser_address: [u8],
                                             skip: Int, sync_timeout: Int, cte_type: Int) -> ?[u8]
    if (options & 0xF8) != 0 or sync_timeout < PERIODIC_SYNC_TIMEOUT_RANGE_MIN or sync_timeout > PERIODIC_SYNC_TIMEOUT_RANGE_MAX
        None
    else
        var out = hci_buf.buf(14)
        hci_buf.put8(var out, options)
        hci_buf.put8(var out, advertising_sid)
        hci_buf.put8(var out, advertiser_address_type)
        hci_buf.put_range(var out, advertiser_address, 0, 6)
        hci_buf.put16(var out, skip)
        hci_buf.put16(var out, sync_timeout)
        hci_buf.put8(var out, cte_type)
        Some(out)

// The 2 parameter octets of the LE Periodic Advertising Terminate Sync
// command ([Vol 4] Part E, Section 7.8.69): Sync_Handle.
pub @satisfies("REQ-BLE-HCI-055")
@tier(embedded)
fn build_le_periodic_advertising_terminate_sync(sync_handle: Int) -> [u8]
    var out = hci_buf.buf(2)
    hci_buf.put12(var out, sync_handle)
    out

// The parameters of the LE Long Term Key Request Reply command ([Vol 4]
// Part E, Section 7.8.25): Connection_Handle, then the 16 octets of
// Long_Term_Key, least significant octet first.
pub @tier(embedded)
fn build_le_long_term_key_request_reply(connection_handle: Int, ltk: [u8]) -> [u8]
    var out = hci_buf.buf(2 + list.len(ltk))
    hci_buf.put12(var out, connection_handle)
    hci_buf.put_bytes(var out, ltk)
    out

// The parameters of the LE Start Encryption command ([Vol 4] Part E,
// Section 7.8.24): Connection_Handle, Random_Number (8 octets),
// Encrypted_Diversifier (2 octets) and Long_Term_Key (16 octets), each
// least significant octet first.  The Central sends it to encrypt the
// link with the STK or LTK of a pairing, or with a bond's LTK; EDIV and
// Rand are zero for a key that is not identified by them (Sections
// 2.4.4.1 and 2.4.4.2).
pub @tier(embedded)
fn build_le_start_encryption(connection_handle: Int, rand_number: [u8], ediv: Int,
                             ltk: [u8]) -> [u8]
    var out = hci_buf.buf(28)
    hci_buf.put12(var out, connection_handle)
    hci_buf.put_range(var out, rand_number, 0, 8)
    hci_buf.put16(var out, ediv)
    hci_buf.put_range(var out, ltk, 0, 16)
    out
