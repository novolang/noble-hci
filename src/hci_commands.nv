// [Vol 4] Part E, Section 7.8.12 — LE Create Connection command, the
// Central's command: it starts the Initiating State, and the LE
// Connection Complete event reports the connection it makes.
pub @tier(embedded)
@no_alloc
fn opcode_le_create_connection() -> Int
    // OGF=0x08, OCF=0x000D → 0x200D.
    (0x08 << 10) | 0x00D

// [Vol 4] Part E, Section 7.8.66 — LE Extended Create Connection command, the
// Central's command for a peer that advertises with extended PDUs: a Controller
// that scans with LE Create Connection does not hear them.  Its status arrives as
// a Command Status event and the connection as LE Enhanced Connection Complete
// (or LE Connection Complete when the Host left that event masked).
pub @tier(embedded)
fn opcode_le_extended_create_connection() -> Int
    // OGF=0x08, OCF=0x043 → 0x2043.
    (0x08 << 10) | 0x043

// The opcode of the LE Create Connection Cancel command, 0x200E ([Vol 4] Part E, Section 7.8.13).
