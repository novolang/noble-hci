@test
@satisfies("REQ-BLE-HCI-051")
fn test_extended_advertising_parameters_layout()
    let peer: [u8] = [0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
    // A non-connectable, non-scannable extended set: no property bit at
    // all, the intervals of 100 ms (0x00A0 = 160 units in 0.625 ms), the
    // three advertising channels, the random address this Host uses, the
    // LE 1M primary PHY and LE 2M for the auxiliary PDUs.
    let p = build_le_set_extended_advertising_parameters(0x00, 0x0000, 0x0000A0, 0x0000A0, ADV_CHANNEL_MAP_ALL,
                                                         OWN_ADDR_TYPE_RANDOM, 0x00, peer, ADV_FILTER_NONE,
                                                         ADV_TX_POWER_NO_PREFERENCE, LE_PHY_1M, 0x00, LE_PHY_2M, 0x00, 0x00)
    test.assert_eq(list.len(p), 25)
    let want: [u8] = [0x00, 0x00, 0x00, 0xA0, 0x00, 0x00, 0xA0, 0x00, 0x00, 0x07, 0x01, 0x00,
                      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x7F, 0x01, 0x00, 0x02, 0x00, 0x00]
    for i in 0..25
        test.assert_eq(p[i] as Int, want[i] as Int)

@test
@satisfies("REQ-BLE-HCI-051")
fn test_extended_advertising_parameters_connectable_flags()
    let peer: [u8] = [0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
    // Connectable, scannable, legacy: the 0b00000000_00010011 of Table
    // 7.3, which is ADV_IND.
    let p = build_le_set_extended_advertising_parameters(0x01, ADV_EVENT_PROP_CONNECTABLE | ADV_EVENT_PROP_SCANNABLE | ADV_EVENT_PROP_LEGACY,
                                                         0x00A0, 0x00A0, ADV_CHANNEL_MAP_ALL, OWN_ADDR_TYPE_RANDOM, 0x00, peer,
                                                         ADV_FILTER_NONE, ADV_TX_POWER_NO_PREFERENCE, LE_PHY_1M, 0x00, LE_PHY_1M, 0x02, 0x00)
    test.assert_eq(p[0] as Int, 0x01)
    test.assert_eq(p[1] as Int, 0x13)
    test.assert_eq(p[2] as Int, 0x00)
    // 22 is Secondary_Advertising_PHY, 23 Advertising_SID, 24 the scan
    // request notification.
    test.assert_eq(p[22] as Int, LE_PHY_1M)
    test.assert_eq(p[23] as Int, 0x02)
    test.assert_eq(p[24] as Int, 0x00)

@test
@satisfies("REQ-BLE-HCI-051")
fn test_extended_data_and_enable_layout()
    let ad: [u8] = [0x02, 0x01, 0x06]
    match build_le_set_extended_data(0x00, EXT_ADV_DATA_COMPLETE, EXT_ADV_FRAGMENT_ANY, ad)
        None => test.fail("three octets of data fit in one operation")
        Some(p) =>
            test.assert_eq(list.len(p), 7)
            test.assert_eq(p[0] as Int, 0x00)
            test.assert_eq(p[1] as Int, EXT_ADV_DATA_COMPLETE)
            test.assert_eq(p[2] as Int, EXT_ADV_FRAGMENT_ANY)
            test.assert_eq(p[3] as Int, 3)
            test.assert_eq(p[6] as Int, 0x06)
    var too_long: [u8] = []
    for _ in 0..256
        list.push(too_long, 0x00)
    match build_le_set_extended_data(0x00, EXT_ADV_DATA_COMPLETE, EXT_ADV_FRAGMENT_ANY, too_long)
        None    => test.assert(true)
        Some(_) => test.fail("256 octets do not fit one operation")
    let on = build_le_set_extended_advertising_enable(true, 0x00, 0x0000, 0x00)
    test.assert_eq(list.len(on), 6)
    test.assert_eq(on[0] as Int, 0x01)
    test.assert_eq(on[1] as Int, 0x01)
    test.assert_eq(on[5] as Int, 0x00)
    let off = build_le_set_extended_advertising_enable(false, 0x00, 0x0000, 0x00)
    test.assert_eq(off[0] as Int, 0x00)
    // A duration in 10 ms units, least significant octet first.
    let timed = build_le_set_extended_advertising_enable(true, 0x02, 0x0123, 0x05)
    test.assert_eq(timed[2] as Int, 0x02)
    test.assert_eq(timed[3] as Int, 0x23)
    test.assert_eq(timed[4] as Int, 0x01)
    test.assert_eq(timed[5] as Int, 0x05)
    test.assert_eq(build_le_remove_advertising_set(0x00)[0] as Int, 0x00)

@test
@satisfies("REQ-BLE-HCI-052")
fn test_periodic_advertising_command_layout()
    // 150 and 200 units of 1.25 ms: the intervals the AutoPTS project
    // gives Configure Periodic Advertising, and the TxPower property.
    let params = build_le_set_periodic_advertising_parameters(0x00, 0x0096, 0x00C8, PERIODIC_ADV_PROP_INCLUDE_TX_POWER)
    // Seven octets, not six: the properties field is two octets wide
    // like the intervals, and a Controller reads the length off the
    // command ([Vol 4] Part E, Section 7.8.61).
    test.assert_eq(list.len(params), 7)
    let want: [u8] = [0x00, 0x96, 0x00, 0xC8, 0x00, 0x01, 0x00]
    for i in 0..7
        test.assert_eq(params[i] as Int, want[i] as Int)
    let data: [u8] = [0x0C, 0x08, 'P', 'A', 'D', 'V']
    match build_le_set_periodic_advertising_data(0x00, EXT_ADV_DATA_COMPLETE, data)
        None => test.fail("six octets of periodic data fit")
        Some(p) =>
            test.assert_eq(list.len(p), 9)
            test.assert_eq(p[1] as Int, EXT_ADV_DATA_COMPLETE)
            test.assert_eq(p[2] as Int, 6)
            test.assert_eq(p[8] as Int, 'V' as Int)
    let enable = build_le_set_periodic_advertising_enable(true, 0x00)
    test.assert_eq(list.len(enable), 2)
    test.assert_eq(enable[0] as Int, 0x01)
    test.assert_eq(enable[1] as Int, 0x00)
    test.assert_eq(build_le_set_periodic_advertising_enable(false, 0x01)[0] as Int, 0x00)

@test
fn test_periodic_interval_units_from_ms()
    // 187.5 ms is 150 units of 1.25 ms, 250 ms is 200.
    test.assert_eq(periodic_interval_units(187) ?? -1, 149)
    test.assert_eq(periodic_interval_units(188) ?? -1, 150)
    test.assert_eq(periodic_interval_units(250) ?? -1, 200)
    test.assert_eq(periodic_interval_units(7) ?? -1, -1)
    // The ceiling: 81918 ms is 65534 units, 81919 ms is 65535.
    test.assert_eq(periodic_interval_units(81918) ?? -1, 0xFFFE)
    test.assert_eq(periodic_interval_units(81919) ?? -1, 0xFFFF)

@test
@satisfies("REQ-BLE-HCI-053")
@satisfies("REQ-BLE-HCI-054")
fn test_periodic_sync_transfer_layout()
    // Mode 0x01: report the transfer and keep periodic advertising
    // reports disabled, which is the "without listening" of
    // GAP/PADV/PASE/BV-03-C.
    let params = build_le_set_periodic_advertising_sync_transfer_parameters(0x0E41, PERIODIC_TRANSFER_NO_REPORTS, 0x0000, 0x01F4, PERIODIC_TRANSFER_CTE_ANY)
    test.assert_eq(list.len(params), 8)
    test.assert_eq(params[0] as Int, 0x41)
    test.assert_eq(params[1] as Int, 0x0E)
    test.assert_eq(params[2] as Int, 0x01)
    test.assert_eq(params[3] as Int, 0x00)
    test.assert_eq(params[5] as Int, 0xF4)
    test.assert_eq(params[6] as Int, 0x01)
    let set_info = build_le_periodic_advertising_set_info_transfer(0x0E41, 0x1234, 0x00)
    test.assert_eq(list.len(set_info), 5)
    test.assert_eq(set_info[2] as Int, 0x34)
    test.assert_eq(set_info[3] as Int, 0x12)
    test.assert_eq(set_info[4] as Int, 0x00)
    let transfer = build_le_periodic_advertising_sync_transfer(0x0E41, 0x1234, 0x0005)
    test.assert_eq(list.len(transfer), 6)
    test.assert_eq(transfer[4] as Int, 0x05)
    test.assert_eq(transfer[5] as Int, 0x00)

