@test
@satisfies("REQ-BLE-HCI-055")
fn test_build_le_periodic_advertising_create_sync()
    let addr: [u8] = [0x01, 0x4F, 0x56, 0x4F, 0x4E, 0xC0]
    // Reports disabled (bit 1), SID 0, a public advertiser, no skip, 5 s.
    match build_le_periodic_advertising_create_sync(PERIODIC_SYNC_OPTIONS_REPORTS_DISABLED, 0x00, 0x00, addr, 0x0000, 0x01F4, PERIODIC_SYNC_CTE_ANY)
        None => test.fail("the parameters are inside the range")
        Some(p) =>
            test.assert_eq(list.len(p), 14)
            let want: [u8] = [0x02, 0x00, 0x00, 0x01, 0x4F, 0x56, 0x4F, 0x4E, 0xC0, 0x00, 0x00, 0xF4, 0x01, 0x00]
            for i in 0..14
                test.assert_eq(p[i] as Int, want[i] as Int)
    // Reports enabled with duplicate filtering is 0x04.
    match build_le_periodic_advertising_create_sync(PERIODIC_SYNC_OPTIONS_DUPLICATE_FILTERING, 0x02, 0x01, addr, 0x0003, 0x4000, PERIODIC_SYNC_CTE_ANY)
        None => test.fail("options 0x04 and the top of the timeout range are admitted")
        Some(p) =>
            test.assert_eq(p[0] as Int, 0x04)
            test.assert_eq(p[2] as Int, 0x01)
            test.assert_eq(p[11] as Int, 0x00)
            test.assert_eq(p[12] as Int, 0x40)
    // An option bit above bit 2, a timeout below 100 ms and one above
    // 163.84 s are all refused before anything is sent.
    test.assert(build_le_periodic_advertising_create_sync(0x08, 0, 0, addr, 0, 0x01F4, 0) == None)
    test.assert(build_le_periodic_advertising_create_sync(0x00, 0, 0, addr, 0, 0x0009, 0) == None)
    test.assert(build_le_periodic_advertising_create_sync(0x00, 0, 0, addr, 0, 0x4001, 0) == None)

@test
@satisfies("REQ-BLE-HCI-055")
fn test_build_le_periodic_advertising_terminate_sync()
    let p = build_le_periodic_advertising_terminate_sync(0x0005)
    test.assert_eq(list.len(p), 2)
    test.assert_eq(p[0] as Int, 0x05)
    test.assert_eq(p[1] as Int, 0x00)

@test
fn test_le_event_mask_periodic_advertising_bits()
    // Bits 13, 14 and 15 for the Observer's three events, and bit 23 for
    // the transfer the Peripheral receives ([Vol 4] Part E, Section
    // 7.8.1).  Bit 23 is byte 2 bit 7 of the command's eight octets.
    test.assert_eq(LE_EVENT_MASK_PERIODIC_ADVERTISING, 0x80E000)
    test.assert_eq(LE_EVENT_MASK_PERIODIC_ADVERTISING & LE_EVENT_MASK_DEFAULT, 0)
    let p = build_set_event_mask(LE_EVENT_MASK_DEFAULT | LE_EVENT_MASK_PERIODIC_ADVERTISING)
    test.assert_eq(p[0] as Int, 0x1F)
    test.assert_eq(p[1] as Int, 0xE0)
    test.assert_eq(p[2] as Int, 0x80)
    test.assert_eq(p[3] as Int, 0x00)

@test
fn test_extended_scan_opcodes_and_layout()
    test.assert_eq(opcode_le_set_extended_scan_parameters(), 0x2041)
    test.assert_eq(opcode_le_set_extended_scan_enable(), 0x2042)
    // Passive scanning on the LE 1M PHY, random address, basic filter.
    let p = build_le_set_extended_scan_parameters(OWN_ADDR_TYPE_RANDOM, SCAN_FILTER_BASIC_UNFILTERED, SCANNING_PHY_1M, LE_SCAN_TYPE_PASSIVE, 0x0060, 0x0030)
    test.assert_eq(list.len(p), 8)
    let want: [u8] = [0x01, 0x00, 0x01, 0x00, 0x60, 0x00, 0x30, 0x00]
    for i in 0..8
        test.assert_eq(p[i] as Int, want[i] as Int)
    let on = build_le_set_extended_scan_enable(true, false)
    test.assert_eq(list.len(on), 6)
    test.assert_eq(on[0] as Int, 0x01)
    test.assert_eq(on[1] as Int, 0x00)
    test.assert_eq(on[5] as Int, 0x00)
    let off = build_le_set_extended_scan_enable(false, false)
    test.assert_eq(off[0] as Int, 0x00)
    test.assert_eq(SCANNING_PHY_1M, 0x01)

// The two commands of the responses family this Host sends: the [v2]
// periodic advertising parameters, whose twelve octets are what tells a
// Controller the train carries subevents, and the subevent data, whose
// parameter list numbers its arrays together.
@test
@satisfies("REQ-BLE-HCI-056")
fn test_pawr_opcodes_and_parameter_layout()
    test.assert_eq(opcode_le_set_periodic_advertising_parameters_v2(), 0x2086)
    test.assert_eq(opcode_le_set_periodic_advertising_subevent_data(), 0x2082)
    // The AutoPTS project's own numbers: 150 to 200 units, 10 subevents,
    // subevent interval 15, response slot delay 1, response slot spacing
    // 4 and 5 response slots.
    let params = build_le_set_periodic_advertising_parameters_v2(0x00, 0x0096, 0x00C8, 0x0000, 10, 15, 1, 4, 5)
    test.assert_eq(list.len(params), 12)
    let want: [u8] = [0x00, 0x96, 0x00, 0xC8, 0x00, 0x00, 0x00, 10, 15, 1, 4, 5]
    for i in 0..12
        test.assert_eq(params[i] as Int, want[i] as Int)

@test
@satisfies("REQ-BLE-HCI-056")
fn test_pawr_subevent_data_layout()
    let data: [u8] = [0x0C, 0x08, 'P', 'A']
    let one = PawrSubevent { subevent: 3, response_slot_start: 0, response_slot_count: 5, data: data }
    match build_le_set_periodic_advertising_subevent_data(0x00, [one])
        None => test.fail("one subevent of four octets fits")
        Some(p) =>
            // Handle, count, the four one-octet fields of the subevent,
            // then its data: two and four and four.
            test.assert_eq(list.len(p), 10)
            let want: [u8] = [0x00, 0x01, 0x03, 0x00, 0x05, 0x04, 0x0C, 0x08, 'P', 'A']
            for i in 0..10
                test.assert_eq(p[i] as Int, want[i] as Int)
    // Two subevents: each element is its four fields and then its data.
    let two = PawrSubevent { subevent: 0, response_slot_start: 1, response_slot_count: 2, data: data }
    match build_le_set_periodic_advertising_subevent_data(0x00, [one, two])
        None => test.fail("two subevents fit one command")
        Some(p) =>
            // Two octets, then per element four fields and four data octets.
            test.assert_eq(list.len(p), 2 + 8 + 8)
            let want2: [u8] = [0x00, 0x02,
                               0x03, 0x00, 0x05, 0x04, 0x0C, 0x08, 'P', 'A',
                               0x00, 0x01, 0x02, 0x04, 0x0C, 0x08, 'P', 'A']
            for i in 0..18
                test.assert_eq(p[i] as Int, want2[i] as Int)
    // No subevent at all, and more than the 0x0F the count field holds.
    match build_le_set_periodic_advertising_subevent_data(0x00, [])
        None => ()
        Some(_) => test.fail("a command with no subevent is refused")
    var many: [PawrSubevent] = []
    for i in 0..16
        list.push(many, one)
    match build_le_set_periodic_advertising_subevent_data(0x00, many)
        None => ()
        Some(_) => test.fail("sixteen subevents do not fit one command")
    // A subevent above 0x7F and data above 251 octets are refused too.
    let high = PawrSubevent { subevent: 0x80, response_slot_start: 0, response_slot_count: 0, data: [] }
    match build_le_set_periodic_advertising_subevent_data(0x00, [high])
        None => ()
        Some(_) => test.fail("a subevent above 0x7F is refused")
    var big: [u8] = []
    for _ in 0..252
        list.push(big, 0x00)
    let long = PawrSubevent { subevent: 0x00, response_slot_start: 0, response_slot_count: 0, data: big }
    match build_le_set_periodic_advertising_subevent_data(0x00, [long])
        None => ()
        Some(_) => test.fail("252 octets of subevent data are refused")

@test
@satisfies("REQ-BLE-HCI-056")
fn test_pawr_event_mask_bits()
    // Bits 38 and 39 only, and neither of them in the plain periodic
    // advertising mask.
    test.assert_eq(LE_EVENT_MASK_PERIODIC_ADVERTISING_RESPONSES, 0x000000C000000000)
    test.assert_eq((LE_EVENT_MASK_PERIODIC_ADVERTISING & LE_EVENT_MASK_PERIODIC_ADVERTISING_RESPONSES), 0)
    test.assert_eq((LE_EVENT_MASK_DEFAULT & LE_EVENT_MASK_PERIODIC_ADVERTISING_RESPONSES), 0)
    test.assert_eq(PAWR_SUBEVENT_INTERVAL_MIN, 0x06)
    test.assert_eq(PAWR_RESPONSE_SLOT_DELAY_MIN, 0x01)

