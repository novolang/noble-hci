@test
@satisfies("REQ-BLE-HCI-057")
fn test_set_host_feature_layout()
    // Bit 32, Connected Isochronous Stream (Host Support), on and off.
    same_octets(build_le_set_host_feature(FEATURE_CONNECTED_ISOCHRONOUS_STREAM_HOST_SUPPORT, true), [0x20, 0x01])
    same_octets(build_le_set_host_feature(FEATURE_CONNECTED_ISOCHRONOUS_STREAM_HOST_SUPPORT, false), [0x20, 0x00])
    // The [v2] form widens Bit_Number to two octets.
