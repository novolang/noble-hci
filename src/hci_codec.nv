// HCI command, event and data packet codecs ([Vol 4] Part E).
//
// Builds the commands a Host sends as ready-to-transmit H4 frames, and reads the packets a Controller sends.
// The readers cover the event header, the Command Complete and Command Status events, every LE Meta subevent
// the stack uses, the return parameters of commands that answer with more than Status, and the ACL and ISO
// data packets.
//
// A reader takes the packet without its H4 type byte.  It answers `None` for a packet of another kind and for
// one whose length is not the length its fields add up to: a short buffer never gives a partial value.  The
// scalar readers (`event_code`, `event_param_len`, `command_complete_opcode`, ...) answer -1 instead.  A
// Connection_Handle is 12 bits meaningful and is masked to them.  The builders are in `hci_commands`; the type
// byte is `hci_h4`'s.

use hci_frame
use hci_commands
use hci_h4
use hci_buf

// ── Build a complete HCI Command PDU (no H4 prefix) ─────────────────
//
// Returns: opcode_lo | opcode_hi | param_len | params[0..param_len]
//
// Caller then calls `frame_h4(PKT_COMMAND, cmd_bytes)` to get
// the UART-wire bytes.

// The HCI Command packet for `opcode` and `params`, without an H4 type byte: the opcode (2 octets, little-endian), the
// parameter length (1 octet) and the parameters ([Vol 4] Part E, Section 5.4.1).
//
// `params` must not exceed 255 octets.  `hci_h4.frame_h4(hci_h4.PKT_COMMAND, ...)` adds the type byte;
// `build_h4_command` does both.
pub @satisfies("REQ-BLE-HCI-001")
@tier(embedded)
fn build_command(opcode: Int, params: [u8]) -> [u8]
    var out = hci_buf.buf(3 + list.len(params))
    hci_buf.put16(var out, opcode)
    hci_buf.put8(var out, list.len(params))
    hci_buf.put_bytes(var out, params)
    out

// The H4 frame of the command `opcode` with `params`: the type byte 0x01, then the packet `build_command` builds.
//
// The bytes are ready to write to a UART or a USB transport.
pub @satisfies("REQ-BLE-H4-001")
@tier(embedded)
fn build_h4_command(opcode: Int, params: [u8]) -> [u8]
    var out = hci_buf.buf(4 + list.len(params))
    hci_buf.put8(var out, hci_h4.PKT_COMMAND)
    hci_buf.put16(var out, opcode)
    hci_buf.put8(var out, list.len(params))
    hci_buf.put_bytes(var out, params)
    out

// ── Command builders for the supported subset ───────────────────────
//
// Each returns H4-framed wire bytes ready to push into the
// UART transport.  The opcodes come from hci_commands; the
// builders here package them with their parameter bytes.

// The H4 frame of HCI_Reset, `01 03 0C 00` ([Vol 4] Part E, Section 7.3.2).
pub @satisfies("REQ-BLE-HCI-004")
@tier(embedded)
fn cmd_hci_reset() -> [u8]
    build_h4_command(hci_commands.opcode_hci_reset(), hci_buf.empty())

// The H4 frame of Read BD_ADDR, which has no parameters ([Vol 4] Part E, Section 7.4.6).
pub @satisfies("REQ-BLE-HCI-005")
@tier(embedded)
fn cmd_read_bd_addr() -> [u8]
    build_h4_command(hci_commands.opcode_read_bd_addr(), hci_buf.empty())

// The H4 frame of LE Read Buffer Size, which has no parameters ([Vol 4] Part E, Section 7.8.2).
pub @satisfies("REQ-BLE-HCI-011")
@satisfies("REQ-BLE-LL-066")
@tier(embedded)
fn cmd_le_read_buffer_size() -> [u8]
    build_h4_command(hci_commands.opcode_le_read_buffer_size(), hci_buf.empty())

// The H4 frame of LE Read Local Supported Features, which has no parameters ([Vol 4] Part E, Section 7.8.3).
pub @satisfies("REQ-BLE-HCI-012")
@tier(embedded)
fn cmd_le_read_local_supported_features() -> [u8]
    build_h4_command(hci_commands.opcode_le_read_local_supported_features(), hci_buf.empty())

// The H4 frame of LE Set Random Address for the six octets `bd_addr`, least significant octet first ([Vol 4] Part E,
// Section 7.8.4).
//
// A list of any other length is sent as given and the Controller rejects the command.
pub @satisfies("REQ-BLE-HCI-013")
@tier(embedded)
fn cmd_le_set_random_address(bd_addr: [u8]) -> [u8]
    // bd_addr must be 6 bytes; shorter ones produce an
    // under-length command that the controller rejects.
    build_h4_command(hci_commands.opcode_le_set_random_address(), bd_addr)

// The H4 frame of LE Set Advertising Data with `ad` as its parameters ([Vol 4] Part E, Section 7.8.7).
//
// `ad` is the whole 32-octet parameter block: the length octet and the 31-octet data field padded with zeros.  It is sent as
// given; `hci_commands.build_le_adv_data_block` builds it from the advertising data.
pub @satisfies("REQ-BLE-HCI-016")
@tier(embedded)
fn cmd_le_set_advertising_data(ad: [u8]) -> [u8]
    // LE_Set_Advertising_Data parameters: 1-byte length +
    // 31-byte data field.  Pad with zeros if ad < 31 bytes.
    // Passes the raw ad through; assumes the caller
    // already prepared a 32-byte block with the length prefix.
    build_h4_command(hci_commands.opcode_le_set_advertising_data(), ad)

// The H4 frame of LE Set Scan Response Data with `data` as its parameters ([Vol 4] Part E, Section 7.8.8).
//
// `data` is the whole 32-octet parameter block, as for `cmd_le_set_advertising_data`.
pub @satisfies("REQ-BLE-HCI-017")
@tier(embedded)
fn cmd_le_set_scan_response_data(data: [u8]) -> [u8]
    build_h4_command(hci_commands.opcode_le_set_scan_response_data(), data)

// The H4 frame of LE Set Advertising Enable: `true` starts advertising and `false` stops it ([Vol 4] Part E, Section 7.8.9).
pub @satisfies("REQ-BLE-HCI-018")
@tier(embedded)
fn cmd_le_set_advertising_enable(enable: Bool) -> [u8]
    let param = hci_commands.build_le_set_advertising_enable(enable)
    build_h4_command(hci_commands.opcode_le_set_advertising_enable(), param)

// ── Parse an incoming HCI Event PDU ─────────────────────────────────
//
// Takes raw event bytes (without the H4 0x04 prefix) and
// returns the event code in the first byte.  Caller dispatches
// on the code and reads subsequent bytes as params.  Returns
// -1 if the buffer is too short.

// The event code of the HCI Event packet `evt`, its first octet, or -1 when `evt` is empty.
//
// `evt` is the packet without the H4 type byte.  Compare the answer with the `EVT_*` constants of `hci_frame`.
pub @satisfies("REQ-BLE-HCI-002")
@tier(embedded)
@no_alloc
fn event_code(evt: [u8]) -> Int
    if list.len(evt) < 1
        -1
    else
        evt[0] as Int

// The Parameter_Total_Length of the HCI Event packet `evt`, its second octet, or -1 when `evt` holds fewer than two octets.
pub @satisfies("REQ-BLE-HCI-002")
@tier(embedded)
@no_alloc
fn event_param_len(evt: [u8]) -> Int
    if list.len(evt) < 2
        -1
    else
        evt[1] as Int

// ── Command Complete event shape (Vol 4 Part E §7.7.14) ─────────────
//
//   evt[0] = 0x0E (Command_Complete code)
//   evt[1] = param_len (≥ 3)
//   evt[2] = Num_HCI_Command_Packets (controller's current
//            available slot count)
//   evt[3] = opcode_lo
//   evt[4] = opcode_hi
//   evt[5..] = Return_Parameters (varies per command)

// Whether `evt` is a Command Complete event ([Vol 4] Part E, Section 7.7.14).
//
// Its layout is the event code 0x0E, Parameter_Total_Length, Num_HCI_Command_Packets, the opcode (2 octets) and the return
// parameters, which begin with Status.
pub @satisfies("REQ-BLE-HCI-003")
@tier(embedded)
@no_alloc
fn is_command_complete(evt: [u8]) -> Bool
    event_code(evt) == hci_frame.EVT_COMMAND_COMPLETE

// The opcode a Command Complete event answers, or -1 when `evt` holds fewer than five octets.
//
// The answer is the opcode of whatever `evt` holds at octets 3 and 4; `is_command_complete` tells whether `evt` is a Command
// Complete event.
pub @satisfies("REQ-BLE-HCI-003")
@tier(embedded)
@no_alloc
fn command_complete_opcode(evt: [u8]) -> Int
    if list.len(evt) < 5
        -1
    else
        // Opcode is at bytes [3..4] LE.
        evt[3] as Int | (evt[4] as Int << 8)

// The Status return parameter of a Command Complete event, evt[5].
// Status is the first return parameter and is always present, even
// when the command fails ([Vol 4] Part E, Section 4.5).  -1 when the event carries no return parameters.
pub @satisfies("REQ-BLE-HCI-003")
@tier(embedded)
@no_alloc
fn command_complete_status(evt: [u8]) -> Int
    if list.len(evt) < 6
        -1
    else
        evt[5] as Int

// ── Command Status event, [Vol 4] Part E, Section 7.7.15 ────────────
//
//   evt[0] = 0x0F (Command_Status code)
//   evt[1] = param_len (4)
//   evt[2] = Status
//   evt[3] = Num_HCI_Command_Packets
//   evt[4] = opcode_lo
//   evt[5] = opcode_hi

// Whether `evt` is a Command Status event ([Vol 4] Part E, Section 7.7.15).
//
// Its layout is the event code 0x0F, Parameter_Total_Length 4, Status, Num_HCI_Command_Packets and the opcode (2 octets).
pub @tier(embedded)
@no_alloc
fn is_command_status(evt: [u8]) -> Bool
    event_code(evt) == hci_frame.EVT_COMMAND_STATUS

// The opcode a Command Status event answers, or -1 when `evt` holds fewer than six octets.
pub @tier(embedded)
@no_alloc
fn command_status_opcode(evt: [u8]) -> Int
    if list.len(evt) < 6
        -1
    else
        evt[4] as Int | (evt[5] as Int << 8)

// The Status of a Command Status event, its third octet, or -1 when `evt` holds fewer than three octets.
pub @tier(embedded)
@no_alloc
fn command_status_status(evt: [u8]) -> Int
    if list.len(evt) < 3
        -1
    else
        evt[2] as Int

// The opcode a Command Complete or Command Status event answers,
// or -1 for any other event.
pub @satisfies("REQ-BLE-HCI-003")
@tier(embedded)
@no_alloc
fn answered_opcode(evt: [u8]) -> Int
    if is_command_complete(evt)
        command_complete_opcode(evt)
    else if is_command_status(evt)
        command_status_opcode(evt)
    else
        -1

// The Status a Command Complete or Command Status event reports,
// or -1 for any other event.
pub @tier(embedded)
@no_alloc
fn answered_status(evt: [u8]) -> Int
    if is_command_complete(evt)
        command_complete_status(evt)
    else if is_command_status(evt)
        command_status_status(evt)
    else
        -1

// The Subevent_Code of an LE Meta event ([Vol 4] Part E,
// Section 7.7.65), evt[2], or -1 for any other event.
pub @tier(embedded)
@no_alloc
fn le_meta_subevent(evt: [u8]) -> Int
    if event_code(evt) != hci_frame.EVT_LE_META_EVENT or list.len(evt) < 3
        -1
    else
        evt[2] as Int

// An LE Meta event packet of subevent `subevent` with the parameter octets `params`, without the H4 type byte: the event
// code 0x3E, the Parameter_Total_Length, the Subevent_Code and the parameters ([Vol 4] Part E, Section 7.7.65).
//
// It is the packet a Controller sends, so a test uses it to feed the readers below.  `params` must not exceed 254 octets.
pub @tier(app)
fn le_meta_event(subevent: Int, params: [u8]) -> [u8]
    var evt: [u8] = [0x3E, (list.len(params) + 1) as u8, subevent as u8]
    list.append(evt, params)
    evt

// ── LE Advertising Report event, [Vol 4] Part E, Section 7.7.65.2 ───
//
//   evt[0] = 0x3E (LE Meta event)
//   evt[1] = Parameter_Total_Length
//   evt[2] = 0x02 (Subevent_Code)
//   evt[3] = Num_Reports, 0x01 to 0x19
//   then, report by report, Event_Type, Address_Type, Address (6),
//   Data_Length, Data, RSSI
//
// Arrayed parameters are sent element by element
// ([Vol 4] Part E, Section 5.2): Event_Type[0], Address_Type[0], ...
// RSSI[0], then Event_Type[1], and so on.

// Subevent_Code 0x02 of the LE Advertising Report event ([Vol 4] Part E, Section 7.7.65.2).
pub const LE_SUBEVENT_ADVERTISING_REPORT = 0x02

// Event_Type values: the legacy advertising PDU the report carries.
pub const ADV_REPORT_ADV_IND = 0x00

// Event_Type 0x01 of an advertising report: ADV_DIRECT_IND, connectable directed advertising.
pub const ADV_REPORT_ADV_DIRECT_IND = 0x01

// Event_Type 0x02 of an advertising report: ADV_SCAN_IND, scannable undirected advertising.
pub const ADV_REPORT_ADV_SCAN_IND = 0x02

// Event_Type 0x03 of an advertising report: ADV_NONCONN_IND, non-connectable and non-scannable undirected advertising.
pub const ADV_REPORT_ADV_NONCONN_IND = 0x03

// Event_Type 0x04 of an advertising report: SCAN_RSP, a scan response.
pub const ADV_REPORT_SCAN_RSP = 0x04

// RSSI 0x7F: RSSI is not available.
pub const ADV_REPORT_RSSI_NOT_AVAILABLE = 0x7F

// Data_Length is 0x00 to 0x1F.
pub const ADV_REPORT_DATA_MAX = 31

// One report of an LE Advertising Report event.  `address` is the
// six octets as the event carries them, least significant first;
// `data` is advertising or scan response data formatted as AD
// structures ([Vol 3] Part C, Section 11); `rssi` is the RSSI octet,
// a signed dBm value or ADV_REPORT_RSSI_NOT_AVAILABLE.
pub struct AdvertisingReport
    event_type: Int
    address_type: Int
    address: [u8]
    data: [u8]
    rssi: Int

// The reports of an LE Advertising Report event, given without its HCI
// packet indicator, or None when the event is another one or its
// parameters do not add up: a Num_Reports outside 1 to 0x19, a
// Data_Length over 31, or a length that disagrees with
// Parameter_Total_Length.
pub @tier(embedded)
fn le_advertising_reports(evt: [u8]) -> ?[AdvertisingReport]
    let n = list.len(evt)
    if le_meta_subevent(evt) != LE_SUBEVENT_ADVERTISING_REPORT or n < 4
        return None
    if (evt[1] as Int) != n - 2
        return None
    let count = evt[3] as Int
    if count < 1 or count > 0x19
        return None
    // The reports are records with byte payloads, so they are boxed: the list and each record are explicit
    // allocations, one block each, bounded by the 0x19 reports of the event.
    system
        var reports: [AdvertisingReport] = list.with_capacity(count)
        var at = 4
        for _ in 0..count
            // Event_Type, Address_Type, Address and Data_Length: 9 octets.
            if at + 9 > n
                return None
            let data_len = evt[at + 8] as Int
            if data_len > ADV_REPORT_DATA_MAX or at + 9 + data_len + 1 > n
                return None
            let data_end = at + 9 + data_len
            let _ = list.try_push(reports, AdvertisingReport {
                event_type: evt[at] as Int,
                address_type: evt[at + 1] as Int,
                address: hci_buf.slice(evt, at + 2, at + 8),
                data: hci_buf.slice(evt, at + 9, data_end),
                rssi: evt[data_end] as Int })
            at = data_end + 1
        if at != n
            return None
        Some(reports)

// ── LE Connection Complete event, [Vol 4] Part E, Section 7.7.65.1 ──
//
//   evt[0] = 0x3E (LE Meta event)
//   evt[1] = Parameter_Total_Length, 19
//   evt[2] = 0x01 (Subevent_Code)
//   then Status, Connection_Handle (2), Role, Peer_Address_Type,
//   Peer_Address (6), Connection_Interval (2), Peripheral_Latency (2),
//   Supervision_Timeout (2), Central_Clock_Accuracy
//
// The LE Enhanced Connection Complete event [v1] (Section 7.7.65.10,
// Subevent_Code 0x0A) carries Local_Resolvable_Private_Address and
// Peer_Resolvable_Private_Address, 6 octets each, after Peer_Address;
// the rest is the same.  A Controller sends one of the two, the enhanced
// one only when the Host unmasks it.

// Subevent_Code 0x01 of the LE Connection Complete event ([Vol 4] Part E, Section 7.7.65.1).
//
// Its layout is Status, Connection_Handle (2), Role, Peer_Address_Type, Peer_Address (6), Connection_Interval (2),
// Peripheral_Latency (2), Supervision_Timeout (2) and Central_Clock_Accuracy.
pub const LE_SUBEVENT_CONNECTION_COMPLETE = 0x01

// Subevent_Code 0x0A of the LE Enhanced Connection Complete event [v1] ([Vol 4] Part E, Section 7.7.65.10).
//
// It carries Local_Resolvable_Private_Address and Peer_Resolvable_Private_Address, 6 octets each, after Peer_Address; the rest is the
// layout of the LE Connection Complete event.  A Controller sends the enhanced event only when the Host unmasks it.
pub const LE_SUBEVENT_ENHANCED_CONNECTION_COMPLETE = 0x0A

// Role: the Controller is the Central or the Peripheral of the new
// connection.
pub const CONNECTION_ROLE_CENTRAL = 0x00

// Role 0x01: the Controller is the Peripheral of the new connection.
pub const CONNECTION_ROLE_PERIPHERAL = 0x01

// Status Advertising Timeout (0x3C): high duty cycle directed
// advertising ended without a connection ([Vol 4] Part E, Section
// 7.8.9).
pub const STATUS_ADVERTISING_TIMEOUT = 0x3C

// The parameters of an LE Connection Complete event or LE Enhanced
// Connection Complete event [v1].  `peer_address` is least significant
// octet first; the three timing values are in the units the event gives
// them.
pub struct LeConnectionComplete
    status: Int
    connection_handle: Int
    role: Int
    peer_address_type: Int
    peer_address: [u8]
    connection_interval: Int
    peripheral_latency: Int
    supervision_timeout: Int

@tier(embedded)
@no_alloc
fn le16_at(evt: [u8], at: Int) -> Int
    evt[at] as Int | (evt[at + 1] as Int << 8)

// A 24-bit and a 32-bit field, least significant octet first.
@tier(embedded)
@no_alloc
fn le24_at(evt: [u8], at: Int) -> Int
    evt[at] as Int | (evt[at + 1] as Int << 8) | (evt[at + 2] as Int << 16)

@tier(embedded)
@no_alloc
fn le32_at(evt: [u8], at: Int) -> Int
    evt[at] as Int | (evt[at + 1] as Int << 8) | (evt[at + 2] as Int << 16) | (evt[at + 3] as Int << 24)

// The parameters of an LE Connection Complete event or LE Enhanced
// Connection Complete event [v1], given without its HCI packet
// indicator, or None for any other event or one whose length is not its
// subevent's.
pub @tier(embedded)
fn le_connection_complete(evt: [u8]) -> ?LeConnectionComplete
    let sub = le_meta_subevent(evt)
    let n = list.len(evt)
    // Octets between Peer_Address and Connection_Interval.
    let skip = if sub == LE_SUBEVENT_ENHANCED_CONNECTION_COMPLETE
        12
    else
        0
    if sub != LE_SUBEVENT_CONNECTION_COMPLETE and sub != LE_SUBEVENT_ENHANCED_CONNECTION_COMPLETE
        return None
    if n != 21 + skip or (evt[1] as Int) != n - 2
        return None
    let t = 13 + skip
    system
        Some(LeConnectionComplete {
            status: evt[3] as Int,
            connection_handle: le16_at(evt, 4) & 0x0FFF,
            role: evt[6] as Int,
            peer_address_type: evt[7] as Int,
            peer_address: hci_buf.slice(evt, 8, 14),
            connection_interval: le16_at(evt, t + 1),
            peripheral_latency: le16_at(evt, t + 3),
            supervision_timeout: le16_at(evt, t + 5) })

// ── Disconnection Complete event, [Vol 4] Part E, Section 7.7.5 ─────
//
//   evt[0] = 0x05, evt[1] = 4, then Status, Connection_Handle (2),
//   Reason

// The parameters of a Disconnection Complete event ([Vol 4] Part E, Section 7.7.5): `status`, the 12-bit `connection_handle`
// and the `reason` for the disconnection.
pub @value
struct DisconnectionComplete
    status: Int
    connection_handle: Int
    reason: Int

// The parameters of a Disconnection Complete event, given without its
// HCI packet indicator, or None for any other event.
pub @tier(embedded)
fn disconnection_complete(evt: [u8]) -> ?DisconnectionComplete
    if event_code(evt) != hci_frame.EVT_DISCONNECTION_COMPLETE or list.len(evt) != 6 or (evt[1] as Int) != 4
        None
    else
        Some(DisconnectionComplete {
            status: evt[2] as Int,
            connection_handle: le16_at(evt, 3) & 0x0FFF,
            reason: evt[5] as Int })

// ── HCI ACL Data packets, [Vol 4] Part E, Section 5.4.2 ─────────────
//
//   octets 0-1  Handle (12 bits), Packet_Boundary_Flag (bits 4-5 of
//               octet 1), Broadcast_Flag (bits 6-7 of octet 1)
//   octets 2-3  Data_Total_Length
//   then        Data_Total_Length octets of data
//
// On an LE-U logical link the Host starts an L2CAP PDU with
// Packet_Boundary_Flag 0b00 and continues it with 0b01; the Controller
// starts one with 0b10 and continues it with 0b01.  Broadcast_Flag is
// 0b00, point-to-point.

// Packet_Boundary_Flag 0b00: the first fragment of an L2CAP PDU that is not automatically flushable; the value a Host starts an
// L2CAP PDU with on an LE-U logical link.
pub const ACL_PB_FIRST_NON_FLUSHABLE = 0x00

// Packet_Boundary_Flag 0b01: a continuing fragment of an L2CAP PDU.
pub const ACL_PB_CONTINUING = 0x01

// Packet_Boundary_Flag 0b10: the first, automatically flushable, fragment of an L2CAP PDU; the value a Controller starts an
// L2CAP PDU with on an LE-U logical link.
pub const ACL_PB_FIRST_FLUSHABLE = 0x02

// The length of the HCI ACL Data packet header in octets, 4: the handle and flags (2) and Data_Total_Length (2).
pub const ACL_HEADER_LEN = 4

// Hosts and Controllers shall be able to accept HCI ACL Data packets
// with up to 27 octets of data on an LE-U logical link (same section).
pub const LE_ACL_DATA_MIN = 27

// One HCI ACL Data packet: the header fields and the data.
pub struct AclDataPacket
    connection_handle: Int
    packet_boundary: Int
    broadcast: Int
    data: [u8]

// The HCI ACL Data packet `pkt`, given without its HCI packet indicator,
// or None when it is shorter than its header or Data_Total_Length
// disagrees with the octets that follow.
pub @tier(embedded)
fn acl_data_packet(pkt: [u8]) -> ?AclDataPacket
    let n = list.len(pkt)
    if n < ACL_HEADER_LEN
        return None
    let total = le16_at(pkt, 2)
    if n != ACL_HEADER_LEN + total
        return None
    system
        Some(AclDataPacket {
            connection_handle: le16_at(pkt, 0) & 0x0FFF,
            packet_boundary: (pkt[1] as Int >>> 4) & 0x03,
            broadcast: (pkt[1] as Int >>> 6) & 0x03,
            data: hci_buf.slice(pkt, ACL_HEADER_LEN, n) })

// An HCI ACL Data packet with its HCI packet indicator, point-to-point,
// for `connection_handle` with `packet_boundary` and `data`.
pub @tier(embedded)
fn build_h4_acl(connection_handle: Int, packet_boundary: Int, data: [u8]) -> [u8]
    let n = list.len(data)
    var pkt = hci_buf.buf(5 + n)
    hci_buf.put8(var pkt, hci_h4.PKT_ACL)
    hci_buf.put8(var pkt, connection_handle)
    hci_buf.put8(var pkt, ((connection_handle >>> 8) & 0x0F) | ((packet_boundary & 0x03) << 4))
    hci_buf.put16(var pkt, n)
    hci_buf.put_bytes(var pkt, data)
    pkt

// ── Number Of Completed Packets event, [Vol 4] Part E, Section 7.7.19 ─
//
//   evt[0] = 0x13, evt[1] = Parameter_Total_Length, evt[2] = Num_Handles,
//   then Handle[i] (2) and Num_Completed_Packets[i] (2), element by
//   element: Handle[0], Num_Completed_Packets[0], Handle[1], ...
//   ([Vol 4] Part E, Section 5.2).

// The packets one Handle has completed since the last event.
pub @value
struct CompletedPackets
    connection_handle: Int
    count: Int

// The pairs of a Number Of Completed Packets event, given without its
// HCI packet indicator, or None for any other event or one whose length
// disagrees with Num_Handles.
pub @tier(embedded)
fn number_of_completed_packets(evt: [u8]) -> ?[CompletedPackets]
    let n = list.len(evt)
    if event_code(evt) != hci_frame.EVT_NUMBER_OF_COMPLETED_PACKETS or n < 3
        return None
    let count = evt[2] as Int
    if (evt[1] as Int) != n - 2 or n != 3 + 4 * count
        return None
    var out: [CompletedPackets] = list.with_capacity(count)
    for i in 0..count
        let at = 3 + 4 * i
        let _ = list.try_push(out, CompletedPackets { connection_handle: le16_at(evt, at) & 0x0FFF,
            count: le16_at(evt, at + 2) })
    Some(out)

// ── LE Connection Update Complete event, [Vol 4] Part E, Section 7.7.65.3
//
//   evt[0] = 0x3E, evt[1] = 10, evt[2] = 0x03, then Status,
//   Connection_Handle (2), Connection_Interval (2), Peripheral_Latency
//   (2), Supervision_Timeout (2)

// Subevent_Code 0x03 of the LE Connection Update Complete event ([Vol 4] Part E, Section 7.7.65.3).
pub const LE_SUBEVENT_CONNECTION_UPDATE_COMPLETE = 0x03

// The parameters of an LE Connection Update Complete event.
//
// `status` is 0 for success.  `connection_interval` is in 1.25 ms units, `peripheral_latency` in connection events and
// `supervision_timeout` in 10 ms units.
pub @value
struct LeConnectionUpdateComplete
    status: Int
    connection_handle: Int
    connection_interval: Int
    peripheral_latency: Int
    supervision_timeout: Int

// The parameters of an LE Connection Update Complete event, given without its HCI packet indicator, or None for any other event
// or one whose length is not the event's 12 octets.
pub @tier(embedded)
fn le_connection_update_complete(evt: [u8]) -> ?LeConnectionUpdateComplete
    if le_meta_subevent(evt) != LE_SUBEVENT_CONNECTION_UPDATE_COMPLETE or list.len(evt) != 12 or (evt[1] as Int) != 10
        None
    else
        Some(LeConnectionUpdateComplete {
            status: evt[3] as Int,
            connection_handle: le16_at(evt, 4) & 0x0FFF,
            connection_interval: le16_at(evt, 6),
            peripheral_latency: le16_at(evt, 8),
            supervision_timeout: le16_at(evt, 10) })

// ── LE Long Term Key Request event, [Vol 4] Part E, Section 7.7.65.5 ─
//
//   evt[0] = 0x3E, evt[1] = 13, evt[2] = 0x05, then Connection_Handle
//   (2), Random_Number (8), Encrypted_Diversifier (2)

// Subevent_Code 0x05 of the LE Long Term Key Request event ([Vol 4] Part E, Section 7.7.65.5).
pub const LE_SUBEVENT_LONG_TERM_KEY_REQUEST = 0x05

// The parameters of an LE Long Term Key Request event: the 12-bit `connection_handle`, the 8-octet `random_number` and the
// `encrypted_diversifier`, which name the key the Controller asks the Host for.
pub struct LeLongTermKeyRequest
    connection_handle: Int
    random_number: [u8]
    encrypted_diversifier: Int

// The parameters of an LE Long Term Key Request event, given without its HCI packet indicator, or None for any other event or one
// whose length is not the event's 15 octets.
pub @tier(embedded)
fn le_long_term_key_request(evt: [u8]) -> ?LeLongTermKeyRequest
    if le_meta_subevent(evt) != LE_SUBEVENT_LONG_TERM_KEY_REQUEST or list.len(evt) != 15 or (evt[1] as Int) != 13
        None
    else
        system
            Some(LeLongTermKeyRequest {
                connection_handle: le16_at(evt, 3) & 0x0FFF,
                random_number: hci_buf.slice(evt, 5, 13),
                encrypted_diversifier: le16_at(evt, 13) })

// ── LE Remote Connection Parameter Request event, [Vol 4] Part E,
//    Section 7.7.65.6
//
//   evt[0] = 0x3E, evt[1] = 11, evt[2] = 0x06, then Connection_Handle
//   (2), Interval_Min (2), Interval_Max (2), Max_Latency (2), Timeout (2)

// Subevent_Code 0x06 of the LE Remote Connection Parameter Request event ([Vol 4] Part E, Section 7.7.65.6).
pub const LE_SUBEVENT_REMOTE_CONNECTION_PARAMETER_REQUEST = 0x06

// The parameters of an LE Remote Connection Parameter Request event: the 12-bit `connection_handle` and the peer's requested
// `interval_min` and `interval_max` (1.25 ms units), `max_latency` (connection events) and `timeout` (10 ms units).
pub @value
struct LeRemoteConnectionParameterRequest
    connection_handle: Int
    interval_min: Int
    interval_max: Int
    max_latency: Int
    timeout: Int

// The parameters of an LE Remote Connection Parameter Request event, given without its HCI packet indicator, or None for any
// other event or one whose length is not the event's 13 octets.
pub @tier(embedded)
fn le_remote_connection_parameter_request(evt: [u8]) -> ?LeRemoteConnectionParameterRequest
    if le_meta_subevent(evt) != LE_SUBEVENT_REMOTE_CONNECTION_PARAMETER_REQUEST or list.len(evt) != 13 or (evt[1] as Int) != 11
        None
    else
        Some(LeRemoteConnectionParameterRequest {
            connection_handle: le16_at(evt, 3) & 0x0FFF,
            interval_min: le16_at(evt, 5),
            interval_max: le16_at(evt, 7),
            max_latency: le16_at(evt, 9),
            timeout: le16_at(evt, 11) })

// ── Encryption Change event, [Vol 4] Part E, Section 7.7.8 ──────────
//
// The event code of the Encryption Change event [v1] and of the
// Encryption Key Refresh Complete event (Section 7.7.39), which the
// Security Manager reads; the Host hands both to it unread.

// Event code 0x30 of the Encryption Key Refresh Complete event ([Vol 4] Part E, Section 7.7.39).
pub const EVT_ENCRYPTION_KEY_REFRESH_COMPLETE = 0x30

// Whether `evt` is one of the events that report a change of the link's
// encryption to the Host: Encryption Change, Encryption Key Refresh
// Complete, or the LE Long Term Key Request event that asks the Host for
// a key.
pub @tier(embedded)
@no_alloc
fn is_encryption_event(evt: [u8]) -> Bool
    let code = event_code(evt)
    code == hci_frame.EVT_ENCRYPTION_CHANGE or code == EVT_ENCRYPTION_KEY_REFRESH_COMPLETE or le_meta_subevent(evt) == LE_SUBEVENT_LONG_TERM_KEY_REQUEST

// The outcome of an encryption change on a connection: the Encryption
// Change event [v1] (Section 7.7.8: Status, Connection_Handle,
// Encryption_Enabled) or the Encryption Key Refresh Complete event
// (Section 7.7.39: Status, Connection_Handle), which reports a link that
// stays encrypted with a new key.  `enabled` is true when the link is
// encrypted after the change: a Status of Success with
// Encryption_Enabled not 0x00, or a refresh with Status Success.
pub @value
struct EncryptionChange
    status: Int
    connection_handle: Int
    enabled: Bool

// The outcome of the encryption change `evt` reports, or None for any other event or one of the wrong length.
//
// `evt` is an Encryption Change event [v1] (6 octets) or an Encryption Key Refresh Complete event (5 octets), given without the
// HCI packet indicator.
pub @tier(embedded)
fn encryption_change(evt: [u8]) -> ?EncryptionChange
    let code = event_code(evt)
    if code == hci_frame.EVT_ENCRYPTION_CHANGE and list.len(evt) == 6 and (evt[1] as Int) == 4
        let status = evt[2] as Int
        Some(EncryptionChange { status: status,
            connection_handle: le16_at(evt, 3) & 0x0FFF,
            enabled: status == 0 and (evt[5] as Int) != 0 })
    else if code == EVT_ENCRYPTION_KEY_REFRESH_COMPLETE and list.len(evt) == 5 and (evt[1] as Int) == 3
        let status = evt[2] as Int
        Some(EncryptionChange { status: status,
            connection_handle: le16_at(evt, 3) & 0x0FFF,
            enabled: status == 0 })
    else
        None

// The LE_ACL_Data_Packet_Length and Total_Num_LE_ACL_Data_Packets of the
// LE Read Buffer Size command [v1] ([Vol 4] Part E, Section 7.8.2), from
// the return parameters that follow Status.
pub @value
struct LeBufferSize
    acl_data_packet_length: Int
    total_acl_data_packets: Int

// The buffer sizes of the LE Read Buffer Size command [v1], from `return_parameters`, the octets after Status (see
// `command_complete_return_parameters`), or None when fewer than three octets are given.
pub @tier(embedded)
fn le_buffer_size(return_parameters: [u8]) -> ?LeBufferSize
    if list.len(return_parameters) < 3
        None
    else
        Some(LeBufferSize {
            acl_data_packet_length: le16_at(return_parameters, 0),
            total_acl_data_packets: return_parameters[2] as Int })

// ── Return parameters of the isochronous commands ───────────────────
//
// The return parameters of a Command Complete event follow Status, so
// each decoder takes the octets after it (`command_complete_return_parameters`
// cuts them off the event), as `le_buffer_size` does.  A list whose length
// is not the one the command's return parameters have is refused: their
// sizes are fixed ([Vol 4] Part E, Section 7.8.2 and Sections 7.8.96 to
// 7.8.116), except the list of Connection_Handle[i] of the LE Set CIG
// Parameters command, whose length follows CIS_Count.

// The return parameters of a Command Complete event, the octets after
// Status, or an empty list when the event is shorter than the opcode and
// Status.
pub @tier(embedded)
fn command_complete_return_parameters(evt: [u8]) -> [u8]
    if list.len(evt) < 6
        hci_buf.empty()
    else
        hci_buf.slice(evt, 6, list.len(evt))

// The return parameters of the LE Read Buffer Size command [v2]
// ([Vol 4] Part E, Section 7.8.2): the ACL half of the [v1] form, then
// ISO_Data_Packet_Length and Total_Num_ISO_Data_Packets.  Both ISO values
// are non-zero on a Controller that supports HCI ISO Data packets.
pub @value
struct LeBufferSizeV2
    acl_data_packet_length: Int
    total_acl_data_packets: Int
    iso_data_packet_length: Int
    total_iso_data_packets: Int

// The buffer sizes of the LE Read Buffer Size command [v2], from `return_parameters`, the octets after Status, or None when they
// are not exactly 6 octets.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn le_buffer_size_v2(return_parameters: [u8]) -> ?LeBufferSizeV2
    if list.len(return_parameters) != 6
        None
    else
        Some(LeBufferSizeV2 {
            acl_data_packet_length: le16_at(return_parameters, 0),
            total_acl_data_packets: return_parameters[2] as Int,
            iso_data_packet_length: le16_at(return_parameters, 3),
            total_iso_data_packets: return_parameters[5] as Int })

// The return parameters of the LE Read ISO TX Sync command ([Vol 4] Part
// E, Section 7.8.96): Connection_Handle, Packet_Sequence_Number,
// TX_Time_Stamp (microseconds) and Time_Offset (microseconds, 3 octets).
pub @value
struct IsoTxSync
    connection_handle: Int
    packet_sequence_number: Int
    tx_time_stamp: Int
    time_offset: Int

// The return parameters of LE Read ISO TX Sync, from the octets after Status, or None when they are not exactly 11 octets.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn le_read_iso_tx_sync(return_parameters: [u8]) -> ?IsoTxSync
    if list.len(return_parameters) != 11
        None
    else
        Some(IsoTxSync {
            connection_handle: le16_at(return_parameters, 0) & 0x0FFF,
            packet_sequence_number: le16_at(return_parameters, 2),
            tx_time_stamp: le32_at(return_parameters, 4),
            time_offset: le24_at(return_parameters, 8) })

// The return parameters of the LE Set CIG Parameters command and its
// Test form ([Vol 4] Part E, Sections 7.8.97 and 7.8.98): CIG_ID,
// CIS_Count and Connection_Handle[i], one handle for each CIS of the
// command, in the order of its CIS_ID[i].
pub struct CigParametersReturn
    cig_id: Int
    connection_handles: [Int]

// The return parameters of LE Set CIG Parameters or its Test form, from the octets after Status, or None when the list is shorter
// than two octets or its length disagrees with CIS_Count.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn le_set_cig_parameters_return(return_parameters: [u8]) -> ?CigParametersReturn
    if list.len(return_parameters) < 2
        return None
    let n = return_parameters[1] as Int
    if list.len(return_parameters) != 2 + 2 * n
        return None
    // The handles are a list of `Int` and the record holds a list, so both are boxed: the explicit allocations of the reader.
    system
        var handles: [Int] = list.with_capacity(n)
        for i in 0..n
            let _ = list.try_push(handles, le16_at(return_parameters, 2 + 2 * i) & 0x0FFF)
        Some(CigParametersReturn { cig_id: return_parameters[0] as Int, connection_handles: handles })

// The Connection_Handle that the LE Reject CIS Request, LE Setup ISO
// Data Path, LE Remove ISO Data Path, LE ISO Transmit Test and LE ISO
// Receive Test commands return after Status ([Vol 4] Part E, Sections
// 7.8.102 and 7.8.109 to 7.8.112), or None when the list is not two
// octets.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn iso_connection_handle_return(return_parameters: [u8]) -> ?Int
    if list.len(return_parameters) != 2
        None
    else
        Some(le16_at(return_parameters, 0) & 0x0FFF)

// The CIG_ID that the LE Remove CIG command returns after Status, and
// the BIG_Handle that the LE BIG Terminate Sync command returns after it
// ([Vol 4] Part E, Sections 7.8.100 and 7.8.107): one octet.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn iso_group_id_return(return_parameters: [u8]) -> ?Int
    if list.len(return_parameters) != 1
        None
    else
        Some(return_parameters[0] as Int)

// The return parameters of the LE ISO Read Test Counters and LE ISO Test
// End commands ([Vol 4] Part E, Sections 7.8.113 and 7.8.114):
// Connection_Handle and the three 4-octet counts.
pub @value
struct IsoTestCounters
    connection_handle: Int
    received_sdu_count: Int
    missed_sdu_count: Int
    failed_sdu_count: Int

// The return parameters of LE ISO Read Test Counters or LE ISO Test End, from the octets after Status, or None when they are not
// exactly 14 octets.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn iso_test_counters(return_parameters: [u8]) -> ?IsoTestCounters
    if list.len(return_parameters) != 14
        None
    else
        Some(IsoTestCounters {
            connection_handle: le16_at(return_parameters, 0) & 0x0FFF,
            received_sdu_count: le32_at(return_parameters, 2),
            missed_sdu_count: le32_at(return_parameters, 6),
            failed_sdu_count: le32_at(return_parameters, 10) })

// The return parameters of the LE Read ISO Link Quality command ([Vol
// 4] Part E, Section 7.8.116): Connection_Handle and the seven 4-octet
// counters of packets.
pub @value
struct IsoLinkQuality
    connection_handle: Int
    tx_unacked_packets: Int
    tx_flushed_packets: Int
    tx_last_subevent_packets: Int
    retransmitted_packets: Int
    crc_error_packets: Int
    rx_unreceived_packets: Int
    duplicate_packets: Int

// The return parameters of LE Read ISO Link Quality, from the octets after Status, or None when they are not exactly 30 octets.
pub @satisfies("REQ-BLE-HCI-057")
@tier(embedded)
fn iso_link_quality(return_parameters: [u8]) -> ?IsoLinkQuality
    if list.len(return_parameters) != 30
        None
    else
        Some(IsoLinkQuality {
            connection_handle: le16_at(return_parameters, 0) & 0x0FFF,
            tx_unacked_packets: le32_at(return_parameters, 2),
            tx_flushed_packets: le32_at(return_parameters, 6),
            tx_last_subevent_packets: le32_at(return_parameters, 10),
            retransmitted_packets: le32_at(return_parameters, 14),
            crc_error_packets: le32_at(return_parameters, 18),
            rx_unreceived_packets: le32_at(return_parameters, 22),
            duplicate_packets: le32_at(return_parameters, 26) })

// ── Isochronous channel events, [Vol 4] Part E, Section 7.7.65.25 to
//    7.7.65.30 and Section 7.7.65.34 ────────────────────────────────
//
// Eight LE Meta subevents belong to the isochronous channels.  Like the
// periodic advertising events above, each decoder takes the event packet
// without its HCI packet indicator and answers None for another subevent,
// for an event whose Parameter_Total_Length is not the one its parameters
// add up to, and for an event whose length disagrees with the Num_BIS it
// carries.  A Connection_Handle is 12 bits meaningful and is masked to
// them.

// Subevent_Code 0x19 of the LE CIS Established event [v1] ([Vol 4] Part E, Section 7.7.65.25).
pub const LE_SUBEVENT_CIS_ESTABLISHED = 0x19

// Subevent_Code 0x1A of the LE CIS Request event ([Vol 4] Part E, Section 7.7.65.26).
pub const LE_SUBEVENT_CIS_REQUEST = 0x1A

// Subevent_Code 0x1B of the LE Create BIG Complete event ([Vol 4] Part E, Section 7.7.65.27).
pub const LE_SUBEVENT_CREATE_BIG_COMPLETE = 0x1B

// Subevent_Code 0x1C of the LE Terminate BIG Complete event ([Vol 4] Part E, Section 7.7.65.28).
pub const LE_SUBEVENT_TERMINATE_BIG_COMPLETE = 0x1C

// Subevent_Code 0x1D of the LE BIG Sync Established event ([Vol 4] Part E, Section 7.7.65.29).
pub const LE_SUBEVENT_BIG_SYNC_ESTABLISHED = 0x1D

// Subevent_Code 0x1E of the LE BIG Sync Lost event ([Vol 4] Part E, Section 7.7.65.30).
pub const LE_SUBEVENT_BIG_SYNC_LOST = 0x1E

// Subevent_Code 0x22 of the LE BIGInfo Advertising Report event ([Vol 4] Part E, Section 7.7.65.34).
pub const LE_SUBEVENT_BIG_INFO_ADVERTISING_REPORT = 0x22

// Subevent_Code 0x2A of the LE CIS Established event [v2] ([Vol 4] Part E, Section 7.7.65.25).
pub const LE_SUBEVENT_CIS_ESTABLISHED_V2 = 0x2A

// Whether `evt` is an LE Meta event of subevent `subevent` that is
// `total` octets long, header included, and whose Parameter_Total_Length
// agrees with that.
@tier(embedded)
@no_alloc
fn iso_event_shape(evt: [u8], subevent: Int, total: Int) -> Bool
    event_code(evt) == hci_frame.EVT_LE_META_EVENT and list.len(evt) == total and (evt[1] as Int) == total - 2 and le_meta_subevent(evt) == subevent

// The parameters of an LE CIS Established event ([Vol 4] Part E, Section 7.7.65.25), in its [v1] or [v2] form.
//
// `v2` says which form was decoded; the fields only [v2] carries (`sub_interval`, `max_sdu_c_to_p`, `max_sdu_p_to_c`,
// `sdu_interval_c_to_p`, `sdu_interval_p_to_c` and `framing`) are 0 in the first.  The delays, the latencies and the two SDU
// intervals are in microseconds and `iso_interval` is in 1.25 ms units.  `connection_handle` is the 12-bit handle of the CIS.
pub @value
struct CisEstablished
    v2: Bool
    status: Int
    connection_handle: Int
    cig_sync_delay: Int
    cis_sync_delay: Int
    transport_latency_c_to_p: Int
    transport_latency_p_to_c: Int
    phy_c_to_p: Int
    phy_p_to_c: Int
    nse: Int
    bn_c_to_p: Int
    bn_p_to_c: Int
    ft_c_to_p: Int
    ft_p_to_c: Int
    max_pdu_c_to_p: Int
    max_pdu_p_to_c: Int
    iso_interval: Int
    sub_interval: Int
    max_sdu_c_to_p: Int
    max_sdu_p_to_c: Int
    sdu_interval_c_to_p: Int
    sdu_interval_p_to_c: Int
    framing: Int

// The LE CIS Established event packet is 31 octets in its [v1] form and
// 45 in its [v2] form.
pub const CIS_ESTABLISHED_LENGTH = 31

// The length of an LE CIS Established [v2] event packet in octets, 45.
pub const CIS_ESTABLISHED_V2_LENGTH = 45

// The parameters of an LE CIS Established event, [v1] (31 octets) or [v2] (45 octets), given without its HCI packet indicator, or
// None for any other event or one whose length disagrees with its Parameter_Total_Length.
pub @satisfies("REQ-BLE-HCI-058")
@tier(embedded)
fn le_cis_established(evt: [u8]) -> ?CisEstablished
    let v2 = iso_event_shape(evt, LE_SUBEVENT_CIS_ESTABLISHED_V2, CIS_ESTABLISHED_V2_LENGTH)
    if not v2 and not iso_event_shape(evt, LE_SUBEVENT_CIS_ESTABLISHED, CIS_ESTABLISHED_LENGTH)
        return None
    Some(CisEstablished {
        v2: v2,
        status: evt[3] as Int,
        connection_handle: le16_at(evt, 4) & 0x0FFF,
        cig_sync_delay: le24_at(evt, 6),
        cis_sync_delay: le24_at(evt, 9),
        transport_latency_c_to_p: le24_at(evt, 12),
        transport_latency_p_to_c: le24_at(evt, 15),
        phy_c_to_p: evt[18] as Int,
        phy_p_to_c: evt[19] as Int,
        nse: evt[20] as Int,
        bn_c_to_p: evt[21] as Int,
        bn_p_to_c: evt[22] as Int,
        ft_c_to_p: evt[23] as Int,
        ft_p_to_c: evt[24] as Int,
        max_pdu_c_to_p: le16_at(evt, 25),
        max_pdu_p_to_c: le16_at(evt, 27),
        iso_interval: le16_at(evt, 29),
        sub_interval: (if v2 then le24_at(evt, 31) else 0),
        max_sdu_c_to_p: (if v2 then le16_at(evt, 34) else 0),
        max_sdu_p_to_c: (if v2 then le16_at(evt, 36) else 0),
        sdu_interval_c_to_p: (if v2 then le24_at(evt, 38) else 0),
        sdu_interval_p_to_c: (if v2 then le24_at(evt, 41) else 0),
        framing: (if v2 then evt[44] as Int else 0) })

// The parameters of an LE CIS Request event ([Vol 4] Part E, Section 7.7.65.26): the 12-bit `acl_connection_handle` of the
// connection, the 12-bit `cis_connection_handle` of the requested CIS, and its `cig_id` and `cis_id`.
//
// A Peripheral's Controller reports it when a Central asks for a CIS; the Host answers with LE Accept CIS Request or LE Reject
// CIS Request on the CIS handle.
pub @value
struct CisRequest
    acl_connection_handle: Int
    cis_connection_handle: Int
    cig_id: Int
    cis_id: Int

// The parameters of an LE CIS Request event, given without its HCI packet indicator, or None for any other event or one that is
// not 9 octets long.
pub @satisfies("REQ-BLE-HCI-058")
@tier(embedded)
fn le_cis_request(evt: [u8]) -> ?CisRequest
    if not iso_event_shape(evt, LE_SUBEVENT_CIS_REQUEST, 9)
        return None
    Some(CisRequest {
        acl_connection_handle: le16_at(evt, 3) & 0x0FFF,
        cis_connection_handle: le16_at(evt, 5) & 0x0FFF,
        cig_id: evt[7] as Int,
        cis_id: evt[8] as Int })

// The parameters of an LE Create BIG Complete event ([Vol 4] Part E, Section 7.7.65.27).
//
// `big_sync_delay` and `transport_latency_big` are in microseconds, `iso_interval` is in 1.25 ms units, and `connection_handles`
// holds the 12-bit handle of each BIS of the BIG.  `phy`, `nse`, `bn`, `pto`, `irc` and `max_pdu` are the BIG parameters the
// Controller chose.
pub struct CreateBigComplete
    status: Int
    big_handle: Int
    big_sync_delay: Int
    transport_latency_big: Int
    phy: Int
    nse: Int
    bn: Int
    pto: Int
    irc: Int
    max_pdu: Int
    iso_interval: Int
    connection_handles: [Int]

// The octets of an LE Create BIG Complete event before its Connection_Handle list, 21: the 3-octet header and the 18 octets of
// parameters up to Num_BIS.
pub const CREATE_BIG_COMPLETE_FIXED = 21

// The `count` 12-bit connection handles held in `evt` from octet `at` on, 2 octets each, least significant first.
//
// The caller has checked that `evt` is long enough; a short `evt` is an error.
pub @tier(embedded)
fn iso_handle_list(evt: [u8], at: Int, count: Int) -> [Int]
    // A list of `Int` keeps each element in a cell of its own, so the list is an explicit allocation.
    system
        var handles: [Int] = list.with_capacity(count)
        for i in 0..count
            let _ = list.try_push(handles, le16_at(evt, at + 2 * i) & 0x0FFF)
        handles

// The parameters of an LE Create BIG Complete event, given without its HCI packet indicator, or None for any other event or one
// whose length disagrees with its Num_BIS.
pub @satisfies("REQ-BLE-HCI-058")
@tier(embedded)
fn le_create_big_complete(evt: [u8]) -> ?CreateBigComplete
    if list.len(evt) < CREATE_BIG_COMPLETE_FIXED
        return None
    let n = evt[20] as Int
    if not iso_event_shape(evt, LE_SUBEVENT_CREATE_BIG_COMPLETE, CREATE_BIG_COMPLETE_FIXED + 2 * n)
        return None
    system
        Some(CreateBigComplete {
            status: evt[3] as Int,
            big_handle: evt[4] as Int,
            big_sync_delay: le24_at(evt, 5),
            transport_latency_big: le24_at(evt, 8),
            phy: evt[11] as Int,
            nse: evt[12] as Int,
            bn: evt[13] as Int,
            pto: evt[14] as Int,
            irc: evt[15] as Int,
            max_pdu: le16_at(evt, 16),
            iso_interval: le16_at(evt, 18),
            connection_handles: iso_handle_list(evt, 21, n) })

// The parameters of an LE Terminate BIG Complete event ([Vol 4] Part E, Section 7.7.65.28): the `big_handle` and the `reason` the
// BIG ended.
pub @value
struct TerminateBigComplete
    big_handle: Int
    reason: Int

// The parameters of an LE Terminate BIG Complete event, given without its HCI packet indicator, or None for any other event or one
// that is not 5 octets long.
pub @satisfies("REQ-BLE-HCI-058")
@tier(embedded)
fn le_terminate_big_complete(evt: [u8]) -> ?TerminateBigComplete
    if not iso_event_shape(evt, LE_SUBEVENT_TERMINATE_BIG_COMPLETE, 5)
        return None
    Some(TerminateBigComplete { big_handle: evt[3] as Int, reason: evt[4] as Int })

// The parameters of an LE BIG Sync Established event ([Vol 4] Part E, Section 7.7.65.29).
//
// `transport_latency_big` is in microseconds, `iso_interval` in 1.25 ms units, and `connection_handles` holds the 12-bit handle of
// each BIS the Controller synchronized to.
pub struct BigSyncEstablished
    status: Int
    big_handle: Int
    transport_latency_big: Int
    nse: Int
    bn: Int
    pto: Int
    irc: Int
    max_pdu: Int
    iso_interval: Int
    connection_handles: [Int]

// The octets of an LE BIG Sync Established event before its Connection_Handle list, 17: the 3-octet header and the 14 octets of
// parameters up to Num_BIS.
pub const BIG_SYNC_ESTABLISHED_FIXED = 17

// The parameters of an LE BIG Sync Established event, given without its HCI packet indicator, or None for any other event or one
// whose length disagrees with its Num_BIS.
pub @satisfies("REQ-BLE-HCI-058")
@tier(embedded)
fn le_big_sync_established(evt: [u8]) -> ?BigSyncEstablished
    if list.len(evt) < BIG_SYNC_ESTABLISHED_FIXED
        return None
    let n = evt[16] as Int
    if not iso_event_shape(evt, LE_SUBEVENT_BIG_SYNC_ESTABLISHED, BIG_SYNC_ESTABLISHED_FIXED + 2 * n)
        return None
    system
        Some(BigSyncEstablished {
            status: evt[3] as Int,
            big_handle: evt[4] as Int,
            transport_latency_big: le24_at(evt, 5),
            nse: evt[8] as Int,
            bn: evt[9] as Int,
            pto: evt[10] as Int,
            irc: evt[11] as Int,
            max_pdu: le16_at(evt, 12),
            iso_interval: le16_at(evt, 14),
            connection_handles: iso_handle_list(evt, 17, n) })

// The parameters of an LE BIG Sync Lost event ([Vol 4] Part E, Section 7.7.65.30): the `big_handle` and the `reason` the
// synchronization ended.
pub @value
struct BigSyncLost
    big_handle: Int
    reason: Int

// The parameters of an LE BIG Sync Lost event, given without its HCI packet indicator, or None for any other event or one that is
// not 5 octets long.
pub @satisfies("REQ-BLE-HCI-058")
@tier(embedded)
fn le_big_sync_lost(evt: [u8]) -> ?BigSyncLost
    if not iso_event_shape(evt, LE_SUBEVENT_BIG_SYNC_LOST, 5)
        return None
    Some(BigSyncLost { big_handle: evt[3] as Int, reason: evt[4] as Int })

// The parameters of an LE BIGInfo Advertising Report event ([Vol 4] Part E, Section 7.7.65.34): what a Controller reports for a
// periodic advertising train that carries a BIGInfo, so that the Host can decide to synchronize to the BIG with LE BIG Create Sync.
//
// `sync_handle` is the 12-bit handle of the train, `iso_interval` is in 1.25 ms units and `sdu_interval` in microseconds;
// `encryption` says whether the BIG is encrypted.
pub @value
struct BigInfoAdvertisingReport
    sync_handle: Int
    num_bis: Int
    nse: Int
    iso_interval: Int
    bn: Int
    pto: Int
    irc: Int
    max_pdu: Int
    sdu_interval: Int
    max_sdu: Int
    phy: Int
    framing: Int
    encryption: Bool

// The parameters of an LE BIGInfo Advertising Report event, given without its HCI packet indicator, or None for any other event or
// one that is not 22 octets long.
pub @satisfies("REQ-BLE-HCI-058")
@tier(embedded)
fn le_big_info_advertising_report(evt: [u8]) -> ?BigInfoAdvertisingReport
    if not iso_event_shape(evt, LE_SUBEVENT_BIG_INFO_ADVERTISING_REPORT, 22)
        return None
    Some(BigInfoAdvertisingReport {
        sync_handle: le16_at(evt, 3) & 0x0FFF,
        num_bis: evt[5] as Int,
        nse: evt[6] as Int,
        iso_interval: le16_at(evt, 7),
        bn: evt[9] as Int,
        pto: evt[10] as Int,
        irc: evt[11] as Int,
        max_pdu: le16_at(evt, 12),
        sdu_interval: le24_at(evt, 14),
        max_sdu: le16_at(evt, 17),
        phy: evt[19] as Int,
        framing: evt[20] as Int,
        encryption: (evt[21] as Int) != 0 })

// ── HCI ISO Data packets, [Vol 4] Part E, Section 5.4.5 ─────────────
//
// The first four octets of the packet are the header: Connection_Handle
// (12 bits), PB_Flag (2 bits), TS_Flag (1 bit), one reserved bit, and
// Data_Total_Length (14 bits, then two reserved bits).  The data that
// follows is the ISO_Data_Load.  When PB_Flag is 0b00 (first fragment) or
// 0b10 (complete SDU), it starts with the optional Time_Stamp (4 octets,
// when TS_Flag is set), then Packet_Sequence_Number (2),
// ISO_SDU_Length (12 bits), two reserved bits and Packet_Status_Flag (2
// bits, 2 octets together), and then the SDU or its first fragment.  When
// PB_Flag is 0b01 (intermediate) or 0b11 (last fragment) the data is the
// fragment and nothing else, and TS_Flag is clear.

// PB_Flag 0b00 of an HCI ISO Data packet: the first fragment of a fragmented SDU.
pub const ISO_PB_FIRST_FRAGMENT = 0x00

// PB_Flag 0b01 of an HCI ISO Data packet: an intermediate fragment of an SDU.
pub const ISO_PB_INTERMEDIATE_FRAGMENT = 0x01

// PB_Flag 0b10 of an HCI ISO Data packet: a complete SDU.
pub const ISO_PB_COMPLETE_SDU = 0x02

// PB_Flag 0b11 of an HCI ISO Data packet: the last fragment of an SDU.
pub const ISO_PB_LAST_FRAGMENT = 0x03

// Packet_Status_Flag of a packet the Controller sends: valid data; data
// with possible errors; lost data, which comes as a complete SDU of no
// data and an ISO_SDU_Length of zero.  The Host sends 0b00.
pub const ISO_PSF_VALID = 0x00

// Packet_Status_Flag 0b01: the data may have errors.
pub const ISO_PSF_POSSIBLY_INVALID = 0x01

// Packet_Status_Flag 0b10: the data is lost; the packet is a complete SDU with no data and an ISO_SDU_Length of zero.
pub const ISO_PSF_LOST = 0x02

// The length of the HCI ISO Data packet header in octets, 4.
pub const ISO_HEADER_LEN = 4

// The SDU header after the optional Time_Stamp: Packet_Sequence_Number and
// the word of ISO_SDU_Length and Packet_Status_Flag, 4 octets.
pub const ISO_SDU_HEADER_LEN = 4

// The length of the optional Time_Stamp of an ISO Data packet in octets, 4.
pub const ISO_TIME_STAMP_LEN = 4

// The ranges of the header fields.
pub const ISO_DATA_TOTAL_LENGTH_MAX = 0x3FFF

// The largest ISO_SDU_Length, 0x0FFF: it is 12 bits wide.
pub const ISO_SDU_LENGTH_MAX = 0x0FFF

// One HCI ISO Data packet.  `has_sdu_header` is whether the packet is a
// first fragment or a complete SDU, the two forms that carry the SDU
// header; the fields from `has_time_stamp` to `packet_status` are
// meaningful only when it is set and are 0 or false otherwise.  `data` is
// the SDU, or the fragment of it.
pub struct IsoDataPacket
    connection_handle: Int
    pb_flag: Int
    has_sdu_header: Bool
    has_time_stamp: Bool
    time_stamp: Int
    packet_sequence_number: Int
    iso_sdu_length: Int
    packet_status: Int
    data: [u8]

// Whether the PB_Flag value is one of the two that carry the SDU header.
pub @tier(embedded)
@no_alloc
fn iso_pb_has_sdu_header(pb_flag: Int) -> Bool
    pb_flag == ISO_PB_FIRST_FRAGMENT or pb_flag == ISO_PB_COMPLETE_SDU

// The HCI ISO Data packet `pkt`, given without its HCI packet indicator,
// or None when it is shorter than its header, Data_Total_Length
// disagrees with the octets that follow, a packet with the SDU header
// holds fewer octets than the header needs, or a fragment without it has
// TS_Flag set.
pub @satisfies("REQ-BLE-ISO-001")
@tier(embedded)
fn iso_data_packet(pkt: [u8]) -> ?IsoDataPacket
    let n = list.len(pkt)
    if n < ISO_HEADER_LEN
        return None
    let total = le16_at(pkt, 2) & ISO_DATA_TOTAL_LENGTH_MAX
    if n != ISO_HEADER_LEN + total
        return None
    let pb = (pkt[1] as Int >>> 4) & 0x03
    let ts = ((pkt[1] as Int >>> 6) & 0x01) != 0
    let handle = le16_at(pkt, 0) & 0x0FFF
    if not iso_pb_has_sdu_header(pb)
        if ts
            return None
        system
            return Some(IsoDataPacket {
                connection_handle: handle, pb_flag: pb, has_sdu_header: false, has_time_stamp: false,
                time_stamp: 0, packet_sequence_number: 0, iso_sdu_length: 0, packet_status: 0,
                data: hci_buf.slice(pkt, ISO_HEADER_LEN, n) })
    let load = ISO_HEADER_LEN + (if ts then ISO_TIME_STAMP_LEN else 0)
    if n < load + ISO_SDU_HEADER_LEN
        return None
    let time_stamp = if ts
        le32_at(pkt, ISO_HEADER_LEN)
    else
        0
    let sdu_word = le16_at(pkt, load + 2)
    system
        Some(IsoDataPacket {
            connection_handle: handle, pb_flag: pb, has_sdu_header: true, has_time_stamp: ts,
            time_stamp: time_stamp,
            packet_sequence_number: le16_at(pkt, load),
            iso_sdu_length: sdu_word & ISO_SDU_LENGTH_MAX,
            packet_status: (sdu_word >>> 14) & 0x03,
            data: hci_buf.slice(pkt, load + ISO_SDU_HEADER_LEN, n) })

// The HCI ISO Data packet for `p`, without its HCI packet indicator, or
// None when a field does not fit its width: a Connection_Handle above
// 0x0EFF, a PB_Flag or Packet_Status_Flag above 3, an ISO_SDU_Length above
// 0x0FFF, a Packet_Sequence_Number above 16 bits, a Time_Stamp above 32
// bits, a Data_Total_Length above 0x3FFF, or a fragment without the SDU
// header that has a Time_Stamp.
pub @satisfies("REQ-BLE-ISO-001")
@tier(embedded)
fn build_iso_data_packet(p: IsoDataPacket) -> ?[u8]
    if p.connection_handle < 0 or p.connection_handle > 0x0EFF or p.pb_flag < 0 or p.pb_flag > 3
        return None
    let has_header = iso_pb_has_sdu_header(p.pb_flag)
    if not has_header and p.has_time_stamp
        return None
    if has_header
        if p.iso_sdu_length < 0 or p.iso_sdu_length > ISO_SDU_LENGTH_MAX or p.packet_status < 0 or p.packet_status > 3
            return None
        if p.packet_sequence_number < 0 or p.packet_sequence_number > 0xFFFF
            return None
        if p.has_time_stamp and (p.time_stamp < 0 or p.time_stamp > 0xFFFFFFFF)
            return None
    let header_len = if not has_header
        0
    else if p.has_time_stamp
        ISO_TIME_STAMP_LEN + ISO_SDU_HEADER_LEN
    else
        ISO_SDU_HEADER_LEN
    let total = header_len + list.len(p.data)
    if total > ISO_DATA_TOTAL_LENGTH_MAX
        return None
    let flags = (p.connection_handle >>> 8) | (p.pb_flag << 4) | ((if p.has_time_stamp then 1 else 0) << 6)
    var out = hci_buf.buf(ISO_HEADER_LEN + total)
    hci_buf.put8(var out, p.connection_handle)
    hci_buf.put8(var out, flags)
    hci_buf.put8(var out, total)
    hci_buf.put8(var out, (total >>> 8) & 0x3F)
    if has_header
        if p.has_time_stamp
            hci_buf.put32(var out, p.time_stamp)
        hci_buf.put16(var out, p.packet_sequence_number)
        hci_buf.put16(var out, p.iso_sdu_length | (p.packet_status << 14))
    hci_buf.put_bytes(var out, p.data)
    Some(out)

// The same packet with its HCI packet indicator, ready for the transport.
pub @satisfies("REQ-BLE-ISO-001")
@tier(embedded)
fn build_h4_iso(p: IsoDataPacket) -> ?[u8]
    match build_iso_data_packet(p)
        None      => None
        Some(pkt) => Some(hci_h4.frame_h4(hci_h4.PKT_ISO, pkt))

// ── Periodic advertising, [Vol 4] Part E, Section 7.7.65.14-16 and
//    Section 7.7.65.24 ───────────────────────────────────────────────
//
// Periodic advertising has four LE Meta subevents of its own.  Each of
// them is reported without its HCI packet indicator and without the LE
// Meta header, so `le_meta_subevent` on the event packet is how a
// caller tells them apart, and the parsers below take the packet the
// event code has been stripped from, as `le_connection_complete` does.

// Subevent_Code 0x0E of the LE Periodic Advertising Sync Established event ([Vol 4] Part E, Section 7.7.65.14).
pub const LE_SUBEVENT_PERIODIC_ADVERTISING_SYNC_ESTABLISHED = 0x0E

// Subevent_Code 0x0F of the LE Periodic Advertising Report event ([Vol 4] Part E, Section 7.7.65.15).
pub const LE_SUBEVENT_PERIODIC_ADVERTISING_REPORT = 0x0F

// Subevent_Code 0x10 of the LE Periodic Advertising Sync Lost event ([Vol 4] Part E, Section 7.7.65.16).
pub const LE_SUBEVENT_PERIODIC_ADVERTISING_SYNC_LOST = 0x10

// Subevent_Code 0x18 of the LE Periodic Advertising Sync Transfer Received event ([Vol 4] Part E, Section 7.7.65.24).
pub const LE_SUBEVENT_PERIODIC_ADVERTISING_SYNC_TRANSFER_RECEIVED = 0x18

// Data_Status of the LE Periodic Advertising Report event ([Vol 4] Part
// E, Section 7.7.65.15): Complete, or one of the two incomplete
// states, which only the profiles that receive fragmented periodic
// advertising data act on.
pub const PERIODIC_DATA_COMPLETE = 0x00

// Data_Status 0x01: the report's data is incomplete and more data follows in another report.
pub const PERIODIC_DATA_INCOMPLETE_MORE = 0x01

// Data_Status 0x02: the report's data is incomplete and truncated; no more of it follows.
pub const PERIODIC_DATA_INCOMPLETE_TRUNCATED = 0x02

// ── LE Periodic Advertising Sync Established event, Section 7.7.65.14 ─
//
//   evt[0] = 0x3E, evt[1] = length, evt[2] = 0x0E, then Status,
//   Sync_Handle (2, 12 bits), Advertising_SID, Advertiser_Address_Type,
//   Advertiser_Address (6), Advertiser_PHY,
//   Periodic_Advertising_Interval (2), Advertiser_Clock_Accuracy

// The parameters of an LE Periodic Advertising Sync Established event ([Vol 4] Part E, Section 7.7.65.14).
//
// `sync_handle` is the 12-bit handle of the train, `advertiser_address` is 6 octets, least significant first, and
// `periodic_interval` is in 1.25 ms units.
pub struct PeriodicSyncEstablished
    status: Int
    sync_handle: Int
    advertising_sid: Int
    advertiser_address_type: Int
    advertiser_address: [u8]
    advertiser_phy: Int
    periodic_interval: Int
    advertiser_clock_accuracy: Int

// The parameters of an LE Periodic Advertising Sync Established event, given without its HCI packet indicator, or None for any other
// event or one shorter than 18 octets.
pub @tier(embedded)
fn le_periodic_sync_established(evt: [u8]) -> ?PeriodicSyncEstablished
    if event_code(evt) != hci_frame.EVT_LE_META_EVENT
        return None
    if list.len(evt) < 18 or le_meta_subevent(evt) != LE_SUBEVENT_PERIODIC_ADVERTISING_SYNC_ESTABLISHED
        return None
    system
        Some(PeriodicSyncEstablished {
            status: evt[3] as Int,
            sync_handle: le16_at(evt, 4) & 0x0FFF,
            advertising_sid: evt[6] as Int,
            advertiser_address_type: evt[7] as Int,
            advertiser_address: hci_buf.slice(evt, 8, 14),
            advertiser_phy: evt[14] as Int,
            periodic_interval: le16_at(evt, 15),
            advertiser_clock_accuracy: evt[17] as Int })

// ── LE Periodic Advertising Sync Lost event, Section 7.7.65.16 ──────
//
//   evt[0] = 0x3E, evt[1] = length, evt[2] = 0x10, then Sync_Handle (2)

// The parameters of an LE Periodic Advertising Sync Lost event ([Vol 4] Part E, Section 7.7.65.16): the 12-bit `sync_handle` of the
// train that was lost.
pub @value
struct PeriodicSyncLost
    sync_handle: Int

// The parameters of an LE Periodic Advertising Sync Lost event, given without its HCI packet indicator, or None for any other event
// or one shorter than 5 octets.
pub @tier(embedded)
fn le_periodic_sync_lost(evt: [u8]) -> ?PeriodicSyncLost
    if event_code(evt) != hci_frame.EVT_LE_META_EVENT
        return None
    if list.len(evt) < 5 or le_meta_subevent(evt) != LE_SUBEVENT_PERIODIC_ADVERTISING_SYNC_LOST
        return None
    Some(PeriodicSyncLost { sync_handle: le16_at(evt, 3) & 0x0FFF })

// ── LE Periodic Advertising Report event, Section 7.7.65.15 ─────────
//
//   evt[0] = 0x3E, evt[1] = length, evt[2] = 0x0F, then Sync_Handle (2),
//   TX_Power, RSSI, CTE_Type, Data_Status, Data_Length, Data
//
// The header is 8 octets, and the data follows it.

// The parameters of an LE Periodic Advertising Report event ([Vol 4] Part E, Section 7.7.65.15).
//
// `sync_handle` is the 12-bit handle of the train, `data_status` is `PERIODIC_DATA_COMPLETE` or one of the two incomplete values,
// and `data` is the advertising data of the report.
pub struct PeriodicAdvertisingReport
    sync_handle: Int
    tx_power: Int
    rssi: Int
    cte_type: Int
    data_status: Int
    data: [u8]

// The octets of an LE Periodic Advertising Report event before its data, 10.
pub const PERIODIC_REPORT_HEADER = 10

// The parameters of an LE Periodic Advertising Report event, given without its HCI packet indicator, or None for any other event or
// one whose Data_Length runs past its end.
pub @tier(embedded)
fn le_periodic_advertising_report(evt: [u8]) -> ?PeriodicAdvertisingReport
    if event_code(evt) != hci_frame.EVT_LE_META_EVENT
        return None
    if list.len(evt) < PERIODIC_REPORT_HEADER or le_meta_subevent(evt) != LE_SUBEVENT_PERIODIC_ADVERTISING_REPORT
        return None
    let n = evt[9] as Int
    if PERIODIC_REPORT_HEADER + n > list.len(evt)
        return None
    system
        Some(PeriodicAdvertisingReport {
            sync_handle: le16_at(evt, 3) & 0x0FFF,
            tx_power: evt[5] as Int,
            rssi: evt[6] as Int,
            cte_type: evt[7] as Int,
            data_status: evt[8] as Int,
            data: hci_buf.slice(evt, PERIODIC_REPORT_HEADER, PERIODIC_REPORT_HEADER + n) })

// ── LE Periodic Advertising Sync Transfer Received event,
//    Section 7.7.65.24 ──────────────────────────────────────────────
//
//   evt[0] = 0x3E, evt[1] = length, evt[2] = 0x18, then Status,
//   Connection_Handle (2), Service_Data (2), Sync_Handle (2, 12 bits),
//   Advertising_SID, Advertiser_Address_Type, Advertiser_Address (6),
//   Advertiser_PHY, Periodic_Advertising_Interval (2),
//   Advertiser_Clock_Accuracy

// The parameters of an LE Periodic Advertising Sync Transfer Received event ([Vol 4] Part E, Section 7.7.65.24): the `status`, the
// 12-bit `connection_handle` of the connection that transferred the train, the `service_data` the peer sent, and the train as in
// `PeriodicSyncEstablished`.
pub struct PeriodicSyncTransferReceived
    status: Int
    connection_handle: Int
    service_data: Int
    sync_handle: Int
    advertising_sid: Int
    advertiser_address_type: Int
    advertiser_address: [u8]
    advertiser_phy: Int
    periodic_interval: Int
    advertiser_clock_accuracy: Int

// The parameters of an LE Periodic Advertising Sync Transfer Received event, given without its HCI packet indicator, or None for
// any other event or one shorter than 22 octets.
pub @tier(embedded)
fn le_periodic_sync_transfer_received(evt: [u8]) -> ?PeriodicSyncTransferReceived
    if event_code(evt) != hci_frame.EVT_LE_META_EVENT
        return None
    if list.len(evt) < 22 or le_meta_subevent(evt) != LE_SUBEVENT_PERIODIC_ADVERTISING_SYNC_TRANSFER_RECEIVED
        return None
    system
        Some(PeriodicSyncTransferReceived {
            status: evt[3] as Int,
            connection_handle: le16_at(evt, 4) & 0x0FFF,
            service_data: le16_at(evt, 6),
            sync_handle: le16_at(evt, 8) & 0x0FFF,
            advertising_sid: evt[10] as Int,
            advertiser_address_type: evt[11] as Int,
            advertiser_address: hci_buf.slice(evt, 12, 18),
            advertiser_phy: evt[18] as Int,
            periodic_interval: le16_at(evt, 19),
            advertiser_clock_accuracy: evt[21] as Int })

// ── LE Periodic Advertising Subevent Data Request, Section 7.7.65.36 ─
//
//   evt[0] = 0x3E, evt[1] = length (4), evt[2] = 0x27, then
//   Advertising_Handle, Subevent_Start, Subevent_Data_Count
//
// The Controller asks the advertiser for the data of the subevents of an
// upcoming periodic advertising event: `subevent_start` is the first one
// and `subevent_data_count` how many follow it, wrapping past the last
// subevent of the train ([Vol 4] Part E, Section 7.8.125).  A train with
// responses carries no data a Lower Tester can read until the Host
// answers one of these.

// Subevent_Code 0x27 of the LE Periodic Advertising Subevent Data Request event ([Vol 4] Part E, Section 7.7.65.36).
pub const LE_SUBEVENT_PERIODIC_ADVERTISING_SUBEVENT_DATA_REQUEST = 0x27

// The parameters of an LE Periodic Advertising Subevent Data Request event: the `advertising_handle` and the `subevent_start` and
// `subevent_data_count` of the subevents the Controller asks data for.
pub @value
struct PawrSubeventRequest
    advertising_handle: Int
    subevent_start: Int
    subevent_data_count: Int

// The parameters of an LE Periodic Advertising Subevent Data Request event, given without its HCI packet indicator, or None for any
// other event or one shorter than 6 octets.
pub @tier(embedded)
fn le_periodic_advertising_subevent_data_request(evt: [u8]) -> ?PawrSubeventRequest
    if event_code(evt) != hci_frame.EVT_LE_META_EVENT
        return None
    if list.len(evt) < 6 or le_meta_subevent(evt) != LE_SUBEVENT_PERIODIC_ADVERTISING_SUBEVENT_DATA_REQUEST
        return None
    Some(PawrSubeventRequest {
        advertising_handle: evt[3] as Int,
        subevent_start: evt[4] as Int,
        subevent_data_count: evt[5] as Int })

// ── LE Periodic Advertising Response Report, Section 7.7.65.37 ──────
//
//   evt[0] = 0x3E, evt[1] = length, evt[2] = 0x28, then
//   Advertising_Handle, Subevent, TX_Status, Num_Responses, and for
//   every response TX_Power, RSSI, CTE_Type, Response_Slot,
//   Data_Status, Data_Length and the data
//
// This is what the synchronized devices answered in the response slots
// the advertiser asked for.  A response slot's data may arrive in more
// than one report, in which case every one but the last carries the
// "incomplete, more data to come" Data_Status.

// Subevent_Code 0x28 of the LE Periodic Advertising Response Report event ([Vol 4] Part E, Section 7.7.65.37).
//
// Its layout is Advertising_Handle, Subevent, TX_Status, Num_Responses and, for every response, TX_Power, RSSI, CTE_Type,
// Response_Slot, Data_Status, Data_Length and the data.  It reports what the synchronized devices answered in the response slots
// the advertiser asked for; a slot's data may arrive in several reports, every one but the last with an incomplete Data_Status.
pub const LE_SUBEVENT_PERIODIC_ADVERTISING_RESPONSE_REPORT = 0x28

// Tx_Status of the report: 0x00 when the subevent and its response slots
// went out, 0x01 when the Controller failed to transmit the subevent, so
// no device could answer ([Vol 4] Part E, Section 7.7.65.37).
pub const PAWR_TX_STATUS_SUCCESS = 0x00

// Tx_Status 0x01: the Controller failed to transmit the subevent, so no device could answer.
pub const PAWR_TX_STATUS_FAILED = 0x01

// One response of an LE Periodic Advertising Response Report: the `tx_power` and `rssi` of the response, its `cte_type`,
// the `response_slot` it came in, its `data_status` and its `data`.
pub struct PawrResponse
    tx_power: Int
    rssi: Int
    cte_type: Int
    response_slot: Int
    data_status: Int
    data: [u8]

// The parameters of an LE Periodic Advertising Response Report event: the `advertising_handle`, the `subevent`, the `tx_status`
// (`PAWR_TX_STATUS_SUCCESS` or `PAWR_TX_STATUS_FAILED`) and the `responses`.
pub struct PawrResponseReport
    advertising_handle: Int
    subevent: Int
    tx_status: Int
    responses: [PawrResponse]

// The six one-octet header fields that lead one response.
pub const PAWR_RESPONSE_HEADER = 6

// The parameters of an LE Periodic Advertising Response Report event, given without its HCI packet indicator, or None for any other
// event or one whose responses run past its end.
pub @tier(embedded)
fn le_periodic_advertising_response_report(evt: [u8]) -> ?PawrResponseReport
    if event_code(evt) != hci_frame.EVT_LE_META_EVENT
        return None
    if list.len(evt) < 7 or le_meta_subevent(evt) != LE_SUBEVENT_PERIODIC_ADVERTISING_RESPONSE_REPORT
        return None
    let n = evt[6] as Int
    // The responses are records with byte payloads, so they are boxed: the list and each record are explicit
    // allocations, bounded by the 255 responses a one-octet Num_Responses counts.
    system
        var out: [PawrResponse] = list.with_capacity(n)
        var at = 7
        for _ in 0..n
            if at + PAWR_RESPONSE_HEADER > list.len(evt)
                return None
            let length = evt[at + 5] as Int
            if at + PAWR_RESPONSE_HEADER + length > list.len(evt)
                return None
            let _ = list.try_push(out, PawrResponse {
                tx_power: evt[at] as Int,
                rssi: evt[at + 1] as Int,
                cte_type: evt[at + 2] as Int,
                response_slot: evt[at + 3] as Int,
                data_status: evt[at + 4] as Int,
                data: hci_buf.slice(evt, at + PAWR_RESPONSE_HEADER, at + PAWR_RESPONSE_HEADER + length) })
            at = at + PAWR_RESPONSE_HEADER + length
        Some(PawrResponseReport {
            advertising_handle: evt[3] as Int,
            subevent: evt[4] as Int,
            tx_status: evt[5] as Int,
            responses: out })
