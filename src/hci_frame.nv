// HCI packet headers and constants ([Vol 4] Part E, Section 5.4).
//
// The packets that cross the Host-Controller interface:
//
//   HCI Command (Host to Controller)   | Opcode (2) | Parameter_Total_Length (1) | Parameters |
//   HCI Event (Controller to Host)     | Event_Code (1) | Parameter_Total_Length (1) | Parameters |
//   HCI ACL Data (both directions)     | Handle and flags (2) | Data_Total_Length (2) | Data |
//
// Multi-octet fields are little-endian.  An opcode is the 6-bit OGF above the 10-bit OCF.  The handle and flags of
// an ACL packet pack a 12-bit connection handle, a 2-bit Packet_Boundary_Flag and a 2-bit Broadcast_Flag.
//
// The module holds the OGF and event-code constants, the opcode and ACL-field pack and split functions, the three
// header structs with their `frame` compositions, and `HciCmdMsg` and `HciEvtMsg`, the typed form a transport hands
// to a Host.

use hci_buf

// Opcode Group Field of the Link Control commands, 0x01 ([Vol 4] Part E, Section 7.1).
pub const OGF_LINK_CONTROL = 0x01

// Opcode Group Field of the Controller and Baseband commands, 0x03 ([Vol 4] Part E, Section 7.3).
pub const OGF_CONTROLLER_BASEBAND = 0x03

// Opcode Group Field of the Informational Parameters commands, 0x04 ([Vol 4] Part E, Section 7.4).
pub const OGF_INFORMATIONAL_PARAMETERS = 0x04

// Opcode Group Field of the Status Parameters commands, 0x05 ([Vol 4] Part E, Section 7.5).
pub const OGF_STATUS_PARAMETERS = 0x05

// Opcode Group Field of the LE Controller commands, 0x08 ([Vol 4] Part E, Section 7.8).
pub const OGF_LE_CONTROLLER = 0x08

// Opcode Group Field of the vendor-specific commands, 0x3F.
pub const OGF_VENDOR_SPECIFIC = 0x3F

// Event code of Disconnection Complete, 0x05 ([Vol 4] Part E, Section 7.7.5).
pub const EVT_DISCONNECTION_COMPLETE = 0x05

// Event code of Encryption Change, 0x08 ([Vol 4] Part E, Section 7.7.8).
pub const EVT_ENCRYPTION_CHANGE = 0x08

// Event code of Command Complete, 0x0E ([Vol 4] Part E, Section 7.7.14).
pub const EVT_COMMAND_COMPLETE = 0x0E

// Event code of Command Status, 0x0F ([Vol 4] Part E, Section 7.7.15).
pub const EVT_COMMAND_STATUS = 0x0F

// Event code of Hardware Error, 0x10 ([Vol 4] Part E, Section 7.7.16).
pub const EVT_HARDWARE_ERROR = 0x10

// Event code of Number Of Completed Packets, 0x13 ([Vol 4] Part E, Section 7.7.19).
pub const EVT_NUMBER_OF_COMPLETED_PACKETS = 0x13

// Event code of the LE Meta event, 0x3E, which carries every LE event under a Subevent_Code ([Vol 4] Part E, Section 7.7.65).
pub const EVT_LE_META_EVENT = 0x3E

// H4 packet-type byte of an HCI Command packet, 0x01; the same value as `hci_h4.PKT_COMMAND`.
pub const H4_PKT_COMMAND = 0x01

// H4 packet-type byte of an HCI ACL Data packet, 0x02; the same value as `hci_h4.PKT_ACL`.
pub const H4_PKT_ACL = 0x02

// H4 packet-type byte of an HCI SCO Data packet, 0x03; the same value as `hci_h4.PKT_SCO`.  LE does not use it.
pub const H4_PKT_SCO = 0x03

// H4 packet-type byte of an HCI Event packet, 0x04; the same value as `hci_h4.PKT_EVENT`.
pub const H4_PKT_EVENT = 0x04

// H4 packet-type byte of an HCI ISO Data packet, 0x05; the same value as `hci_h4.PKT_ISO`.
pub const H4_PKT_ISO = 0x05

// The 16-bit opcode of command `ocf` in group `ogf`: the OGF in bits 10 to 15 and the OCF in bits 0 to 9.
//
// Bits of `ogf` above the sixth and bits of `ocf` above the tenth are dropped.  `pack_opcode(0x03, 0x003)` is 0x0C03,
// HCI_Reset.  On the wire the opcode is little-endian ([Vol 4] Part E, Section 5.4.1).
pub @tier(embedded)
@no_alloc
fn pack_opcode(ogf: Int, ocf: Int) -> Int
    let g = (ogf & 0x3F) << 10
    let c = ocf & 0x3FF
    g | c

// The OGF of `opcode`: bits 10 to 15, 0 to 63.
pub @tier(embedded)
@no_alloc
fn opcode_ogf(opcode: Int) -> Int
    (opcode >>> 10) & 0x3F

// The OCF of `opcode`: bits 0 to 9, 0 to 1023.
pub @tier(embedded)
@no_alloc
fn opcode_ocf(opcode: Int) -> Int
    opcode & 0x3FF

// The header of an HCI Command packet: the 16-bit `opcode` and the `length` of the parameters in octets, little-endian
// ([Vol 4] Part E, Section 5.4.1).
pub @satisfies("REQ-BLE-ARCH-001")
@little_endian
struct HciCmdHeader
    opcode: u16
    length: u8

frame HciCmd = HciCmdHeader ++ [u8]

// The header of an HCI Event packet: the event `code` and the `length` of the parameters in octets
// ([Vol 4] Part E, Section 5.4.4).
pub @little_endian
struct HciEvtHeader
    code: u8
    length: u8

frame HciEvt = HciEvtHeader ++ [u8]

// The header of an HCI ACL Data packet, little-endian ([Vol 4] Part E, Section 5.4.2).
//
// `handle_flags` holds the 12-bit connection handle in bits 0 to 11, the Packet_Boundary_Flag in bits 12 and 13 and the
// Broadcast_Flag in bits 14 and 15; `pack_acl_handle_flags`, `acl_handle`, `acl_pb_flag` and `acl_bc_flag` build and split
// it.  `length` is the Data_Total_Length in octets.
pub @little_endian
struct HciAclHeader
    handle_flags: u16
    length: u16

frame HciAcl = HciAclHeader ++ [u8]

// Packet_Boundary_Flag 0b10: the first, automatically flushable, fragment of an L2CAP PDU, which is what an LE Host sends.
pub const PB_FLAG_START_FLUSHABLE = 0x2

// Packet_Boundary_Flag 0b01: a continuing fragment of an L2CAP PDU.
pub const PB_FLAG_CONTINUATION = 0x1

// The `handle_flags` field of an ACL Data header: `handle` in bits 0 to 11, `pb` in bits 12 and 13 and `bc` in bits 14 and 15.
//
// Each argument is masked to its width.  `pb` is a Packet_Boundary_Flag (`PB_FLAG_START_FLUSHABLE` or `PB_FLAG_CONTINUATION`)
// and `bc` is the Broadcast_Flag, 0 on an LE link.
pub @satisfies("REQ-BLE-LL-069")
@tier(embedded)
@no_alloc
fn pack_acl_handle_flags(handle: Int, pb: Int, bc: Int) -> Int
    let h = handle & 0xFFF
    let p = (pb & 0x3) << 12
    let b = (bc & 0x3) << 14
    h | p | b

// The 12-bit connection handle of an ACL `handle_flags` field, 0 to 0x0FFF.
pub @tier(embedded)
@no_alloc
fn acl_handle(handle_flags: Int) -> Int
    handle_flags & 0xFFF

// The Packet_Boundary_Flag of an ACL `handle_flags` field, bits 12 and 13, 0 to 3.
pub @tier(embedded)
@no_alloc
fn acl_pb_flag(handle_flags: Int) -> Int
    (handle_flags >>> 12) & 0x3

// The Broadcast_Flag of an ACL `handle_flags` field, bits 14 and 15, 0 to 3.
pub @tier(embedded)
@no_alloc
fn acl_bc_flag(handle_flags: Int) -> Int
    (handle_flags >>> 14) & 0x3

// A command as a Host hands it to a transport: the 16-bit `opcode` and the `params` octets, without the length octet or an
// H4 type byte.
pub struct HciCmdMsg
    opcode: Int
    params: [u8]

// An event as a transport hands it to a Host: the `event_code` and the `params` octets, without the length octet or an H4 type
// byte.
pub struct HciEvtMsg
    event_code: Int
    params: [u8]

// The wire form of `cmd`: the opcode (2 octets, little-endian), the parameter length (1 octet) and the parameters.
//
// The H4 type byte is not added; `hci_h4.frame_h4` does that.  The parameters must not exceed 255 octets.
pub @tier(embedded)
fn encode_hci_cmd_msg(cmd: HciCmdMsg) -> [u8]
    var out = hci_buf.buf(3 + list.len(cmd.params))
    hci_buf.put16(var out, cmd.opcode)
    hci_buf.put8(var out, list.len(cmd.params))
    hci_buf.put_bytes(var out, cmd.params)
    out

// The wire form of `evt`: the event code (1 octet), the parameter length (1 octet) and the parameters.
//
// The H4 type byte is not added.  The parameters must not exceed 255 octets.
pub @tier(embedded)
fn encode_hci_evt_msg(evt: HciEvtMsg) -> [u8]
    var out = hci_buf.buf(2 + list.len(evt.params))
    hci_buf.put8(var out, evt.event_code)
    hci_buf.put8(var out, list.len(evt.params))
    hci_buf.put_bytes(var out, evt.params)
    out

// The command held in `bytes`, an HCI Command packet without its H4 type byte.
//
// `bytes` must hold at least the 3-octet header; the parameters are everything after it.  The length octet is not checked
// against the number of octets present.
pub @tier(embedded)
fn decode_hci_cmd_msg(bytes: [u8]) -> HciCmdMsg
    let opcode = bytes[0] as Int | (bytes[1] as Int << 8)
    // The message holds a list, so it is a boxed record: the one explicit allocation of the decoder.
    system
        HciCmdMsg { opcode: opcode, params: hci_buf.slice(bytes, 3, list.len(bytes)) }

// The event held in `bytes`, an HCI Event packet without its H4 type byte.
//
// `bytes` must hold at least the 2-octet header; the parameters are everything after it.  The length octet is not checked
// against the number of octets present.
pub @tier(embedded)
fn decode_hci_evt_msg(bytes: [u8]) -> HciEvtMsg
    system
        HciEvtMsg { event_code: bytes[0] as Int, params: hci_buf.slice(bytes, 2, list.len(bytes)) }
