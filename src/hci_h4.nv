// H4 framing of HCI packets ([Vol 4] Part A, Section 2).
//
// H4 prefixes each HCI packet (Command, ACL Data, Event or ISO Data) with one packet-type byte and concatenates the
// packets on a byte stream.  It adds no length and no checksum: the packet carries its own length in its HCI header.
//
//   0x01  HCI Command
//   0x02  HCI ACL Data
//   0x03  HCI SCO Data (not used by LE)
//   0x04  HCI Event
//   0x05  HCI ISO Data
//
// The module frames a packet and tells a deframer how many bytes the next packet occupies.  It does no I/O and
// returns an index rather than a slice, so a deframer built on it does not allocate.

use hci_buf

// H4 packet-type byte of an HCI Command packet, 0x01 ([Vol 4] Part A, Section 2).
pub const PKT_COMMAND = 0x01

// H4 packet-type byte of an HCI ACL Data packet, 0x02 ([Vol 4] Part A, Section 2).
pub const PKT_ACL = 0x02

// H4 packet-type byte of an HCI SCO Data packet, 0x03.  LE does not use SCO, and `h4_packet_length` rejects it.
pub const PKT_SCO = 0x03

// H4 packet-type byte of an HCI Event packet, 0x04 ([Vol 4] Part A, Section 2).
pub const PKT_EVENT = 0x04

// H4 packet-type byte of an HCI ISO Data packet, 0x05 ([Vol 4] Part A, Section 2).
pub const PKT_ISO = 0x05

// The H4 frame of an HCI packet: a new list holding `pkt_type` followed by `hci_packet`.
//
// `pkt_type` is one of the `PKT_*` constants and `hci_packet` is the packet with its HCI header and no H4
// prefix.  `frame_h4(PKT_COMMAND, [0x03, 0x0C, 0x00])` is `[0x01, 0x03, 0x0C, 0x00]`, the HCI_Reset command.
pub @satisfies("REQ-BLE-H4-001")
@satisfies("REQ-BLE-H4-003")
@satisfies("REQ-BLE-H4-010")
@tier(embedded)
fn frame_h4(pkt_type: Int, hci_packet: [u8]) -> [u8]
    var out = hci_buf.buf(1 + list.len(hci_packet))
    hci_buf.put8(var out, pkt_type)
    hci_buf.put_bytes(var out, hci_packet)
    out

// The answer of `h4_packet_length` when the bytes held do not yet hold the length field, -1: wait for more.
pub const H4_BYTES_NEED_MORE = -1

// The answer of `h4_packet_length` for a type byte the LE system does not use (SCO or an unknown value), -2.
pub const H4_BYTES_REJECT = -2

// The number of bytes the H4 packet at the start of `buf` occupies, the type byte included.
//
// A deframer calls it on the bytes it has received and slices that many off the front.  The size is `4 + Parameter_Total_Length`
// for a command, `3 + Parameter_Total_Length` for an event and `5 + Data_Total_Length` for ACL data and ISO data.  The ACL length is
// 16 bits and the ISO length is 14 bits: the two bits above it are reserved and ignored ([Vol 4] Part E, Section 5.4.5).
//
// Answers `H4_BYTES_NEED_MORE` (-1) when `buf` ends before the length field and `H4_BYTES_REJECT` (-2) for SCO or any type byte
// that is not 0x01, 0x02, 0x04 or 0x05.  It reads the header only, so it neither allocates nor copies.
pub @satisfies("REQ-BLE-H4-004")
@tier(embedded)
@no_alloc
fn h4_packet_length(buf: [u8]) -> Int
    let n = list.len(buf)
    if n == 0
        H4_BYTES_NEED_MORE
    else
        let tb = buf[0] as Int
        match tb
            // Command: 1 + opcode(2) + length(1) + params
            0x1 =>
                if n < 4
                    H4_BYTES_NEED_MORE
                else
                    4 + buf[3] as Int
            // ACL: 1 + handle_flags(2) + length(2) + data
            0x2 =>
                if n < 5
                    H4_BYTES_NEED_MORE
                else
                    // Length is 16-bit LE at offset 3-4.
                    let lo = buf[3] as Int
                    let hi = buf[4] as Int
                    5 + (lo | (hi << 8))
            // Event: 1 + evt_code(1) + length(1) + params
            0x4 =>
                if n < 3
                    H4_BYTES_NEED_MORE
                else
                    3 + buf[2] as Int
            // ISO: 1 + handle_flags(2) + data_total_length(2) + data.
            // Data_Total_Length is 14 bits; the two bits above it are
            // reserved ([Vol 4] Part E, Section 5.4.5).
            0x5 =>
                if n < 5
                    H4_BYTES_NEED_MORE
                else
                    let lo = buf[3] as Int
                    let hi = buf[4] as Int & 0x3F
                    5 + (lo | (hi << 8))
            // SCO, or unknown: rejected.
            _   => H4_BYTES_REJECT

// ── Byte-stream splitter — returns index-based status ──────────────
//
// Callers doing streaming deframing call `h4_packet_length(buf)`
// to get the next packet's byte count, slice `buf[0..n]` as the
// packet, and `buf[n..]` as the remaining stream.  This module
// deliberately stops at the length: it returns an index, never a
// sliced copy, so the deframer stays allocation-free on the
// embedded tier.  Callers do their own index-based slicing.
