// orbit/noble-hci/src/hci_h4.nv — H4 UART framing per Core Vol 4 Part A §2.
//
// H4 is the simplest of the HCI transports: each HCI packet
// (Command / Event / ACL Data / ISO Data) is prefixed with a
// single packet-type byte and concatenated on a byte stream.
// There is no H4-level length, no CRC, no framing beyond the
// type byte — the packet itself carries its own length in the
// HCI header.
//
// Packet types (Vol 4 Part A §2):
//   0x01  HCI Command
//   0x02  HCI ACL Data
//   0x03  HCI SCO Data       (not used by LE)
//   0x04  HCI Event
//   0x05  HCI ISO Data       (isochronous channels; framed by length,
//                             the data itself is built and parsed in
//                             hci_codec.nv and host/isoal.nv)
//
// This module is pure byte manipulation — no hal.uart, no
// transport trait dispatch.  Exposes framing + deframing
// helpers that the concrete transports (HciUart, HciUsbCdc,
// HciRam's byte-mode) use under the hood.
//
// Satisfies: REQ-BLE-H4-001 (packet-type byte), REQ-BLE-H4-002
// (UART 8-N-1), REQ-BLE-H4-003 (no sub-framing), REQ-BLE-H4-004
// (length extraction per packet type), REQ-BLE-H4-009 (no H4
// fragmentation — HCI fragmenting happens one layer up).

use std.test
use std.bits


// ── Packet-type bytes (authoritative copy here; aliased by
// ──  hci_frame.nv) ────────────────────────────────────────────

const PKT_COMMAND = 0x01

const PKT_ACL = 0x02

const PKT_SCO = 0x03

const PKT_EVENT = 0x04

const PKT_ISO = 0x05


// ── Frame a single HCI packet with its H4 type byte prefix ──────────
//
// Returns a new `[u8]` with the type byte prepended.  Caller
// passes the raw HCI packet (header + payload, no H4 prefix).
//
// Example:
//   frame_h4(PKT_COMMAND, [0x03, 0x0C, 0x00])
//     → [0x01, 0x03, 0x0C, 0x00]

@satisfies("REQ-BLE-H4-001")
@satisfies("REQ-BLE-H4-003")
@satisfies("REQ-BLE-H4-010")
@tier(embedded)
fn frame_h4(pkt_type: Int, hci_packet: [u8]) -> [u8]
    var prefix: [u8] = list.with_capacity(1 + list.len(hci_packet))
    list.append(prefix, [pkt_type as u8])
    list.append(prefix, hci_packet)
    prefix


// ── Deframe / length extraction (Vol 4 Part A §3, REQ-BLE-H4-004) ───
//
// Given a byte slice starting at an H4 packet-type byte, return
// the number of bytes this whole packet occupies on the wire
// including the type byte and all HCI-level headers + payload.
// Returns -1 if the slice is too short to determine the length
// (caller should wait for more bytes), or -2 if the type byte
// is unknown/rejected.
//
//   Command:  1 (type) + 3 (OpCode+Len) + params[Len]        → 4 + Len
//   Event:    1 (type) + 2 (Code+Len) + params[Len]          → 3 + Len
//   ACL:      1 (type) + 4 (HandleFlags+Len) + data[Len]     → 5 + Len
//   ISO:      1 (type) + 4 (HandleFlags+Len) + data[Len]     → 5 + Len
//             (Len is 14 bits; ACL's is 16)
//   SCO: rejected (the LE system has no SCO).

const H4_BYTES_NEED_MORE = -1

const H4_BYTES_REJECT = -2

@satisfies("REQ-BLE-H4-004")
@tier(embedded)
@no_alloc
fn h4_packet_length(buf: [u8]) -> Int
    let n = list.len(buf)
    if n == 0
        H4_BYTES_NEED_MORE
    else
        let tb = buf[0] as Int
        match tb
            // Command: 1 + opcode(2) + length(1) + params
            0x01 =>
                if n < 4
                    H4_BYTES_NEED_MORE
                else
                    4 + (buf[3] as Int)
            // ACL: 1 + handle_flags(2) + length(2) + data
            0x02 =>
                if n < 5
                    H4_BYTES_NEED_MORE
                else
                    // Length is 16-bit LE at offset 3-4.
                    let lo = buf[3] as Int
                    let hi = buf[4] as Int
                    5 + (lo | (hi << 8))
            // Event: 1 + evt_code(1) + length(1) + params
            0x04 =>
                if n < 3
                    H4_BYTES_NEED_MORE
                else
                    3 + (buf[2] as Int)
            // ISO: 1 + handle_flags(2) + data_total_length(2) + data.
            // Data_Total_Length is 14 bits; the two bits above it are
            // reserved ([Vol 4] Part E, Section 5.4.5).
            0x05 =>
                if n < 5
                    H4_BYTES_NEED_MORE
                else
                    let lo = buf[3] as Int
                    let hi = (buf[4] as Int) & 0x3F
                    5 + (lo | (hi << 8))
            // SCO, or unknown: rejected.
            _ => H4_BYTES_REJECT


// ── Byte-stream splitter — returns index-based status ──────────────
//
// Callers doing streaming deframing call `h4_packet_length(buf)`
// to get the next packet's byte count, slice `buf[0..n]` as the
// packet, and `buf[n..]` as the remaining stream.  This module
// deliberately stops at the length: it returns an index, never a
// sliced copy, so the deframer stays allocation-free on the
// embedded tier.  Callers do their own index-based slicing.


// ── Tests ────────────────────────────────────────────────────────────

@test
fn test_packet_type_constants()
    test.assert_eq(PKT_COMMAND, 0x01)
    test.assert_eq(PKT_ACL, 0x02)
    test.assert_eq(PKT_SCO, 0x03)
    test.assert_eq(PKT_EVENT, 0x04)
    test.assert_eq(PKT_ISO, 0x05)

@test
@satisfies("REQ-BLE-H4-001")
fn test_frame_h4_prepends_type_byte()
    // HCI_Reset bytes: opcode 0x0C03 (LE 03 0C) + length 0.
    let hci : [u8] = [0x03, 0x0C, 0x00]
    let framed = frame_h4(PKT_COMMAND, hci)
    test.assert_eq(list.len(framed), 4)
    test.assert_eq(framed[0] as Int, 0x01)
    test.assert_eq(framed[1] as Int, 0x03)
    test.assert_eq(framed[2] as Int, 0x0C)
    test.assert_eq(framed[3] as Int, 0x00)

@test
@satisfies("REQ-BLE-H4-001")
fn test_frame_h4_event_prefix()
    let evt : [u8] = [0x0E, 0x04, 0x01, 0x03, 0x0C, 0x00]
    let framed = frame_h4(PKT_EVENT, evt)
    test.assert_eq(framed[0] as Int, 0x04)
    test.assert_eq(list.len(framed), 7)

@test
@satisfies("REQ-BLE-H4-004")
fn test_h4_length_command()
    // 0x01 CMD | 0x03 0x0C | 0x00 (no params) → 4 bytes total.
    let buf : [u8] = [0x01, 0x03, 0x0C, 0x00]
    test.assert_eq(h4_packet_length(buf), 4)

    // With 3 bytes of params.
    let buf2 : [u8] = [0x01, 0xAA, 0xBB, 0x03, 0xDE, 0xAD, 0xBE]
    test.assert_eq(h4_packet_length(buf2), 7)

@test
@satisfies("REQ-BLE-H4-004")
fn test_h4_length_event()
    // 0x04 EVT | 0x0E | 0x04 | 4 bytes of params → 7 bytes total.
    let buf : [u8] = [0x04, 0x0E, 0x04, 0x01, 0x03, 0x0C, 0x00]
    test.assert_eq(h4_packet_length(buf), 7)

    // Zero-param event (type + code + len=0) = 3 bytes.
    let buf2 : [u8] = [0x04, 0x10, 0x00]
    test.assert_eq(h4_packet_length(buf2), 3)

@test
@satisfies("REQ-BLE-H4-004")
fn test_h4_length_acl_with_16bit_length()
    // 0x02 ACL | handle_flags (2 bytes LE) | length (2 bytes LE) | data
    // Length 0x0005 = 5 bytes of data → 10 bytes total including headers.
    let buf : [u8] = [0x02, 0x01, 0x20, 0x05, 0x00, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE]
    test.assert_eq(h4_packet_length(buf), 10)

@test
fn test_h4_length_acl_big_16bit_length()
    // ACL payload length 0x0100 = 256 bytes.  Checks the
    // 16-bit LE decoding picks up the high byte.
    let mut buf : [u8] = [0x02, 0x01, 0x20, 0x00, 0x01]
    test.assert_eq(h4_packet_length(buf), 5 + 256)

@test
fn test_h4_length_need_more_on_short_buffer()
    // Empty — clearly need more.
    test.assert_eq(h4_packet_length([]), -1)

    // Command type byte only, no header yet.
    let b1 : [u8] = [0x01]
    test.assert_eq(h4_packet_length(b1), -1)

    // Command with 3 bytes — still need-more because need 4 to read length.
    let b2 : [u8] = [0x01, 0x03, 0x0C]
    test.assert_eq(h4_packet_length(b2), -1)

    // ACL with 4 bytes — still need-more because length is 2 bytes at offset 3-4.
    let b3 : [u8] = [0x02, 0x01, 0x20, 0x05]
    test.assert_eq(h4_packet_length(b3), -1)

@test
@satisfies("REQ-BLE-H4-006")
fn test_h4_length_sco_and_junk_rejected()
    // SCO (0x03) not used by LE.
    let sco : [u8] = [0x03, 0x00, 0x00, 0x00]
    test.assert_eq(h4_packet_length(sco), -2)

    // Garbage byte.
    let junk : [u8] = [0xFF, 0x00, 0x00]
    test.assert_eq(h4_packet_length(junk), -2)

@test
fn test_h4_length_back_to_back_packets()
    // Two back-to-back packets in one buffer.  Caller computes
    // the second packet's offset from the first's length.
    let stream : [u8] = [
        0x01, 0x03, 0x0C, 0x00,                      // Command (4 bytes)
        0x04, 0x0E, 0x04, 0x01, 0x03, 0x0C, 0x00     // Event (7 bytes)
    ]
    let first_len = h4_packet_length(stream)
    test.assert_eq(first_len, 4)

    // Inspect the second packet in place by indexing past the
    // first.  No list.take/drop needed.
    test.assert_eq(stream[first_len] as Int, 0x04)  // Event type byte
    // The event's length byte at offset first_len + 2 is 0x04.
    test.assert_eq(stream[first_len + 2] as Int, 0x04)

@test
@satisfies("REQ-BLE-H4-004")
fn test_h4_length_iso_with_14bit_length()
    // ISO: type, Connection_Handle/PB/TS (2), Data_Total_Length (2).
    let small : [u8] = [0x05, 0x40, 0x20, 0x08, 0x00]
    test.assert_eq(h4_packet_length(small), 5 + 8)

    // The length is 14 bits: 0x0123 in the low 14 bits, and the two
    // reserved bits above them are not part of it.
    let big : [u8] = [0x05, 0x40, 0x20, 0x23, 0x01]
    test.assert_eq(h4_packet_length(big), 5 + 0x0123)
    let masked : [u8] = [0x05, 0x40, 0x20, 0xFF, 0xFF]
    test.assert_eq(h4_packet_length(masked), 5 + 0x3FFF)

@test
@satisfies("REQ-BLE-H4-004")
fn test_h4_length_iso_need_more_on_short_buffer()
    test.assert_eq(h4_packet_length([0x05]), -1)
    // Four octets: the length field is not complete.
    let b4 : [u8] = [0x05, 0x40, 0x20, 0x08]
    test.assert_eq(h4_packet_length(b4), -1)

@test
@satisfies("REQ-BLE-H4-004")
fn test_frame_h4_iso_prefix()
    let framed = frame_h4(PKT_ISO, [0x40, 0x20, 0x02, 0x00, 0xAA, 0xBB])
    test.assert_eq(list.len(framed), 7)
    test.assert_eq(framed[0] as Int, 0x05)
    test.assert_eq(h4_packet_length(framed), 7)
