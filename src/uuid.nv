// Bluetooth UUIDs of 16, 32 and 128 bits ([Vol 3] Part B, Section 2.5.1).
//
// An attribute type or a service is named by a UUID of one of three widths:
//
//   16-bit   assigned by the Bluetooth SIG, e.g. 0x180A "Device Information"
//   32-bit   rare; expanded the same way
//   128-bit  vendor defined; sent in full
//
// A 16-bit or 32-bit UUID is an alias for the Bluetooth Base UUID with its octets 12 to 15 replaced:
//
//   00000000-0000-1000-8000-00805F9B34FB
//
// On the wire a UUID is little-endian, so the Base UUID is laid out as
//
//   FB 34 9B 5F 80 00 00 80 00 10 00 00 XX XX XX XX
//                                       ^^^^^^^^^^^ the short UUID
//
// A caller holds a 16-bit UUID as an `Int` and a 128-bit one as 16 octets, least significant first.  The module
// expands a short UUID, compares two 128-bit UUIDs, and compares a short UUID with a 128-bit one without building
// the expansion.

// The Bluetooth Base UUID 00000000-0000-1000-8000-00805F9B34FB as 16 octets, least significant octet first as on the wire.
//
// Octets 12 to 15 are zero: they are where a 16-bit or 32-bit UUID is overlaid ([Vol 3] Part B, Section 2.5.1).
pub @tier(embedded)
fn base_uuid_bytes() -> [u8]
    [
        0xFB, 0x34, 0x9B, 0x5F,
        0x80, 0x00, 0x00, 0x80,
        0x00, 0x10, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00]

// The 128-bit form of the 16-bit UUID `uuid16`, 16 octets, least significant octet first.
//
// The Base UUID with `uuid16` in octets 12 and 13 and zero in octets 14 and 15.  Only the low 16 bits of `uuid16` are used.
pub @satisfies("REQ-BLE-ATT-UUID-002")
@tier(embedded)
fn uuid16_to_128(uuid16: Int) -> [u8]
    [
        0xFB, 0x34, 0x9B, 0x5F,
        0x80, 0x00, 0x00, 0x80,
        0x00, 0x10, 0x00, 0x00,
        (uuid16 & 0xFF) as u8,
        ((uuid16 >>> 8) & 0xFF) as u8,
        0x00, 0x00]

// The 128-bit form of the 32-bit UUID `uuid32`, 16 octets, least significant octet first.
//
// The Base UUID with `uuid32` in octets 12 to 15.  Only the low 32 bits of `uuid32` are used.
pub @satisfies("REQ-BLE-ATT-UUID-002")
@tier(embedded)
fn uuid32_to_128(uuid32: Int) -> [u8]
    [
        0xFB, 0x34, 0x9B, 0x5F,
        0x80, 0x00, 0x00, 0x80,
        0x00, 0x10, 0x00, 0x00,
        (uuid32 & 0xFF) as u8,
        ((uuid32 >>> 8) & 0xFF) as u8,
        ((uuid32 >>> 16) & 0xFF) as u8,
        ((uuid32 >>> 24) & 0xFF) as u8]

// Whether two 128-bit UUIDs, each 16 octets, are equal octet for octet.
//
// A list of any other length answers false; it is never read past its end.  It does not allocate.
pub @tier(embedded)
@no_alloc
fn uuid128_eq(a: [u8], b: [u8]) -> Bool
    if list.len(a) != 16 or list.len(b) != 16
        false
    else
        var i = 0
        var equal = true
        loop
            if i >= 16
                break
            if (a[i] as Int) != (b[i] as Int)
                equal = false
                break
            i = i + 1
        equal

// Whether the 128-bit UUID `full` is the 16-bit UUID `short` expanded on the Base UUID.
//
// True when `full` is 16 octets, its octets 0 to 11 are the Base UUID, its octets 12 and 13 hold `short` little-endian and its
// octets 14 and 15 are zero.  It compares in place, without building the 128-bit form, so a table of 16-bit UUIDs answers
// a request that names a 128-bit UUID without allocating.
pub @tier(embedded)
@no_alloc
fn uuid_eq_short_full(short: Int, full: [u8]) -> Bool
    if list.len(full) != 16
        false
    else
        // Bytes 0..11 must match the base.  Compare against the
        // base array element-by-element to avoid a separate alloc.
        var i = 0
        var ok = true
        loop
            if i >= 12
                break
            if (full[i] as Int) != base_byte_at(i)
                ok = false
                break
            i = i + 1
        // Bytes 14..15 must be zero (32-bit UUIDs use the full
        // 4-byte slot; a 16-bit alias must clear the upper two).
        if ok and ((full[14] as Int) != 0 or (full[15] as Int) != 0)
            ok = false
        // Bytes 12..13 must be the short value (LE).
        if ok
            let lo = short & 0xFF
            let hi = (short >>> 8) & 0xFF
            if (full[12] as Int) != lo or (full[13] as Int) != hi
                ok = false
        ok

// Inline base-byte lookup so `uuid_eq_short_full` doesn't realloc
// the base array per comparison.  Hand-coded match keeps the
// embedded codegen simple.
@tier(embedded)
@no_alloc
fn base_byte_at(i: Int) -> Int
    match i
        0  => 0xFB
        1  => 0x34
        2  => 0x9B
        3  => 0x5F
        4  => 0x80
        5  => 0x00
        6  => 0x00
        7  => 0x80
        8  => 0x00
        9  => 0x10
        10 => 0x00
        11 => 0x00
        // cov: skip — the only caller, uuid_eq_short_full, passes 0 to 11; the arm exists because a match must be total
        _  => 0x00

// The wire form of the 16-bit UUID `uuid16`: two octets, least significant first.  Only the low 16 bits are used.
pub @satisfies("REQ-BLE-ATT-UUID-003")
@tier(embedded)
fn uuid16_to_le_bytes(uuid16: Int) -> [u8]
    [
        (uuid16 & 0xFF) as u8,
        ((uuid16 >>> 8) & 0xFF) as u8]

// The 16-bit UUID held in the first two octets of `b`, least significant first.
//
// Answers -1 when `b` holds fewer than two octets, which no UUID value equals.
pub @satisfies("REQ-BLE-ATT-UUID-003")
@tier(embedded)
@no_alloc
fn uuid16_from_le_bytes(b: [u8]) -> Int
    if list.len(b) < 2
        -1
    else
        b[0] as Int | (b[1] as Int << 8)
