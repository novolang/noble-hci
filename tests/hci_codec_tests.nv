// tests/hci_codec_tests.nv — the unit tests of src/hci_codec.nv.
//
//   novo test tests/hci_codec_tests.nv

use std.test
use hci_commands
use hci_codec.{ le_meta_event, ACL_PB_CONTINUING, ACL_PB_FIRST_FLUSHABLE, ADV_REPORT_ADV_IND, ADV_REPORT_ADV_NONCONN_IND, ADV_REPORT_RSSI_NOT_AVAILABLE, ADV_REPORT_SCAN_RSP, CIS_ESTABLISHED_LENGTH, CIS_ESTABLISHED_V2_LENGTH, CONNECTION_ROLE_PERIPHERAL, ISO_PB_COMPLETE_SDU, ISO_PB_FIRST_FRAGMENT, ISO_PB_INTERMEDIATE_FRAGMENT, ISO_PB_LAST_FRAGMENT, ISO_PSF_LOST, ISO_PSF_POSSIBLY_INVALID, ISO_PSF_VALID, IsoDataPacket, LE_SUBEVENT_BIG_INFO_ADVERTISING_REPORT, LE_SUBEVENT_BIG_SYNC_ESTABLISHED, LE_SUBEVENT_BIG_SYNC_LOST, LE_SUBEVENT_CIS_ESTABLISHED, LE_SUBEVENT_CIS_ESTABLISHED_V2, LE_SUBEVENT_CIS_REQUEST, LE_SUBEVENT_CREATE_BIG_COMPLETE, LE_SUBEVENT_TERMINATE_BIG_COMPLETE, PAWR_TX_STATUS_FAILED, PAWR_TX_STATUS_SUCCESS, PERIODIC_DATA_COMPLETE, acl_data_packet, answered_opcode, answered_status, build_command, build_h4_acl, build_h4_command, build_h4_iso, build_iso_data_packet, cmd_hci_reset, cmd_le_set_advertising_enable, cmd_le_set_random_address, cmd_read_bd_addr, command_complete_opcode, command_complete_return_parameters, command_complete_status, command_status_opcode, command_status_status, connection_complete_event, disconnection_complete, encryption_change, event_code, event_param_len, is_command_complete, is_command_status, is_encryption_event, iso_connection_handle_return, iso_data_packet, iso_event_shape, iso_group_id_return, iso_link_quality, iso_test_counters, le_advertising_reports, le_big_info_advertising_report, le_big_sync_established, le_big_sync_lost, le_buffer_size, le_buffer_size_v2, le_cis_established, le_cis_request, le_connection_complete, le_connection_update_complete, le_create_big_complete, le_long_term_key_request, le_meta_subevent, le_periodic_advertising_report, le_periodic_advertising_response_report, le_periodic_advertising_subevent_data_request, le_periodic_sync_established, le_periodic_sync_lost, le_periodic_sync_transfer_received, le_read_iso_tx_sync, le_remote_connection_parameter_request, le_set_cig_parameters_return, le_terminate_big_complete, number_of_completed_packets }

// ── Helpers the tests share ─────────────────────────────────────────

// An LE Advertising Report event with one ADV_IND report from random
// address C6:55:44:33:22:11, data Flags 02 01 06, RSSI -60 (0xC4).
@tier(app)
fn one_report_event() -> [u8]
    [0x3E, 0x0F, 0x02, 0x01,
     0x00, 0x01, 0x11, 0x22, 0x33, 0x44, 0x55, 0xC6,
     0x03, 0x02, 0x01, 0x06,
     0xC4]

// An LE Connection Complete event: Status 0, Connection_Handle 0x0040,
// Peripheral, the public address 66:55:44:33:22:11, Connection_Interval
// 0x0028, Peripheral_Latency 0, Supervision_Timeout 0x01F4.
@tier(app)
fn connection_complete_event() -> [u8]
    [0x3E, 0x13, 0x01, 0x00, 0x40, 0x00, 0x01, 0x00,
     0x11, 0x22, 0x33, 0x44, 0x55, 0x66,
     0x28, 0x00, 0x00, 0x00, 0xF4, 0x01, 0x00]

// The parameters of an LE CIS Established event up to ISO_Interval, with
// a different value in every field.
@tier(app)
fn cis_established_v1_params() -> [u8]
    [0x00, 0x42, 0x1F,
     0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C,
     0x01, 0x02, 0x04, 0x03, 0x02, 0x05, 0x06,
     0x10, 0x11, 0x12, 0x13, 0x14, 0x15]

@tier(app)
fn create_big_complete_params(handles: [Int]) -> [u8]
    var params: [u8] = [0x00,
        0x03,
        0x01,
        0x02,
        0x03,
        0x04,
        0x05,
        0x06,
        0x02,
        0x03,
        0x04,
        0x05,
        0x06,
        0x10,
        0x11,
        0x12,
        0x13,
        list.len(handles) as u8]
    for h in handles
        list.append(params, [(h & 0xFF) as u8, ((h >>> 8) & 0xFF) as u8])
    params

@tier(app)
fn big_sync_established_params(handles: [Int]) -> [u8]
    var params: [u8] = [0x00,
        0x01,
        0x0A,
        0x0B,
        0x0C,
        0x02,
        0x03,
        0x04,
        0x05,
        0x20,
        0x21,
        0x22,
        0x23,
        list.len(handles) as u8]
    for h in handles
        list.append(params, [(h & 0xFF) as u8, ((h >>> 8) & 0xFF) as u8])
    params

@tier(app)
fn iso_fragment(handle: Int, pb: Int, data: [u8]) -> IsoDataPacket
    IsoDataPacket {
        connection_handle: handle, pb_flag: pb, has_sdu_header: false, has_time_stamp: false,
        time_stamp: 0, packet_sequence_number: 0, iso_sdu_length: 0, packet_status: 0, data: data }

@tier(app)
fn iso_sdu_packet(handle: Int, pb: Int, ts: ?Int, seq: Int, sdu_length: Int, status: Int,
                  data: [u8]) -> IsoDataPacket
    IsoDataPacket {
        connection_handle: handle, pb_flag: pb, has_sdu_header: true,
        has_time_stamp: ts != None, time_stamp: ts ?? 0,
        packet_sequence_number: seq, iso_sdu_length: sdu_length, packet_status: status, data: data }

@test
@satisfies("REQ-BLE-HCI-001")
fn test_build_command_no_params()
    // HCI_Reset: opcode=0x0C03, no params → [03 0C 00].
    let c = build_command(hci_commands.opcode_hci_reset(), [])
    test.assert_eq(list.len(c), 3)
    test.assert_eq(c[0] as Int, 0x03)
    test.assert_eq(c[1] as Int, 0x0C)
    test.assert_eq(c[2] as Int, 0x00)

@test
@satisfies("REQ-BLE-HCI-001")
fn test_build_command_with_params()
    // LE_Set_Advertising_Enable with enable=true: opcode=0x200A,
    // params=[0x01] → [0A 20 01 01].
    let c = build_command(hci_commands.opcode_le_set_advertising_enable(), [0x01])
    test.assert_eq(list.len(c), 4)
    test.assert_eq(c[0] as Int, 0x0A)
    test.assert_eq(c[1] as Int, 0x20)
    test.assert_eq(c[2] as Int, 0x01)   // param_len
    test.assert_eq(c[3] as Int, 0x01)   // enable byte

@test
@satisfies("REQ-BLE-H4-001")
fn test_build_h4_command_prepends_type_byte()
    // H4-framed HCI_Reset: [01 03 0C 00].
    let w = build_h4_command(hci_commands.opcode_hci_reset(), [])
    test.assert_eq(list.len(w), 4)
    test.assert_eq(w[0] as Int, 0x01)   // H4 Command type byte
    test.assert_eq(w[1] as Int, 0x03)
    test.assert_eq(w[2] as Int, 0x0C)
    test.assert_eq(w[3] as Int, 0x00)

@test
@satisfies("REQ-BLE-HCI-004")
fn test_cmd_hci_reset_wire_bytes()
    let w = cmd_hci_reset()
    test.assert_eq(list.len(w), 4)
    test.assert_eq(w[0] as Int, 0x01)
    test.assert_eq(w[1] as Int, 0x03)
    test.assert_eq(w[2] as Int, 0x0C)
    test.assert_eq(w[3] as Int, 0x00)

@test
@satisfies("REQ-BLE-HCI-005")
fn test_cmd_read_bd_addr_wire_bytes()
    let w = cmd_read_bd_addr()
    // Opcode 0x1009: 09 10.  Wire: 01 09 10 00.
    test.assert_eq(list.len(w), 4)
    test.assert_eq(w[0] as Int, 0x01)
    test.assert_eq(w[1] as Int, 0x09)
    test.assert_eq(w[2] as Int, 0x10)
    test.assert_eq(w[3] as Int, 0x00)

@test
@satisfies("REQ-BLE-HCI-018")
fn test_cmd_le_set_advertising_enable_true()
    let w = cmd_le_set_advertising_enable(true)
    // Opcode 0x200A: 0A 20.  Wire: 01 0A 20 01 01.
    test.assert_eq(list.len(w), 5)
    test.assert_eq(w[0] as Int, 0x01)
    test.assert_eq(w[1] as Int, 0x0A)
    test.assert_eq(w[2] as Int, 0x20)
    test.assert_eq(w[3] as Int, 0x01)
    test.assert_eq(w[4] as Int, 0x01)

@test
@satisfies("REQ-BLE-HCI-018")
fn test_cmd_le_set_advertising_enable_false_has_zero_byte()
    let w = cmd_le_set_advertising_enable(false)
    test.assert_eq(list.len(w), 5)
    test.assert_eq(w[4] as Int, 0x00)   // disable byte

@test
@satisfies("REQ-BLE-HCI-013")
fn test_cmd_le_set_random_address_six_bytes()
    let a: [u8] = [0x11, 0x22, 0x33, 0x44, 0x55, 0xC6]
    let w = cmd_le_set_random_address(a)
    // Opcode 0x2005: 05 20.  Wire: 01 05 20 06 11 22 33 44 55 C6.
    test.assert_eq(list.len(w), 10)
    test.assert_eq(w[0] as Int, 0x01)
    test.assert_eq(w[3] as Int, 0x06)   // param_len = 6

@test
@satisfies("REQ-BLE-HCI-002")
fn test_event_code_and_param_len()
    // Command_Complete event body (no H4 prefix): 0E 04 01 03 0C 00.
    let e: [u8] = [0x0E, 0x04, 0x01, 0x03, 0x0C, 0x00]
    test.assert_eq(event_code(e), 0x0E)
    test.assert_eq(event_param_len(e), 0x04)

@test
fn test_event_code_empty_returns_minus_one()
    test.assert_eq(event_code([]), -1)

@test
fn test_event_param_len_too_short()
    let e: [u8] = [0x0E]   // only code, no len
    test.assert_eq(event_param_len(e), -1)

@test
@satisfies("REQ-BLE-HCI-003")
fn test_is_command_complete_positive()
    let e: [u8] = [0x0E, 0x04, 0x01, 0x03, 0x0C, 0x00]
    test.assert_eq(is_command_complete(e), true)

@test
@satisfies("REQ-BLE-HCI-003")
fn test_is_command_complete_negative()
    // Disconnection_Complete event (code 0x05).
    let e: [u8] = [0x05, 0x04, 0x00, 0x01, 0x00, 0x13]
    test.assert_eq(is_command_complete(e), false)

@test
@satisfies("REQ-BLE-HCI-003")
fn test_command_complete_opcode_extraction()
    // Command_Complete for HCI_Reset (opcode 0x0C03): 0E 04 01 03 0C 00.
    let e: [u8] = [0x0E, 0x04, 0x01, 0x03, 0x0C, 0x00]
    test.assert_eq(command_complete_opcode(e), 0x0C03)

    // Command_Complete for LE_Set_Advertising_Enable (opcode 0x200A).
    let e2: [u8] = [0x0E, 0x04, 0x01, 0x0A, 0x20, 0x00]
    test.assert_eq(command_complete_opcode(e2), 0x200A)

@test
fn test_command_complete_opcode_too_short_buffer()
    // 4 bytes is under the 5-byte minimum for extracting opcode.
    let e: [u8] = [0x0E, 0x04, 0x01, 0x03]
    test.assert_eq(command_complete_opcode(e), -1)

@test
@satisfies("REQ-BLE-HCI-003")
fn test_command_complete_status()
    // LE_Set_Advertising_Enable refused with Command Disallowed (0x0C).
    let e: [u8] = [0x0E, 0x04, 0x01, 0x0A, 0x20, 0x0C]
    test.assert_eq(command_complete_status(e), 0x0C)
    let short: [u8] = [0x0E, 0x03, 0x01, 0x00, 0x00]
    test.assert_eq(command_complete_status(short), -1)

@test
fn test_command_status_fields()
    // Command_Status for LE_Create_Connection (0x200D), status 0.
    let e: [u8] = [0x0F, 0x04, 0x00, 0x01, 0x0D, 0x20]
    test.assert_eq(is_command_status(e), true)
    test.assert_eq(command_status_status(e), 0x00)
    test.assert_eq(command_status_opcode(e), 0x200D)
    test.assert_eq(command_status_opcode([0x0F, 0x04, 0x00]), -1)

@test
@satisfies("REQ-BLE-HCI-003")
fn test_answered_opcode_and_status()
    let cc: [u8] = [0x0E, 0x04, 0x01, 0x03, 0x0C, 0x00]
    let cs: [u8] = [0x0F, 0x04, 0x12, 0x01, 0x0D, 0x20]
    let meta: [u8] = [0x3E, 0x03, 0x02, 0x01, 0x00]
    test.assert_eq(answered_opcode(cc), 0x0C03)
    test.assert_eq(answered_status(cc), 0x00)
    test.assert_eq(answered_opcode(cs), 0x200D)
    test.assert_eq(answered_status(cs), 0x12)
    test.assert_eq(answered_opcode(meta), -1)
    test.assert_eq(answered_status(meta), -1)

@test
fn test_le_meta_subevent()
    let meta: [u8] = [0x3E, 0x03, 0x02, 0x01, 0x00]
    test.assert_eq(le_meta_subevent(meta), 0x02)
    let cc: [u8] = [0x0E, 0x04, 0x01, 0x03, 0x0C, 0x00]
    test.assert_eq(le_meta_subevent(cc), -1)

@test
fn test_le_advertising_report_one_report()
    match le_advertising_reports(one_report_event())
        None    => test.fail("one report decodes")
        Some(r) =>
            test.assert_eq(list.len(r), 1)
            test.assert_eq(r[0].event_type, ADV_REPORT_ADV_IND)
            test.assert_eq(r[0].address_type, 0x01)
            test.assert_eq(list.len(r[0].address), 6)
            test.assert_eq(r[0].address[0] as Int, 0x11)
            test.assert_eq(r[0].address[5] as Int, 0xC6)
            test.assert_eq(list.len(r[0].data), 3)
            test.assert_eq(r[0].data[2] as Int, 0x06)
            test.assert_eq(r[0].rssi, 0xC4)

@test
fn test_le_advertising_report_two_reports_element_by_element()
    // A SCAN_RSP with no data and RSSI not available, then an
    // ADV_NONCONN_IND from public address 66:55:44:33:22:11 with two
    // octets of data, laid out report by report.
    let evt: [u8] = [0x3E, 0x18, 0x02, 0x02,
                     0x04, 0x01, 0x11, 0x22, 0x33, 0x44, 0x55, 0xC6, 0x00, 0x7F,
                     0x03, 0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x02, 0xAA, 0xBB, 0xD0]
    match le_advertising_reports(evt)
        None    => test.fail("two reports decode")
        Some(r) =>
            test.assert_eq(list.len(r), 2)
            test.assert_eq(r[0].event_type, ADV_REPORT_SCAN_RSP)
            test.assert_eq(list.len(r[0].data), 0)
            test.assert_eq(r[0].rssi, ADV_REPORT_RSSI_NOT_AVAILABLE)
            test.assert_eq(r[1].event_type, ADV_REPORT_ADV_NONCONN_IND)
            test.assert_eq(r[1].address_type, 0x00)
            test.assert_eq(r[1].address[5] as Int, 0x66)
            test.assert_eq(r[1].data[0] as Int, 0xAA)
            test.assert_eq(r[1].data[1] as Int, 0xBB)
            test.assert_eq(r[1].rssi, 0xD0)

@test
fn test_le_advertising_report_refusals()
    // Another subevent, a Command Complete, a length that disagrees,
    // Num_Reports 0, a Data_Length past the end and one over 31.
    let conn: [u8] = [0x3E, 0x03, 0x01, 0x00, 0x00]
    test.assert(le_advertising_reports(conn) == None)
    let cc: [u8] = [0x0E, 0x04, 0x01, 0x03, 0x0C, 0x00]
    test.assert(le_advertising_reports(cc) == None)
    var wrong_total = one_report_event()[:]
    wrong_total[1] = 0x10
    test.assert(le_advertising_reports(wrong_total) == None)
    let none: [u8] = [0x3E, 0x02, 0x02, 0x00]
    test.assert(le_advertising_reports(none) == None)
    var overrun = one_report_event()[:]
    overrun[12] = 0x05
    test.assert(le_advertising_reports(overrun) == None)
    var too_long: [u8] = [0x3E, 0x2D, 0x02, 0x01, 0x00, 0x01, 0x11, 0x22, 0x33, 0x44, 0x55, 0xC6, 0x20]
    for _ in 0..32
        list.push(too_long, 0x00)
    list.push(too_long, 0xC4)
    test.assert(le_advertising_reports(too_long) == None)

@test
fn test_le_connection_complete_fields()
    match le_connection_complete(connection_complete_event())
        None    => test.fail("the event decodes")
        Some(c) =>
            test.assert_eq(c.status, 0)
            test.assert_eq(c.connection_handle, 0x0040)
            test.assert_eq(c.role, CONNECTION_ROLE_PERIPHERAL)
            test.assert_eq(c.peer_address_type, 0x00)
            test.assert_eq(c.peer_address[0] as Int, 0x11)
            test.assert_eq(c.peer_address[5] as Int, 0x66)
            test.assert_eq(c.connection_interval, 0x0028)
            test.assert_eq(c.peripheral_latency, 0)
            test.assert_eq(c.supervision_timeout, 0x01F4)

@test
fn test_le_enhanced_connection_complete_skips_the_private_addresses()
    var evt: [u8] = [0x3E, 0x1F, 0x0A, 0x00, 0x41, 0x00, 0x01, 0x01,
                     0x11, 0x22, 0x33, 0x44, 0x55, 0xC6]
    for _ in 0..12
        list.push(evt, 0xEE)
    list.append(evt, [0x18, 0x00, 0x02, 0x00, 0x48, 0x00, 0x00])
    match le_connection_complete(evt)
        None    => test.fail("the enhanced event decodes")
        Some(c) =>
            test.assert_eq(c.connection_handle, 0x0041)
            test.assert_eq(c.peer_address_type, 0x01)
            test.assert_eq(c.peer_address[5] as Int, 0xC6)
            test.assert_eq(c.connection_interval, 0x0018)
            test.assert_eq(c.peripheral_latency, 2)
            test.assert_eq(c.supervision_timeout, 0x0048)

@test
fn test_le_connection_complete_refusals()
    // An advertising report, a length that disagrees, a short event.
    test.assert(le_connection_complete(one_report_event()) == None)
    var wrong_total = connection_complete_event()[:]
    wrong_total[1] = 0x12
    test.assert(le_connection_complete(wrong_total) == None)
    test.assert(le_connection_complete(connection_complete_event()[0:20]) == None)

@test
fn test_disconnection_complete_fields()
    // Status 0, Connection_Handle 0x0040, Reason 0x16 Connection
    // Terminated By Local Host.
    let evt: [u8] = [0x05, 0x04, 0x00, 0x40, 0x00, 0x16]
    match disconnection_complete(evt)
        None    => test.fail("the event decodes")
        Some(d) =>
            test.assert_eq(d.status, 0)
            test.assert_eq(d.connection_handle, 0x0040)
            test.assert_eq(d.reason, 0x16)
    test.assert(disconnection_complete(connection_complete_event()) == None)
    test.assert(disconnection_complete(evt[0:5]) == None)

@test
fn test_acl_data_packet_fields()
    // Connection_Handle 0x0040, Packet_Boundary_Flag 0b10, 3 octets.
    let pkt: [u8] = [0x40, 0x20, 0x03, 0x00, 0xAA, 0xBB, 0xCC]
    match acl_data_packet(pkt)
        None    => test.fail("the packet decodes")
        Some(a) =>
            test.assert_eq(a.connection_handle, 0x0040)
            test.assert_eq(a.packet_boundary, ACL_PB_FIRST_FLUSHABLE)
            test.assert_eq(a.broadcast, 0)
            test.assert_eq(list.len(a.data), 3)
            test.assert_eq(a.data[2] as Int, 0xCC)
    // A Data_Total_Length that disagrees, and a short header.
    test.assert(acl_data_packet(pkt[0:6]) == None)
    test.assert(acl_data_packet(pkt[0:3]) == None)

@test
fn test_build_h4_acl_layout()
    let pkt = build_h4_acl(0x0A41, ACL_PB_CONTINUING, [0x01, 0x02])
    let want: [u8] = [0x02, 0x41, 0x1A, 0x02, 0x00, 0x01, 0x02]
    test.assert_eq(list.len(pkt), list.len(want))
    for i in 0..list.len(want)
        test.assert_eq(pkt[i] as Int, want[i] as Int)
    // The packet decodes back.
    match acl_data_packet(pkt[1:])
        None    => test.fail("round trip")
        Some(a) =>
            test.assert_eq(a.connection_handle, 0x0A41)
            test.assert_eq(a.packet_boundary, ACL_PB_CONTINUING)

@test
fn test_number_of_completed_packets_pairs()
    // Two handles, element by element.
    let evt: [u8] = [0x13, 0x09, 0x02, 0x40, 0x00, 0x02, 0x00, 0x41, 0x00, 0x01, 0x00]
    match number_of_completed_packets(evt)
        None        => test.fail("the event decodes")
        Some(pairs) =>
            test.assert_eq(list.len(pairs), 2)
            test.assert_eq(pairs[0].connection_handle, 0x0040)
            test.assert_eq(pairs[0].count, 2)
            test.assert_eq(pairs[1].connection_handle, 0x0041)
            test.assert_eq(pairs[1].count, 1)
    test.assert(number_of_completed_packets(evt[0:10]) == None)
    test.assert(number_of_completed_packets(connection_complete_event()) == None)

@test
fn test_le_connection_update_complete_fields()
    let evt: [u8] = [0x3E, 0x0A, 0x03, 0x00, 0x40, 0x00, 0x32, 0x00, 0x01, 0x00, 0xF4, 0x01]
    match le_connection_update_complete(evt)
        None    => test.fail("the event decodes")
        Some(u) =>
            test.assert_eq(u.status, 0)
            test.assert_eq(u.connection_handle, 0x0040)
            test.assert_eq(u.connection_interval, 0x0032)
            test.assert_eq(u.peripheral_latency, 1)
            test.assert_eq(u.supervision_timeout, 0x01F4)
    test.assert(le_connection_update_complete(evt[0:11]) == None)
    test.assert(le_connection_update_complete(connection_complete_event()) == None)

@test
fn test_le_remote_connection_parameter_request_fields()
    let evt: [u8] = [0x3E, 0x0B, 0x06, 0x40, 0x00, 0x32, 0x00, 0x46, 0x00, 0x01, 0x00, 0xF4, 0x01]
    match le_remote_connection_parameter_request(evt)
        None    => test.fail("the event decodes")
        Some(r) =>
            test.assert_eq(r.connection_handle, 0x0040)
            test.assert_eq(r.interval_min, 0x0032)
            test.assert_eq(r.interval_max, 0x0046)
            test.assert_eq(r.max_latency, 1)
            test.assert_eq(r.timeout, 0x01F4)
    test.assert(le_remote_connection_parameter_request(evt[0:12]) == None)

@test
fn test_le_long_term_key_request_and_encryption_events()
    let evt: [u8] = [0x3E, 0x0D, 0x05, 0x40, 0x00, 1, 2, 3, 4, 5, 6, 7, 8, 0x34, 0x12]
    match le_long_term_key_request(evt)
        None    => test.fail("the event decodes")
        Some(r) =>
            test.assert_eq(r.connection_handle, 0x0040)
            test.assert_eq(r.random_number[7] as Int, 8)
            test.assert_eq(r.encrypted_diversifier, 0x1234)
    test.assert(is_encryption_event(evt))
    test.assert(is_encryption_event([0x08, 0x04, 0x00, 0x40, 0x00, 0x01]))
    test.assert(is_encryption_event([0x30, 0x03, 0x00, 0x40, 0x00]))
    test.assert(not is_encryption_event(connection_complete_event()))
    match encryption_change([0x08, 0x04, 0x00, 0x40, 0x00, 0x01])
        None    => test.fail("Encryption Change decodes")
        Some(e) =>
            test.assert_eq(e.connection_handle, 0x0040)
            test.assert(e.enabled)
    match encryption_change([0x08, 0x04, 0x06, 0x40, 0x00, 0x01])
        None    => test.fail("a failed Encryption Change decodes")
        Some(e) =>
            test.assert_eq(e.status, 0x06)
            test.assert(not e.enabled)
    match encryption_change([0x30, 0x03, 0x00, 0x41, 0x00])
        None    => test.fail("Encryption Key Refresh Complete decodes")
        Some(e) =>
            test.assert_eq(e.connection_handle, 0x0041)
            test.assert(e.enabled)
    test.assert(encryption_change(evt) == None)
    test.assert(encryption_change([0x08, 0x03, 0x00, 0x40, 0x00]) == None)

@test
fn test_le_buffer_size_return_parameters()
    match le_buffer_size([0xFB, 0x00, 0x03])
        None    => test.fail("the parameters decode")
        Some(b) =>
            test.assert_eq(b.acl_data_packet_length, 251)
            test.assert_eq(b.total_acl_data_packets, 3)
    test.assert(le_buffer_size([0x1B]) == None)

@test
fn test_periodic_sync_established_decodes()
    // Status 0x00, Sync_Handle 0x0005, SID 0x02, a public advertiser
    // address C0:4E:4F:56:4F:01, LE 1M, 200 units of 1.25 ms, 100 ppm.
    let evt: [u8] = [0x3E, 0x10, 0x0E, 0x00, 0x05, 0x00, 0x02, 0x00,
                     0x01, 0x4F, 0x56, 0x4F, 0x4E, 0xC0, 0x01, 0xC8, 0x00, 0x03]
    match le_periodic_sync_established(evt)
        None    => test.fail("the Sync Established event decodes")
        Some(e) =>
            test.assert_eq(e.status, 0x00)
            test.assert_eq(e.sync_handle, 0x0005)
            test.assert_eq(e.advertising_sid, 0x02)
            test.assert_eq(e.advertiser_phy, 0x01)
            test.assert_eq(e.periodic_interval, 200)
            test.assert_eq(e.advertiser_address[0] as Int, 0x01)
    test.assert(le_periodic_sync_established([0x3E, 0x03, 0x02, 0x01, 0x00, 0x00]) == None)

@test
fn test_periodic_sync_lost_decodes()
    let evt: [u8] = [0x3E, 0x03, 0x10, 0x05, 0x00]
    match le_periodic_sync_lost(evt)
        None    => test.fail("the Sync Lost event decodes")
        Some(e) => test.assert_eq(e.sync_handle, 0x0005)
    // An LE Advertising Report is not one.
    test.assert(le_periodic_sync_lost([0x3E, 0x03, 0x02, 0x01, 0x00]) == None)
    test.assert(le_periodic_sync_lost([0x3E, 0x03, 0x10, 0x05, 0x00]) != None)

@test
fn test_periodic_report_decodes_its_data()
    // Sync_Handle 0x0005, TX_Power 0x7F (none), RSSI 0xBF, CTE_Type
    // 0xFF, Data_Status Complete and the three octets of one AD record.
    let evt: [u8] = [0x3E, 0x0B, 0x0F, 0x05, 0x00, 0x7F, 0xBF, 0xFF,
                     0x00, 0x03, 0x02, 0x01, 0x06]
    match le_periodic_advertising_report(evt)
        None    => test.fail("the Periodic Advertising Report decodes")
        Some(r) =>
            test.assert_eq(r.sync_handle, 0x0005)
            test.assert_eq(r.cte_type, 0xFF)
            test.assert_eq(r.data_status, PERIODIC_DATA_COMPLETE)
            test.assert_eq(list.len(r.data), 3)
            test.assert_eq(r.data[2] as Int, 0x06)
    // A Data_Length longer than the event carries is not a report.
    let short: [u8] = [0x3E, 0x0B, 0x0F, 0x05, 0x00, 0x7F, 0xBF, 0xFF, 0x00, 0x09, 0x02, 0x01]
    test.assert(le_periodic_advertising_report(short) == None)
    // A report with no data at all is one too.
    let empty: [u8] = [0x3E, 0x08, 0x0F, 0x05, 0x00, 0x7F, 0xBF, 0xFF, 0x00, 0x00]
    match le_periodic_advertising_report(empty)
        None    => test.fail("a report with no data decodes")
        Some(r) => test.assert_eq(list.len(r.data), 0)

@test
fn test_periodic_sync_transfer_received_decodes()
    let evt: [u8] = [0x3E, 0x14, 0x18, 0x00, 0x41, 0x0E, 0x34, 0x12,
                     0x05, 0x00, 0x02, 0x00,
