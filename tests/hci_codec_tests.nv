        Some(t) =>
            test.assert_eq(t.status, 0x00)
            test.assert_eq(t.connection_handle, 0x0E41)
            test.assert_eq(t.service_data, 0x1234)
            test.assert_eq(t.sync_handle, 0x0005)
            test.assert_eq(t.advertiser_address_type, 0x00)
            test.assert_eq(t.advertiser_address[0] as Int, 0x01)
    test.assert(le_periodic_sync_transfer_received([0x3E, 0x03, 0x01, 0x00, 0x00, 0x00]) == None)

@test
fn test_pawr_subevent_data_request_decodes()
    // Advertising_Handle 0x00, Subevent_Start 0x07, Subevent_Data_Count
    // 0x03: the shape the rig's SoftDevice Controller sends, which asks
    // for three subevents at a time whatever the train's subevent count.
    let evt: [u8] = [0x3E, 0x04, 0x27, 0x00, 0x07, 0x03]
    match le_periodic_advertising_subevent_data_request(evt)
        None    => test.fail("the Subevent Data Request decodes")
        Some(r) =>
            test.assert_eq(r.advertising_handle, 0x00)
            test.assert_eq(r.subevent_start, 0x07)
            test.assert_eq(r.subevent_data_count, 0x03)
    // Another LE Meta event is not one, and neither is a request cut
    // short of its three parameters.
    test.assert(le_periodic_advertising_subevent_data_request([0x3E, 0x04, 0x0F, 0x00, 0x07, 0x03]) == None)
    test.assert(le_periodic_advertising_subevent_data_request([0x3E, 0x03, 0x27, 0x00, 0x07]) == None)

@test
fn test_pawr_response_report_decodes()
    // Advertising_Handle 0x00, Subevent 0x02, TX_Status Success, two
    // responses: slot 0 with the three-octet AD record 02 01 06, and slot
    // 3 with no data at all.
    let evt: [u8] = [0x3E, 0x11, 0x28, 0x00, 0x02, 0x00, 0x02,
                     0x7F, 0xBF, 0xFF, 0x00, 0x00, 0x03, 0x02, 0x01, 0x06,
                     0x7F, 0xBE, 0xFF, 0x03, 0x00, 0x00]
    match le_periodic_advertising_response_report(evt)
        None    => test.fail("the Response Report decodes")
        Some(r) =>
            test.assert_eq(r.advertising_handle, 0x00)
            test.assert_eq(r.subevent, 0x02)
            test.assert_eq(r.tx_status, PAWR_TX_STATUS_SUCCESS)
            test.assert_eq(list.len(r.responses), 2)
            test.assert_eq(r.responses[0].response_slot, 0x00)
            test.assert_eq(r.responses[0].data_status, PERIODIC_DATA_COMPLETE)
            test.assert_eq(list.len(r.responses[0].data), 3)
            test.assert_eq(r.responses[0].data[2] as Int, 0x06)
            test.assert_eq(r.responses[1].response_slot, 0x03)
            test.assert_eq(list.len(r.responses[1].data), 0)
    // A failure report carries Tx_Status 0x01 and no response.
    let failed: [u8] = [0x3E, 0x05, 0x28, 0x00, 0x02, 0x01, 0x00]
    match le_periodic_advertising_response_report(failed)
        None    => test.fail("a failure report decodes too")
        Some(r) =>
            test.assert_eq(r.tx_status, PAWR_TX_STATUS_FAILED)
            test.assert_eq(list.len(r.responses), 0)
    // A Num_Responses the event cannot hold is not a report.
    let short: [u8] = [0x3E, 0x06, 0x28, 0x00, 0x02, 0x00, 0x01, 0x7F]
    test.assert(le_periodic_advertising_response_report(short) == None)

@test
@satisfies("REQ-BLE-HCI-057")
