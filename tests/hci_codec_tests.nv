    test.assert(iso_group_id_return([0x07, 0x00]) == None)

@test
@satisfies("REQ-BLE-HCI-057")
fn test_iso_test_counters_and_link_quality_returns()
    let c: [u8] = [0x41, 0x00, 0x01, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x80]
    match iso_test_counters(c)
        None    => test.fail("fourteen octets decode")
        Some(t) =>
            test.assert_eq(t.connection_handle, 0x0041)
            test.assert_eq(t.received_sdu_count, 1)
            test.assert_eq(t.missed_sdu_count, 2)
            test.assert_eq(t.failed_sdu_count, 0x80000003)
    test.assert(iso_test_counters(c[0:13]) == None)
    var q: [u8] = [0x41, 0x00]
    for i in 1..8
        list.append(q, [i as u8, 0x00, 0x00, 0x00])
    match iso_link_quality(q)
        None    => test.fail("thirty octets decode")
        Some(l) =>
            test.assert_eq(l.connection_handle, 0x0041)
            test.assert_eq(l.tx_unacked_packets, 1)
            test.assert_eq(l.tx_flushed_packets, 2)
            test.assert_eq(l.tx_last_subevent_packets, 3)
            test.assert_eq(l.retransmitted_packets, 4)
            test.assert_eq(l.crc_error_packets, 5)
            test.assert_eq(l.rx_unreceived_packets, 6)
            test.assert_eq(l.duplicate_packets, 7)
    test.assert(iso_link_quality(q[0:29]) == None)

@test
@satisfies("REQ-BLE-HCI-058")
fn test_le_cis_established_v1_decodes()
    let evt = le_meta_event(LE_SUBEVENT_CIS_ESTABLISHED, cis_established_v1_params())
    test.assert_eq(list.len(evt), CIS_ESTABLISHED_LENGTH)
    match le_cis_established(evt)
        None    => test.fail("the [v1] event decodes")
        Some(e) =>
            test.assert(not e.v2)
            test.assert_eq(e.status, 0)
            // Connection_Handle is 12 bits: 0x1F42 reads 0x0F42.
            test.assert_eq(e.connection_handle, 0x0F42)
            test.assert_eq(e.cig_sync_delay, 0x030201)
            test.assert_eq(e.cis_sync_delay, 0x060504)
            test.assert_eq(e.transport_latency_c_to_p, 0x090807)
            test.assert_eq(e.transport_latency_p_to_c, 0x0C0B0A)
            test.assert_eq(e.phy_c_to_p, 1)
            test.assert_eq(e.phy_p_to_c, 2)
            test.assert_eq(e.nse, 4)
            test.assert_eq(e.bn_c_to_p, 3)
            test.assert_eq(e.bn_p_to_c, 2)
            test.assert_eq(e.ft_c_to_p, 5)
            test.assert_eq(e.ft_p_to_c, 6)
            test.assert_eq(e.max_pdu_c_to_p, 0x1110)
            test.assert_eq(e.max_pdu_p_to_c, 0x1312)
            test.assert_eq(e.iso_interval, 0x1514)
            test.assert_eq(e.framing, 0)
            test.assert_eq(e.sdu_interval_p_to_c, 0)
    // One octet short and one long, and the other subevent.
    test.assert(le_cis_established(le_meta_event(LE_SUBEVENT_CIS_ESTABLISHED, cis_established_v1_params()[0:27])) == None)
    var long = cis_established_v1_params()
    list.push(long, 0x00)
    test.assert(le_cis_established(le_meta_event(LE_SUBEVENT_CIS_ESTABLISHED, long)) == None)
    test.assert(le_cis_established(le_meta_event(LE_SUBEVENT_CIS_REQUEST, cis_established_v1_params())) == None)

@test
@satisfies("REQ-BLE-HCI-058")
fn test_le_cis_established_v2_decodes()
    var params = cis_established_v1_params()
    list.append(params, [0x21, 0x22, 0x23, 0x31, 0x32, 0x41, 0x42, 0x51, 0x52, 0x53, 0x61, 0x62, 0x63, 0x02])
    let evt = le_meta_event(LE_SUBEVENT_CIS_ESTABLISHED_V2, params)
    test.assert_eq(list.len(evt), CIS_ESTABLISHED_V2_LENGTH)
    match le_cis_established(evt)
        None    => test.fail("the [v2] event decodes")
        Some(e) =>
            test.assert(e.v2)
            test.assert_eq(e.iso_interval, 0x1514)
            test.assert_eq(e.sub_interval, 0x232221)
            test.assert_eq(e.max_sdu_c_to_p, 0x3231)
            test.assert_eq(e.max_sdu_p_to_c, 0x4241)
            test.assert_eq(e.sdu_interval_c_to_p, 0x535251)
            test.assert_eq(e.sdu_interval_p_to_c, 0x636261)
            test.assert_eq(e.framing, 2)
    // The [v2] parameters under the [v1] subevent are a length mismatch.
    test.assert(le_cis_established(le_meta_event(LE_SUBEVENT_CIS_ESTABLISHED, params)) == None)
    test.assert(le_cis_established(le_meta_event(LE_SUBEVENT_CIS_ESTABLISHED_V2, params[0:30])) == None)

@test
@satisfies("REQ-BLE-HCI-058")
fn test_le_cis_request_decodes()
    let evt = le_meta_event(LE_SUBEVENT_CIS_REQUEST, [0x01, 0xF0, 0x30, 0x80, 0x07, 0x09])
    match le_cis_request(evt)
        None    => test.fail("the event decodes")
        Some(r) =>
            test.assert_eq(r.acl_connection_handle, 0x0001)
            test.assert_eq(r.cis_connection_handle, 0x0030)
            test.assert_eq(r.cig_id, 7)
