    test.assert(le_cis_request(le_meta_event(LE_SUBEVENT_CIS_ESTABLISHED, [0x01, 0xF0, 0x30, 0x80, 0x07, 0x09])) == None)
    test.assert(le_cis_request([0x05, 0x04, 0x00, 0x01, 0x00, 0x13]) == None)

@test
@satisfies("REQ-BLE-HCI-058")
fn test_le_create_big_complete_decodes_one_and_three_bis()
    match le_create_big_complete(le_meta_event(LE_SUBEVENT_CREATE_BIG_COMPLETE, create_big_complete_params([0x0040])))
        None    => test.fail("one BIS decodes")
        Some(e) =>
            test.assert_eq(e.status, 0)
            test.assert_eq(e.big_handle, 3)
            test.assert_eq(e.big_sync_delay, 0x030201)
            test.assert_eq(e.transport_latency_big, 0x060504)
            test.assert_eq(e.phy, 2)
            test.assert_eq(e.nse, 3)
            test.assert_eq(e.bn, 4)
            test.assert_eq(e.pto, 5)
            test.assert_eq(e.irc, 6)
            test.assert_eq(e.max_pdu, 0x1110)
            test.assert_eq(e.iso_interval, 0x1312)
            test.assert_eq(list.len(e.connection_handles), 1)
            test.assert_eq(e.connection_handles[0], 0x0040)
    match le_create_big_complete(le_meta_event(LE_SUBEVENT_CREATE_BIG_COMPLETE, create_big_complete_params([0x0040, 0x0041, 0xF042])))
        None    => test.fail("three BIS decode")
        Some(e) =>
            test.assert_eq(list.len(e.connection_handles), 3)
            test.assert_eq(e.connection_handles[1], 0x0041)
            // 12 bits meaningful.
            test.assert_eq(e.connection_handles[2], 0x0042)
    // Num_BIS says 3, the event holds 2; and the event is cut inside its fixed part.
    var wrong = create_big_complete_params([0x0040, 0x0041])
    wrong[17] = 0x03
    test.assert(le_create_big_complete(le_meta_event(LE_SUBEVENT_CREATE_BIG_COMPLETE, wrong)) == None)
    test.assert(le_create_big_complete(le_meta_event(LE_SUBEVENT_CREATE_BIG_COMPLETE, [0x00, 0x03])) == None)
    test.assert(le_create_big_complete(le_meta_event(LE_SUBEVENT_BIG_SYNC_ESTABLISHED, create_big_complete_params([0x0040]))) == None)

@test
@satisfies("REQ-BLE-HCI-058")
fn test_le_terminate_big_complete_and_sync_lost_decode()
    match le_terminate_big_complete(le_meta_event(LE_SUBEVENT_TERMINATE_BIG_COMPLETE, [0x02, 0x16]))
        None    => test.fail("the event decodes")
        Some(e) =>
            test.assert_eq(e.big_handle, 2)
            test.assert_eq(e.reason, 0x16)
    match le_big_sync_lost(le_meta_event(LE_SUBEVENT_BIG_SYNC_LOST, [0x01, 0x08]))
        None    => test.fail("the event decodes")
        Some(e) =>
            test.assert_eq(e.big_handle, 1)
            test.assert_eq(e.reason, 0x08)
    // Each refuses the other's subevent and a wrong length.
    test.assert(le_terminate_big_complete(le_meta_event(LE_SUBEVENT_BIG_SYNC_LOST, [0x01, 0x08])) == None)
    test.assert(le_big_sync_lost(le_meta_event(LE_SUBEVENT_TERMINATE_BIG_COMPLETE, [0x01, 0x08])) == None)
    test.assert(le_big_sync_lost(le_meta_event(LE_SUBEVENT_BIG_SYNC_LOST, [0x01])) == None)
    test.assert(le_terminate_big_complete(le_meta_event(LE_SUBEVENT_TERMINATE_BIG_COMPLETE, [0x01, 0x08, 0x00])) == None)

@test
@satisfies("REQ-BLE-HCI-058")
fn test_le_big_sync_established_decodes_one_and_three_bis()
    match le_big_sync_established(le_meta_event(LE_SUBEVENT_BIG_SYNC_ESTABLISHED, big_sync_established_params([0x0050])))
        None    => test.fail("one BIS decodes")
        Some(e) =>
            test.assert_eq(e.status, 0)
            test.assert_eq(e.big_handle, 1)
            test.assert_eq(e.transport_latency_big, 0x0C0B0A)
            test.assert_eq(e.nse, 2)
            test.assert_eq(e.bn, 3)
            test.assert_eq(e.pto, 4)
            test.assert_eq(e.irc, 5)
            test.assert_eq(e.max_pdu, 0x2120)
            test.assert_eq(e.iso_interval, 0x2322)
            test.assert_eq(list.len(e.connection_handles), 1)
            test.assert_eq(e.connection_handles[0], 0x0050)
    match le_big_sync_established(le_meta_event(LE_SUBEVENT_BIG_SYNC_ESTABLISHED, big_sync_established_params([0x0050, 0x0051, 0x0052])))
        None    => test.fail("three BIS decode")
        Some(e) =>
            test.assert_eq(list.len(e.connection_handles), 3)
            test.assert_eq(e.connection_handles[2], 0x0052)
    var wrong = big_sync_established_params([0x0050])
    wrong[13] = 0x02
    test.assert(le_big_sync_established(le_meta_event(LE_SUBEVENT_BIG_SYNC_ESTABLISHED, wrong)) == None)
    test.assert(le_big_sync_established(le_meta_event(LE_SUBEVENT_BIG_SYNC_ESTABLISHED, [0x00])) == None)

@test
@satisfies("REQ-BLE-HCI-058")
fn test_le_big_info_advertising_report_decodes()
    let params: [u8] = [0x34,
        0xF2,
        0x02,
        0x03,
        0x08,
        0x00,
        0x02,
        0x01,
        0x03,
        0x64,
        0x00,
        0x10,
        0x27,
        0x00,
        0x64,
        0x00,
        0x02,
        0x01,
        0x01]
    match le_big_info_advertising_report(le_meta_event(LE_SUBEVENT_BIG_INFO_ADVERTISING_REPORT, params))
        None    => test.fail("the report decodes")
        Some(r) =>
            test.assert_eq(r.sync_handle, 0x0234)
            test.assert_eq(r.num_bis, 2)
            test.assert_eq(r.nse, 3)
            test.assert_eq(r.iso_interval, 8)
            test.assert_eq(r.bn, 2)
            test.assert_eq(r.pto, 1)
            test.assert_eq(r.irc, 3)
            test.assert_eq(r.max_pdu, 100)
            test.assert_eq(r.sdu_interval, 10000)
            test.assert_eq(r.max_sdu, 100)
            test.assert_eq(r.phy, 2)
            test.assert_eq(r.framing, 1)
            test.assert(r.encryption)
    var clear = params[:]
    clear[18] = 0x00
    match le_big_info_advertising_report(le_meta_event(LE_SUBEVENT_BIG_INFO_ADVERTISING_REPORT, clear))
        None    => test.fail("an unencrypted report decodes")
        Some(r) => test.assert(not r.encryption)
    test.assert(le_big_info_advertising_report(le_meta_event(LE_SUBEVENT_BIG_INFO_ADVERTISING_REPORT, params[0:18])) == None)
    test.assert(le_big_info_advertising_report(le_meta_event(LE_SUBEVENT_BIG_SYNC_LOST, params)) == None)

@test
@satisfies("REQ-BLE-HCI-058")
fn test_iso_event_shape_refuses_other_events()
    // An event that is not an LE Meta event, and an empty one.
    test.assert(not iso_event_shape([0x05, 0x04, 0x00, 0x01, 0x00, 0x13], 0x1A, 6))
    test.assert(not iso_event_shape([], 0x1A, 0))
    // Parameter_Total_Length that disagrees with the packet.
    test.assert(not iso_event_shape([0x3E, 0x09, 0x1A, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00], 0x1A, 9))

@test
@satisfies("REQ-BLE-ISO-001")
fn test_build_iso_data_packet_complete_sdu_without_time_stamp()
    // Handle 0x0123, PB 0b10, TS 0: octets 0x23 and 0x01 | 0x20.  The load
    // is Packet_Sequence_Number 0x0007, ISO_SDU_Length 3 and three octets.
    match build_iso_data_packet(iso_sdu_packet(0x0123, ISO_PB_COMPLETE_SDU, None, 7, 3, 0, [0xAA, 0xBB, 0xCC]))
        None    => test.fail("the packet fits")
        Some(p) =>
            let want: [u8] = [0x23, 0x21, 0x07, 0x00, 0x07, 0x00, 0x03, 0x00, 0xAA, 0xBB, 0xCC]
            test.assert_eq(list.len(p), list.len(want))
            for i in 0..list.len(want)
                test.assert_eq(p[i] as Int, want[i] as Int)

@test
@satisfies("REQ-BLE-ISO-001")
fn test_build_iso_data_packet_time_stamp_and_status()
    // TS_Flag adds bit 6 of the second octet and four octets of
    // Time_Stamp; Packet_Status_Flag 0b10 lands in bits 14 and 15 of the
    // word that holds ISO_SDU_Length.
    match build_iso_data_packet(iso_sdu_packet(0x0040, ISO_PB_COMPLETE_SDU, Some(0x01020304), 0x1234, 0, ISO_PSF_LOST, []))
        None    => test.fail("the packet fits")
        Some(p) =>
            let want: [u8] = [0x40, 0x60, 0x08, 0x00, 0x04, 0x03, 0x02, 0x01, 0x34, 0x12, 0x00, 0x80]
            test.assert_eq(list.len(p), list.len(want))
            for i in 0..list.len(want)
                test.assert_eq(p[i] as Int, want[i] as Int)
    match build_h4_iso(iso_sdu_packet(0x0040, ISO_PB_FIRST_FRAGMENT, None, 1, 300, 0, [0x11, 0x22]))
        None    => test.fail("the packet fits")
        Some(p) =>
            // HCI packet indicator, PB 0b00, Data_Total_Length 6, then the
            // SDU header: ISO_SDU_Length 300 = 0x012C.
            let want: [u8] = [0x05, 0x40, 0x00, 0x06, 0x00, 0x01, 0x00, 0x2C, 0x01, 0x11, 0x22]
            test.assert_eq(list.len(p), list.len(want))
            for i in 0..list.len(want)
                test.assert_eq(p[i] as Int, want[i] as Int)

@test
@satisfies("REQ-BLE-ISO-001")
fn test_build_iso_data_packet_fragments_carry_no_sdu_header()
    match build_iso_data_packet(iso_fragment(0x0040, ISO_PB_INTERMEDIATE_FRAGMENT, [0x01, 0x02, 0x03]))
        None    => test.fail("the fragment fits")
        Some(p) =>
            let want: [u8] = [0x40, 0x10, 0x03, 0x00, 0x01, 0x02, 0x03]
            test.assert_eq(list.len(p), list.len(want))
            for i in 0..list.len(want)
                test.assert_eq(p[i] as Int, want[i] as Int)
    match build_iso_data_packet(iso_fragment(0x0040, ISO_PB_LAST_FRAGMENT, []))
        None    => test.fail("an empty last fragment fits")
        Some(p) =>
            test.assert_eq(list.len(p), 4)
            test.assert_eq(p[1] as Int, 0x30)

@test
@satisfies("REQ-BLE-ISO-001")
fn test_build_iso_data_packet_refuses_what_does_not_fit()
    let data: [u8] = [0x00]
    // A handle above 0x0EFF, a PB_Flag above 3, an ISO_SDU_Length above
    // 0x0FFF, a Packet_Status_Flag above 3.
    test.assert(build_iso_data_packet(iso_sdu_packet(0x0F00, ISO_PB_COMPLETE_SDU, None, 0, 1, 0, data)) == None)
    test.assert(build_iso_data_packet(iso_sdu_packet(0x0001, 4, None, 0, 1, 0, data)) == None)
    test.assert(build_iso_data_packet(iso_sdu_packet(0x0001, ISO_PB_COMPLETE_SDU, None, 0, 0x1000, 0, data)) == None)
    test.assert(build_iso_data_packet(iso_sdu_packet(0x0001, ISO_PB_COMPLETE_SDU, None, 0, 1, 4, data)) == None)
    // Packet_Sequence_Number is 16 bits and Time_Stamp 32 ([Vol 4] Part E,
    // Section 5.4.5): the widest values fit, one more bit does not.
    test.assert(build_iso_data_packet(iso_sdu_packet(0x0001, ISO_PB_COMPLETE_SDU, None, 0xFFFF, 1, 0, data)) != None)
    test.assert(build_iso_data_packet(iso_sdu_packet(0x0001, ISO_PB_COMPLETE_SDU, None, 0x10000, 1, 0, data)) == None)
    test.assert(build_iso_data_packet(iso_sdu_packet(0x0001, ISO_PB_COMPLETE_SDU, None, -1, 1, 0, data)) == None)
    test.assert(build_iso_data_packet(iso_sdu_packet(0x0001, ISO_PB_COMPLETE_SDU, Some(0xFFFFFFFF), 0, 1, 0, data)) != None)
    test.assert(build_iso_data_packet(iso_sdu_packet(0x0001, ISO_PB_COMPLETE_SDU, Some(0x100000000), 0, 1, 0, data)) == None)
    // A fragment with a Time_Stamp has nowhere to put it.
    let ts = IsoDataPacket {
        connection_handle: 0x0001, pb_flag: ISO_PB_LAST_FRAGMENT, has_sdu_header: false, has_time_stamp: true,
        time_stamp: 1, packet_sequence_number: 0, iso_sdu_length: 0, packet_status: 0, data: data }
    test.assert(build_iso_data_packet(ts) == None)
    // Data_Total_Length is 14 bits: 0x3FFF octets fit a fragment, one more does not.
    var big: [u8] = []
    for _ in 0..0x3FFF
        list.push(big, 0x00)
    match build_iso_data_packet(iso_fragment(0x0001, ISO_PB_INTERMEDIATE_FRAGMENT, big))
        None    => test.fail("0x3FFF octets fit")
        Some(p) =>
            test.assert_eq(p[2] as Int, 0xFF)
            test.assert_eq(p[3] as Int, 0x3F)
    list.push(big, 0x00)
    test.assert(build_iso_data_packet(iso_fragment(0x0001, ISO_PB_INTERMEDIATE_FRAGMENT, big)) == None)

@test
@satisfies("REQ-BLE-ISO-001")
fn test_iso_data_packet_round_trip()
    let sdus = [iso_sdu_packet(0x0123, ISO_PB_COMPLETE_SDU, None, 7, 3, ISO_PSF_VALID, [0xAA, 0xBB, 0xCC]),
                iso_sdu_packet(0x0040, ISO_PB_COMPLETE_SDU, Some(0xDEADBEEF), 0xFFFF, 0, ISO_PSF_LOST, []),
                iso_sdu_packet(0x0EFF, ISO_PB_FIRST_FRAGMENT, Some(1), 2, 0x0FFF, ISO_PSF_POSSIBLY_INVALID, [0x01]),
                iso_fragment(0x0001, ISO_PB_INTERMEDIATE_FRAGMENT, [0x09, 0x08]),
                iso_fragment(0x0001, ISO_PB_LAST_FRAGMENT, [])]
    for want in sdus
        match build_iso_data_packet(want)
            None       => test.fail("the packet builds")
            Some(wire) =>
                match iso_data_packet(wire)
                    None      => test.fail("the packet parses")
                    Some(got) =>
                        test.assert_eq(got.connection_handle, want.connection_handle)
                        test.assert_eq(got.pb_flag, want.pb_flag)
                        test.assert_eq(got.has_sdu_header, want.has_sdu_header)
                        test.assert_eq(got.has_time_stamp, want.has_time_stamp)
                        test.assert_eq(got.time_stamp, want.time_stamp)
                        test.assert_eq(got.packet_sequence_number, want.packet_sequence_number)
                        test.assert_eq(got.iso_sdu_length, want.iso_sdu_length)
                        test.assert_eq(got.packet_status, want.packet_status)
                        test.assert_eq(list.len(got.data), list.len(want.data))
                        for i in 0..list.len(want.data)
                            test.assert_eq(got.data[i] as Int, want.data[i] as Int)

@test
@satisfies("REQ-BLE-ISO-001")
fn test_iso_data_packet_refusals()
    // Shorter than the header, and a Data_Total_Length that disagrees.
    test.assert(iso_data_packet([0x40, 0x20, 0x00]) == None)
    test.assert(iso_data_packet([0x40, 0x20, 0x05, 0x00, 0x01, 0x00, 0x00, 0x00]) == None)
    test.assert(iso_data_packet([0x40, 0x20, 0x02, 0x00, 0x01, 0x00, 0x00, 0x00]) == None)
    // A packet with the SDU header and fewer than four octets of load, and
    // fewer than eight with TS_Flag.
    test.assert(iso_data_packet([0x40, 0x20, 0x03, 0x00, 0x01, 0x00, 0x00]) == None)
    test.assert(iso_data_packet([0x40, 0x60, 0x07, 0x00, 0x01, 0x02, 0x03, 0x04, 0x01, 0x00, 0x00]) == None)
    // A last fragment with TS_Flag set.
    test.assert(iso_data_packet([0x40, 0x70, 0x01, 0x00, 0xAA]) == None)
    // The reserved bit above TS_Flag and the reserved bits above
    // Data_Total_Length are ignored.
    match iso_data_packet([0x40, 0xA0, 0x04, 0xC0, 0x01, 0x00, 0x00, 0x00])
        None    => test.fail("reserved bits are ignored")
        Some(p) =>
            test.assert_eq(p.pb_flag, ISO_PB_COMPLETE_SDU)
            test.assert_eq(list.len(p.data), 0)
