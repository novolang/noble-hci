@test
@satisfies("REQ-BLE-HCI-057")
fn test_le_set_cig_parameters_return_handles()
    match le_set_cig_parameters_return([0x05, 0x01, 0x30, 0x00])
        None    => test.fail("one handle decodes")
        Some(r) =>
            test.assert_eq(r.cig_id, 5)
            test.assert_eq(list.len(r.connection_handles), 1)
            test.assert_eq(r.connection_handles[0], 0x0030)
    match le_set_cig_parameters_return([0x05, 0x03, 0x30, 0x00, 0x31, 0x00, 0x32, 0xF0])
        None    => test.fail("three handles decode")
        Some(r) =>
            test.assert_eq(list.len(r.connection_handles), 3)
            test.assert_eq(r.connection_handles[1], 0x0031)
            test.assert_eq(r.connection_handles[2], 0x0032)
    // CIS_Count disagrees with the list, and a list shorter than two octets.
    test.assert(le_set_cig_parameters_return([0x05, 0x02, 0x30, 0x00]) == None)
    test.assert(le_set_cig_parameters_return([0x05]) == None)
    match le_set_cig_parameters_return([0x05, 0x00])
        None    => test.fail("no CIS decodes")
        Some(r) => test.assert_eq(list.len(r.connection_handles), 0)

