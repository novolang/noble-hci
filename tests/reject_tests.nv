// tests/reject_tests.nv — what the readers and builders refuse.
//
// A reader answers None, or -1 for a scalar, for an event it does not decode: another event code, another
// subevent code, a buffer too short for the fields, a count or a length that does not add up.  A builder answers
// None for parameters that do not fit the field.  Each case below names the refusal it pins.
//
//   novo test tests/reject_tests.nv

use std.test
use hci_codec
use hci_commands
use bd_addr
use uuid

// A Command Complete event for HCI_Reset: an event code that is not LE Meta.
fn command_complete_event() -> [u8]
    [0x0E, 0x04, 0x01, 0x03, 0x0C, 0x00]

@test
fn test_le_readers_refuse_an_event_that_is_not_le_meta()
    let evt = command_complete_event()
    test.assert(hci_codec.le_periodic_sync_established(evt) == None)
    test.assert(hci_codec.le_periodic_sync_lost(evt) == None)
    test.assert(hci_codec.le_periodic_advertising_report(evt) == None)
    test.assert(hci_codec.le_periodic_sync_transfer_received(evt) == None)
    test.assert(hci_codec.le_periodic_advertising_subevent_data_request(evt) == None)
    test.assert(hci_codec.le_periodic_advertising_response_report(evt) == None)

@test
fn test_periodic_readers_refuse_another_subevent_of_enough_length()
    // Subevent 0x01 (LE Connection Complete) with parameters long enough for every reader below.
    var params: [u8] = []
    for _ in 0..30
        list.push(params, 0x00)
    let evt = hci_codec.le_meta_event(0x01, params)
    test.assert(hci_codec.le_periodic_advertising_report(evt) == None)
    test.assert(hci_codec.le_periodic_advertising_response_report(evt) == None)
    test.assert(hci_codec.le_periodic_sync_established(evt) == None)
    test.assert(hci_codec.le_periodic_sync_lost(evt) == None)
    test.assert(hci_codec.le_periodic_sync_transfer_received(evt) == None)
    test.assert(hci_codec.le_periodic_advertising_subevent_data_request(evt) == None)

@test
fn test_long_term_key_request_refuses_another_subevent()
    var params: [u8] = []
    for _ in 0..12
        list.push(params, 0x00)
    // 13 octets of parameters make a 15-octet event; only the subevent code differs from a real request.
    test.assert_eq(list.len(hci_codec.le_meta_event(0x01, params)), 15)
    test.assert(hci_codec.le_long_term_key_request(hci_codec.le_meta_event(0x01, params)) == None)

@test
fn test_advertising_reports_refuse_a_length_that_does_not_add_up()
    // One report with no data, 14 octets in all, and the length field that says so.
    let one_empty_report: [u8] = [0x3E, 0x0C, 0x02, 0x01, 0x00, 0x01, 0x11, 0x22, 0x33, 0x44, 0x55, 0xC6,
                                          0x00, 0xC4]
    test.assert(hci_codec.le_advertising_reports(one_empty_report) != None)
    // Octets after the last report: Parameter_Total_Length agrees with the packet, the reports do not use all of it.
    let trailing: [u8] = [0x3E, 0x0D, 0x02, 0x01, 0x00, 0x01, 0x11, 0x22, 0x33, 0x44, 0x55, 0xC6,
                          0x00, 0xC4, 0x77]
    test.assert(hci_codec.le_advertising_reports(trailing) == None)
    // Parameter_Total_Length disagrees with the packet.
    let wrong_length: [u8] = [0x3E, 0x0C, 0x02, 0x01, 0x00, 0x01, 0x11, 0x22, 0x33, 0x44, 0x55, 0xC6,
                              0x00, 0xC4, 0x77]
    test.assert(hci_codec.le_advertising_reports(wrong_length) == None)

@test
fn test_response_report_refuses_a_data_length_past_the_end()
    // One response whose header is whole and whose Data_Length of 5 runs past the single octet that follows it.
    let evt: [u8] = [0x3E, 0x0B, 0x28, 0x00, 0x02, 0x00, 0x01, 0x7F, 0xBF, 0xFF, 0x00, 0x00, 0x05, 0x01]
    test.assert(hci_codec.le_periodic_advertising_response_report(evt) == None)

@test
fn test_advertising_reports_refuse_a_num_reports_the_event_cannot_hold()
    // Num_Reports 2 where the packet holds the first report and nothing of the second.
    let evt: [u8] = [0x3E, 0x0C, 0x02, 0x02, 0x00, 0x01, 0x11, 0x22, 0x33, 0x44, 0x55, 0xC6, 0x00, 0xC4]
    test.assert(hci_codec.le_advertising_reports(evt) == None)

@test
fn test_command_status_status_is_minus_one_below_three_octets()
    test.assert_eq(hci_codec.command_status_status([0x0F, 0x04]), -1)
    test.assert_eq(hci_codec.command_status_status([0x0F, 0x04, 0x00]), 0)

@test
fn test_command_status_opcode_is_minus_one_below_six_octets()
    test.assert_eq(hci_codec.command_status_opcode([0x0F, 0x04, 0x00, 0x01, 0x03]), -1)
    test.assert_eq(hci_codec.command_status_opcode([0x0F, 0x04, 0x00, 0x01, 0x03, 0x0C]), 0x0C03)

@test
fn test_build_h4_iso_refuses_what_build_iso_data_packet_refuses()
    // A handle above 0x0EFF does not fit the 12-bit field.
    let p = hci_codec.IsoDataPacket {
        connection_handle: 0x0F00, pb_flag: hci_codec.ISO_PB_LAST_FRAGMENT, has_sdu_header: false,
        has_time_stamp: false, time_stamp: 0, packet_sequence_number: 0, iso_sdu_length: 0, packet_status: 0,
        data: [0x00] }
    test.assert(hci_codec.build_h4_iso(p) == None)

@test
fn test_periodic_advertising_data_refuses_more_than_255_octets()
    var data: [u8] = []
    for _ in 0..255
        list.push(data, 0x00)
    test.assert(hci_commands.build_le_set_periodic_advertising_data(0x00, 0x03, data) != None)
    list.push(data, 0x00)
    test.assert(hci_commands.build_le_set_periodic_advertising_data(0x00, 0x03, data) == None)

@test
fn test_format_bd_addr_prints_every_decimal_digit()
    test.assert_eq(bd_addr.format_bd_addr([0x01, 0x23, 0x45, 0x67, 0x89, 0xAB]), "01:23:45:67:89:AB")

@test
fn test_a_short_uuid_does_not_equal_a_full_one_with_a_set_upper_octet()
    var full = uuid.uuid16_to_128(0x180F)
    test.assert(uuid.uuid_eq_short_full(0x180F, full))
    full[14] = 0x01
    test.assert(not uuid.uuid_eq_short_full(0x180F, full))
    full[14] = 0x00
    full[15] = 0x01
    test.assert(not uuid.uuid_eq_short_full(0x180F, full))
