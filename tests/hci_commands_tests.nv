@test
fn test_build_le_set_scan_parameters_layout()
    // Active scanning, interval 0x0060, window 0x0030, Random Device
    // Address, basic unfiltered policy.
    let p = build_le_set_scan_parameters(LE_SCAN_TYPE_ACTIVE, 0x0060, 0x0030, OWN_ADDR_TYPE_RANDOM, SCAN_FILTER_BASIC_UNFILTERED)
    test.assert_eq(list.len(p), 7)
    let want: [u8] = [0x01, 0x60, 0x00, 0x30, 0x00, 0x01, 0x00]
    for i in 0..7
        test.assert_eq(p[i] as Int, want[i] as Int)
    let wide = build_le_set_scan_parameters(LE_SCAN_TYPE_PASSIVE, 0x4000, 0x1234, OWN_ADDR_TYPE_PUBLIC, SCAN_FILTER_BASIC_UNFILTERED)
    test.assert_eq(wide[0] as Int, 0x00)
    test.assert_eq(wide[2] as Int, 0x40)
    test.assert_eq(wide[3] as Int, 0x34)
    test.assert_eq(wide[4] as Int, 0x12)

@test
fn test_build_set_event_mask_with_le_meta()
    test.assert_eq(opcode_hci_set_event_mask(), 0x0C01)
    let p = build_set_event_mask(EVENT_MASK_DEFAULT | EVENT_MASK_LE_META)
    let want: [u8] = [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x1F, 0x00, 0x20]
    test.assert_eq(list.len(p), 8)
    for i in 0..8
        test.assert_eq(p[i] as Int, want[i] as Int)

@test
fn test_build_le_set_scan_enable()
    let on = build_le_set_scan_enable(true, false)
    test.assert_eq(list.len(on), 2)
    test.assert_eq(on[0] as Int, 0x01)
    test.assert_eq(on[1] as Int, 0x00)
    let off = build_le_set_scan_enable(false, true)
    test.assert_eq(off[0] as Int, 0x00)
    test.assert_eq(off[1] as Int, 0x01)

