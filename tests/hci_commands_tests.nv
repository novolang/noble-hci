@test
fn test_build_le_long_term_key_request_reply()
    var ltk: [u8] = []
    for i in 0..16
        list.push(ltk, i as u8)
    let p = build_le_long_term_key_request_reply(0x0040, ltk)
    test.assert_eq(list.len(p), 18)
    test.assert_eq(p[0] as Int, 0x40)
    test.assert_eq(p[1] as Int, 0x00)
    test.assert_eq(p[2] as Int, 0x00)
    test.assert_eq(p[17] as Int, 15)

@test
fn test_default_adv_interval_is_100ms()
    // 100 ms / 0.625 ms = 160 = 0xA0.
    test.assert_eq(adv_interval_min_default(), 0xA0)
    test.assert_eq(ADV_INTERVAL_MAX_DEFAULT, 0xA0)

@test
fn test_adv_interval_units_from_ms()
    // 100 ms is 160 units, the default.
    test.assert_eq(adv_interval_units(100) ?? -1, 0xA0)
    test.assert_eq(adv_interval_units(20) ?? -1, 0x20)
    test.assert_eq(adv_interval_units(10240) ?? -1, 0x4000)
    test.assert_eq(adv_interval_units(19) ?? -1, -1)
    test.assert_eq(adv_interval_units(10241) ?? -1, -1)

@test
@satisfies("REQ-BLE-HCI-016")
fn test_build_le_adv_data_block_pads_to_32()
    let ad: [u8] = [0x02, 0x01, 0x06]
    match build_le_adv_data_block(ad)
        None        => test.fail("three bytes of data fit")
        Some(block) =>
            test.assert_eq(list.len(block), 32)
            test.assert_eq(block[0] as Int, 3)
            test.assert_eq(block[1] as Int, 0x02)
            test.assert_eq(block[3] as Int, 0x06)
            test.assert_eq(block[4] as Int, 0x00)
            test.assert_eq(block[31] as Int, 0x00)

@test
@satisfies("REQ-BLE-HCI-016")
fn test_build_le_adv_data_block_limits()
    var full: [u8] = []
    for i in 0..31
        list.push(full, i as u8)
    match build_le_adv_data_block(full)
        None        => test.fail("31 bytes of data fit")
        Some(block) =>
            test.assert_eq(list.len(block), 32)
            test.assert_eq(block[0] as Int, 31)
            test.assert_eq(block[31] as Int, 30)
    list.push(full, 31)
    match build_le_adv_data_block(full)
        None    => test.assert(true)
        Some(_) => test.fail("32 bytes of data do not fit")

