    test.assert_eq(p[0] as Int, 0x05)
    test.assert_eq(p[1] as Int, 0x00)

@test
fn test_le_event_mask_periodic_advertising_bits()
    // Bits 13, 14 and 15 for the Observer's three events, and bit 23 for
    // the transfer the Peripheral receives ([Vol 4] Part E, Section
    // 7.8.1).  Bit 23 is byte 2 bit 7 of the command's eight octets.
    test.assert_eq(LE_EVENT_MASK_PERIODIC_ADVERTISING, 0x80E000)
    test.assert_eq(LE_EVENT_MASK_PERIODIC_ADVERTISING & LE_EVENT_MASK_DEFAULT, 0)
    let p = build_set_event_mask(LE_EVENT_MASK_DEFAULT | LE_EVENT_MASK_PERIODIC_ADVERTISING)
    test.assert_eq(p[0] as Int, 0x1F)
    test.assert_eq(p[1] as Int, 0xE0)
    test.assert_eq(p[2] as Int, 0x80)
    test.assert_eq(p[3] as Int, 0x00)

@test
fn test_extended_scan_opcodes_and_layout()
    test.assert_eq(opcode_le_set_extended_scan_parameters(), 0x2041)
    test.assert_eq(opcode_le_set_extended_scan_enable(), 0x2042)
    // Passive scanning on the LE 1M PHY, random address, basic filter.
    let p = build_le_set_extended_scan_parameters(OWN_ADDR_TYPE_RANDOM,
        SCAN_FILTER_BASIC_UNFILTERED,
        SCANNING_PHY_1M,
        LE_SCAN_TYPE_PASSIVE,
        0x0060,
        0x0030)
    test.assert_eq(list.len(p), 8)
    let want: [u8] = [0x01, 0x00, 0x01, 0x00, 0x60, 0x00, 0x30, 0x00]
    for i in 0..8
        test.assert_eq(p[i] as Int, want[i] as Int)
    let on = build_le_set_extended_scan_enable(true, false)
    test.assert_eq(list.len(on), 6)
    test.assert_eq(on[0] as Int, 0x01)
    test.assert_eq(on[1] as Int, 0x00)
    test.assert_eq(on[5] as Int, 0x00)
    let off = build_le_set_extended_scan_enable(false, false)
    test.assert_eq(off[0] as Int, 0x00)
    test.assert_eq(SCANNING_PHY_1M, 0x01)

// The two commands of the responses family this Host sends: the [v2]
// periodic advertising parameters, whose twelve octets are what tells a
// Controller the train carries subevents, and the subevent data, whose
// parameter list numbers its arrays together.
@test
@satisfies("REQ-BLE-HCI-056")
fn test_pawr_opcodes_and_parameter_layout()
    test.assert_eq(opcode_le_set_periodic_advertising_parameters_v2(), 0x2086)
    test.assert_eq(opcode_le_set_periodic_advertising_subevent_data(), 0x2082)
    // The AutoPTS project's own numbers: 150 to 200 units, 10 subevents,
    // subevent interval 15, response slot delay 1, response slot spacing
    // 4 and 5 response slots.
    let params = build_le_set_periodic_advertising_parameters_v2(0x00, 0x0096, 0x00C8, 0x0000, 10, 15, 1, 4, 5)
    test.assert_eq(list.len(params), 12)
    let want: [u8] = [0x00, 0x96, 0x00, 0xC8, 0x00, 0x00, 0x00, 10, 15, 1, 4, 5]
    for i in 0..12
        test.assert_eq(params[i] as Int, want[i] as Int)

@test
@satisfies("REQ-BLE-HCI-056")
fn test_pawr_subevent_data_layout()
    let data: [u8] = [0x0C, 0x08, 'P', 'A']
    let one = PawrSubevent { subevent: 3, response_slot_start: 0, response_slot_count: 5, data: data }
    match build_le_set_periodic_advertising_subevent_data(0x00, [one])
        None    => test.fail("one subevent of four octets fits")
        Some(p) =>
            // Handle, count, the four one-octet fields of the subevent,
            // then its data: two and four and four.
            test.assert_eq(list.len(p), 10)
            let want: [u8] = [0x00, 0x01, 0x03, 0x00, 0x05, 0x04, 0x0C, 0x08, 'P', 'A']
            for i in 0..10
                test.assert_eq(p[i] as Int, want[i] as Int)
    // Two subevents: each element is its four fields and then its data.
    let two = PawrSubevent { subevent: 0, response_slot_start: 1, response_slot_count: 2, data: data }
    match build_le_set_periodic_advertising_subevent_data(0x00, [one, two])
        None    => test.fail("two subevents fit one command")
        Some(p) =>
            // Two octets, then per element four fields and four data octets.
            test.assert_eq(list.len(p), 2 + 8 + 8)
            let want2: [u8] = [0x00, 0x02,
                               0x03, 0x00, 0x05, 0x04, 0x0C, 0x08, 'P', 'A',
                               0x00, 0x01, 0x02, 0x04, 0x0C, 0x08, 'P', 'A']
            for i in 0..18
                test.assert_eq(p[i] as Int, want2[i] as Int)
    // No subevent at all, and more than the 0x0F the count field holds.
    match build_le_set_periodic_advertising_subevent_data(0x00, [])
        None    => ()
        Some(_) => test.fail("a command with no subevent is refused")
    var many: [PawrSubevent] = []
    for i in 0..16
        list.push(many, one)
    match build_le_set_periodic_advertising_subevent_data(0x00, many)
        None    => ()
        Some(_) => test.fail("sixteen subevents do not fit one command")
    // A subevent above 0x7F and data above 251 octets are refused too.
    let high = PawrSubevent { subevent: 0x80, response_slot_start: 0, response_slot_count: 0, data: [] }
    match build_le_set_periodic_advertising_subevent_data(0x00, [high])
        None    => ()
        Some(_) => test.fail("a subevent above 0x7F is refused")
    var big: [u8] = []
    for _ in 0..252
        list.push(big, 0x00)
    let long = PawrSubevent { subevent: 0x00, response_slot_start: 0, response_slot_count: 0, data: big }
    match build_le_set_periodic_advertising_subevent_data(0x00, [long])
        None    => ()
        Some(_) => test.fail("252 octets of subevent data are refused")

@test
@satisfies("REQ-BLE-HCI-056")
fn test_pawr_event_mask_bits()
    // Bits 38 and 39 only, and neither of them in the plain periodic
    // advertising mask.
    test.assert_eq(LE_EVENT_MASK_PERIODIC_ADVERTISING_RESPONSES, 0x000000C000000000)
    test.assert_eq(LE_EVENT_MASK_PERIODIC_ADVERTISING & LE_EVENT_MASK_PERIODIC_ADVERTISING_RESPONSES, 0)
    test.assert_eq(LE_EVENT_MASK_DEFAULT & LE_EVENT_MASK_PERIODIC_ADVERTISING_RESPONSES, 0)
    test.assert_eq(PAWR_SUBEVENT_INTERVAL_MIN, 0x06)
    test.assert_eq(PAWR_RESPONSE_SLOT_DELAY_MIN, 0x01)

@test
@satisfies("REQ-BLE-HCI-057")
fn test_iso_opcodes()
    test.assert_eq(opcode_le_read_buffer_size_v2(), 0x2060)
    test.assert_eq(opcode_le_read_iso_tx_sync(), 0x2061)
    test.assert_eq(opcode_le_set_cig_parameters(), 0x2062)
    test.assert_eq(opcode_le_set_cig_parameters_test(), 0x2063)
    test.assert_eq(opcode_le_create_cis(), 0x2064)
    test.assert_eq(opcode_le_remove_cig(), 0x2065)
    test.assert_eq(opcode_le_accept_cis_request(), 0x2066)
    test.assert_eq(opcode_le_reject_cis_request(), 0x2067)
    test.assert_eq(opcode_le_create_big(), 0x2068)
    test.assert_eq(opcode_le_create_big_test(), 0x2069)
    test.assert_eq(opcode_le_terminate_big(), 0x206A)
    test.assert_eq(opcode_le_big_create_sync(), 0x206B)
    test.assert_eq(opcode_le_big_terminate_sync(), 0x206C)
    test.assert_eq(opcode_le_setup_iso_data_path(), 0x206E)
    test.assert_eq(opcode_le_remove_iso_data_path(), 0x206F)
    test.assert_eq(opcode_le_iso_transmit_test(), 0x2070)
    test.assert_eq(opcode_le_iso_receive_test(), 0x2071)
    test.assert_eq(opcode_le_iso_read_test_counters(), 0x2072)
    test.assert_eq(opcode_le_iso_test_end(), 0x2073)
    test.assert_eq(opcode_le_set_host_feature(), 0x2074)
    test.assert_eq(opcode_le_read_iso_link_quality(), 0x2075)
    test.assert_eq(opcode_le_set_host_feature_v2(), 0x2097)

@test
@satisfies("REQ-BLE-HCI-057")
fn test_set_host_feature_layout()
    // Bit 32, Connected Isochronous Stream (Host Support), on and off.
    same_octets(build_le_set_host_feature(FEATURE_CONNECTED_ISOCHRONOUS_STREAM_HOST_SUPPORT, true),
        [0x20, 0x01])
    same_octets(build_le_set_host_feature(FEATURE_CONNECTED_ISOCHRONOUS_STREAM_HOST_SUPPORT, false),
        [0x20, 0x00])
    // The [v2] form widens Bit_Number to two octets.
    same_octets(build_le_set_host_feature_v2(0x0123, true), [0x23, 0x01, 0x01])

@test
@satisfies("REQ-BLE-HCI-057")
fn test_connection_handle_only_commands()
    // 12 bits meaningful: the top four bits of the second octet are clear.
    same_octets(build_iso_connection_handle(0x0ABC), [0xBC, 0x0A])
    same_octets(build_iso_connection_handle(0xFABC), [0xBC, 0x0A])
    same_octets(build_le_reject_cis_request(0x0102, 0x0D), [0x02, 0x01, 0x0D])
    same_octets(build_le_accept_cis_request(0x0102), [0x02, 0x01])
    same_octets(build_le_remove_cig(0x07), [0x07])
    same_octets(build_le_big_terminate_sync(0x03), [0x03])
    same_octets(build_le_terminate_big(0x02, 0x16), [0x02, 0x16])
    same_octets(build_le_remove_iso_data_path(0x0040, 0x03), [0x40, 0x00, 0x03])
    same_octets(build_le_iso_test(0x0041, ISO_TEST_PAYLOAD_MAXIMUM_LENGTH), [0x41, 0x00, 0x02])

// The arrayed CIS parameters go out element by element ([Vol 4] Part E,
// Section 5.4), so a second CIS starts with its CIS_ID and not with the
// first CIS's second field.
@test
@satisfies("REQ-BLE-HCI-057")
fn test_set_cig_parameters_layout()
    let head: [u8] = [0x01, 0x10, 0x27, 0x00, 0x20, 0x4E, 0x00, 0x07, 0x01, 0x01, 0x14, 0x00, 0x28, 0x00]
    match build_le_set_cig_parameters(cig_fixture(), [cis_fixture(0)])
        None    => test.fail("one CIS fits")
        Some(p) =>
            var want: [u8] = head[:]
            list.append(want, [0x01, 0x00, 0x64, 0x00, 0xC8, 0x00, 0x02, 0x03, 0x02, 0x05])
            same_octets(p, want)
    match build_le_set_cig_parameters(cig_fixture(), [cis_fixture(0), cis_fixture(1), cis_fixture(2)])
        None    => test.fail("three CISes fit")
        Some(p) =>
            var want: [u8] = head[:]
            list.append(want, [0x03])
            list.append(want, [0x00, 0x64, 0x00, 0xC8, 0x00, 0x02, 0x03, 0x02, 0x05])
            list.append(want, [0x01, 0x65, 0x00, 0xC9, 0x00, 0x02, 0x03, 0x03, 0x06])
            list.append(want, [0x02, 0x66, 0x00, 0xCA, 0x00, 0x02, 0x03, 0x04, 0x07])
            same_octets(p, want)
    // An empty list encodes as CIS_Count 0; 32 CISes do not fit the count.
    match build_le_set_cig_parameters(cig_fixture(), [])
        None    => test.fail("an empty list encodes")
        Some(p) => test.assert_eq(list.len(p), 15)
    var many: [CisParameters] = []
    for i in 0..32
        list.push(many, cis_fixture(i))
    test.assert(build_le_set_cig_parameters(cig_fixture(), many) == None)

@test
@satisfies("REQ-BLE-HCI-057")
fn test_set_cig_parameters_test_layout()
    let cig = CigTestParameters {
        cig_id: 0x02, sdu_interval_c_to_p: 0x002710, sdu_interval_p_to_c: 0x002710,
        ft_c_to_p: 0x01, ft_p_to_c: 0x02, iso_interval: 0x0008,
        worst_case_sca: 0x00, packing: ISO_PACKING_SEQUENTIAL, framing: ISO_FRAMING_UNFRAMED }
    let a = CisTestParameters {
        cis_id: 0x00, nse: 0x03, max_sdu_c_to_p: 0x0064, max_sdu_p_to_c: 0x0000,
        max_pdu_c_to_p: 0x0064, max_pdu_p_to_c: 0x0000, phy_c_to_p: 0x02, phy_p_to_c: 0x02,
        bn_c_to_p: 0x01, bn_p_to_c: 0x00 }
    let b = CisTestParameters {
        cis_id: 0x01, nse: 0x04, max_sdu_c_to_p: 0x00FB, max_sdu_p_to_c: 0x00FB,
        max_pdu_c_to_p: 0x00FB, max_pdu_p_to_c: 0x00FB, phy_c_to_p: 0x01, phy_p_to_c: 0x01,
        bn_c_to_p: 0x02, bn_p_to_c: 0x02 }
    let head: [u8] = [0x02, 0x10, 0x27, 0x00, 0x10, 0x27, 0x00, 0x01, 0x02, 0x08, 0x00, 0x00, 0x00, 0x00]
    match build_le_set_cig_parameters_test(cig, [a])
        None    => test.fail("one CIS fits")
        Some(p) =>
            var want: [u8] = head[:]
            list.append(want, [0x01,
                0x00,
                0x03,
                0x64,
                0x00,
                0x00,
                0x00,
                0x64,
                0x00,
                0x00,
                0x00,
                0x02,
                0x02,
                0x01,
                0x00])
            same_octets(p, want)
    match build_le_set_cig_parameters_test(cig, [a, b, a])
        None    => test.fail("three CISes fit")
        Some(p) =>
            var want: [u8] = head[:]
            list.append(want, [0x03])
            list.append(want,
                [0x00, 0x03, 0x64, 0x00, 0x00, 0x00, 0x64, 0x00, 0x00, 0x00, 0x02, 0x02, 0x01, 0x00])
            list.append(want,
                [0x01, 0x04, 0xFB, 0x00, 0xFB, 0x00, 0xFB, 0x00, 0xFB, 0x00, 0x01, 0x01, 0x02, 0x02])
            list.append(want,
                [0x00, 0x03, 0x64, 0x00, 0x00, 0x00, 0x64, 0x00, 0x00, 0x00, 0x02, 0x02, 0x01, 0x00])
            same_octets(p, want)
    var many: [CisTestParameters] = []
    for _ in 0..32
        list.push(many, a)
    test.assert(build_le_set_cig_parameters_test(cig, many) == None)

@test
@satisfies("REQ-BLE-HCI-057")
fn test_create_cis_pairs_go_element_by_element()
    match build_le_create_cis([CisLink { cis_connection_handle: 0x0010, acl_connection_handle: 0x0001 }])
        None    => test.fail("one link fits")
        Some(p) => same_octets(p, [0x01, 0x10, 0x00, 0x01, 0x00])
    let three = [CisLink { cis_connection_handle: 0x0010, acl_connection_handle: 0x0001 },
                 CisLink { cis_connection_handle: 0x0011, acl_connection_handle: 0x0002 },
                 CisLink { cis_connection_handle: 0x0012, acl_connection_handle: 0x0003 }]
    match build_le_create_cis(three)
        None    => test.fail("three links fit")
        Some(p) => same_octets(p, [0x03, 0x10, 0x00, 0x01, 0x00, 0x11, 0x00, 0x02, 0x00, 0x12, 0x00, 0x03, 0x00])
    test.assert(build_le_create_cis([]) == None)
    var many: [CisLink] = []
    for _ in 0..32
        list.push(many, three[0])
    test.assert(build_le_create_cis(many) == None)

@test
@satisfies("REQ-BLE-HCI-057")
fn test_create_big_layout()
    let code = broadcast_code_fixture()
    match build_le_create_big(0x01,
        0x02,
        0x02,
        0x002710,
        0x0064,
        0x0014,
        0x03,
        0x02,
        ISO_PACKING_INTERLEAVED,
        ISO_FRAMING_UNFRAMED,
        true,
        code)
        None    => test.fail("two BIS fit")
        Some(p) =>
            var want: [u8] = [0x01,
                0x02,
                0x02,
                0x10,
                0x27,
                0x00,
                0x64,
                0x00,
                0x14,
                0x00,
                0x03,
                0x02,
                0x01,
                0x00,
                0x01]
            list.append(want, code)
            same_octets(p, want)
            test.assert_eq(list.len(p), 31)
    test.assert(build_le_create_big(0x01, 0x02, 0x00, 0x002710, 0x0064, 0x0014, 0x03, 0x02, 0x00, 0x00, false, code) == None)
    test.assert(build_le_create_big(0x01, 0x02, 0x20, 0x002710, 0x0064, 0x0014, 0x03, 0x02, 0x00, 0x00, false, code) == None)
    test.assert(build_le_create_big(0x01, 0x02, 0x01, 0x002710, 0x0064, 0x0014, 0x03, 0x02, 0x00, 0x00, false, code[0:15]) == None)

