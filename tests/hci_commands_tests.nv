// SDU_Interval is 0x0000FF to 0x0FFFFF microseconds in the four commands
// that carry it ([Vol 4] Part E, Section 7.8.97, 7.8.98, 7.8.103 and
// 7.8.104).  The bounds themselves are accepted; one below, one above, and
// a value that does not fit the three octets (which would otherwise be cut
// to its low 24 bits) are refused.
@test
@satisfies("REQ-BLE-HCI-057")
fn test_sdu_interval_range_is_checked_by_the_four_builders()
    test.assert(iso_sdu_interval_ok(0x0000FF))
    test.assert(iso_sdu_interval_ok(0x0FFFFF))
    test.assert(not iso_sdu_interval_ok(0x0000FE))
    test.assert(not iso_sdu_interval_ok(0x100000))
    test.assert(not iso_sdu_interval_ok(0x1000000))
    test.assert(not iso_sdu_interval_ok(-1))
    let code = broadcast_code_fixture()
    for bad in [0, 0xFE, 0x100000, 0xFFFFFF, 0x1002710]
        // Either direction of the CIG commands.
        test.assert(build_le_set_cig_parameters(cig_with_intervals(bad, 0x002710), [cis_fixture(0)]) == None)
        test.assert(build_le_set_cig_parameters(cig_with_intervals(0x002710, bad), [cis_fixture(0)]) == None)
        let t = CigTestParameters {
            cig_id: 0x02, sdu_interval_c_to_p: bad, sdu_interval_p_to_c: 0x002710,
            ft_c_to_p: 0x01, ft_p_to_c: 0x01, iso_interval: 0x0008,
            worst_case_sca: 0x00, packing: ISO_PACKING_SEQUENTIAL, framing: ISO_FRAMING_UNFRAMED }
        test.assert(build_le_set_cig_parameters_test(t, []) == None)
        let u = CigTestParameters {
            cig_id: 0x02, sdu_interval_c_to_p: 0x002710, sdu_interval_p_to_c: bad,
            ft_c_to_p: 0x01, ft_p_to_c: 0x01, iso_interval: 0x0008,
            worst_case_sca: 0x00, packing: ISO_PACKING_SEQUENTIAL, framing: ISO_FRAMING_UNFRAMED }
        test.assert(build_le_set_cig_parameters_test(u, []) == None)
        test.assert(build_le_create_big(0x01, 0x02, 0x01, bad, 0x0064, 0x0014, 0x03, 0x02, 0x00, 0x00, false, code) == None)
        test.assert(build_le_create_big_test(0x01,
            0x02,
            0x01,
            bad,
            0x0008,
            0x02,
            0x0064,
            0x0064,
            0x02,
            0x00,
            0x00,
            0x01,
            0x01,
            0x00,
            false,
            code) == None)
    // The bounds build.
    for good in [0x0000FF, 0x0FFFFF]
        test.assert(build_le_set_cig_parameters(cig_with_intervals(good, good), [cis_fixture(0)]) != None)
        test.assert(build_le_create_big(0x01, 0x02, 0x01, good, 0x0064, 0x0014, 0x03, 0x02, 0x00, 0x00, false, code) != None)
        test.assert(build_le_create_big_test(0x01,
            0x02,
            0x01,
            good,
            0x0008,
            0x02,
            0x0064,
            0x0064,
            0x02,
            0x00,
            0x00,
            0x01,
            0x01,
            0x00,
            false,
            code) != None)

@test
@satisfies("REQ-BLE-HCI-057")
fn test_big_create_sync_layout()
    let code = broadcast_code_fixture()
    match build_le_big_create_sync(0x01, 0x0123, true, code, 0x00, 0x0C80, [0x01])
        None    => test.fail("one BIS fits")
        Some(p) =>
            var want: [u8] = [0x01, 0x23, 0x01, 0x01]
            list.append(want, code)
            list.append(want, [0x00, 0x80, 0x0C, 0x01, 0x01])
            same_octets(p, want)
    match build_le_big_create_sync(0x01, 0x0123, false, code, 0x03, 0x0C80, [0x01, 0x02, 0x05])
        None    => test.fail("three BIS fit")
        Some(p) =>
            // BIG_Handle, Sync_Handle, Encryption, Broadcast_Code, then MSE,
            // BIG_Sync_Timeout, Num_BIS and the three BIS indexes.
            test.assert_eq(list.len(p), 1 + 2 + 1 + 16 + 1 + 2 + 1 + 3)
            same_octets(p[20:], [0x03, 0x80, 0x0C, 0x03, 0x01, 0x02, 0x05])
    test.assert(build_le_big_create_sync(0x01, 0x0123, false, code, 0, 0x0C80, []) == None)
    test.assert(build_le_big_create_sync(0x01, 0x0123, false, code[0:8], 0, 0x0C80, [0x01]) == None)
    var many: [Int] = []
    for _ in 0..32
        list.push(many, 1)
    test.assert(build_le_big_create_sync(0x01, 0x0123, false, code, 0, 0x0C80, many) == None)

@test
@satisfies("REQ-BLE-HCI-057")
fn test_setup_iso_data_path_layout()
    let lc3 = iso_codec_id(ISO_CODING_FORMAT_LC3, 0x0000, 0x0000)
    same_octets(lc3, [0x06, 0x00, 0x00, 0x00, 0x00])
    same_octets(iso_codec_id(ISO_CODING_FORMAT_VENDOR_SPECIFIC, 0x0059, 0x1234),
        [0xFF, 0x59, 0x00, 0x34, 0x12])
    match build_le_setup_iso_data_path(0x0040, ISO_DATA_PATH_INPUT, ISO_DATA_PATH_HCI, lc3, 0x000A28, [])
        None    => test.fail("an empty configuration fits")
        Some(p) => same_octets(p, [0x40, 0x00, 0x00, 0x00, 0x06, 0x00, 0x00, 0x00, 0x00, 0x28, 0x0A, 0x00, 0x00])
    match build_le_setup_iso_data_path(0x0041,
        ISO_DATA_PATH_OUTPUT,
        0x01,
        iso_codec_id(ISO_CODING_FORMAT_TRANSPARENT, 0, 0),
        0x000000,
        [0xAA, 0xBB, 0xCC])
        None    => test.fail("a configuration of three octets fits")
        Some(p) =>
            test.assert_eq(list.len(p), 13 + 3)
            same_octets(p[12:16], [0x03, 0xAA, 0xBB, 0xCC])
    test.assert(build_le_setup_iso_data_path(0x0040, 0, 0, [0x06], 0, []) == None)
    var big: [u8] = []
    for _ in 0..256
        list.push(big, 0x00)
    test.assert(build_le_setup_iso_data_path(0x0040, 0, 0, lc3, 0, big) == None)

@test
@satisfies("REQ-BLE-HCI-057")
fn test_iso_event_mask_bits()
    // Subevent code minus one: 0x19 -> 24, 0x1A -> 25, 0x1B..0x1E -> 26..29,
    // 0x22 -> 33, 0x2A -> 41.
    test.assert_eq(LE_EVENT_MASK_CIS_ESTABLISHED, 1 << 24)
    test.assert_eq(LE_EVENT_MASK_CIS_REQUEST, 1 << 25)
    test.assert_eq(LE_EVENT_MASK_BIG, (1 << 26) | (1 << 27) | (1 << 28) | (1 << 29))
    test.assert_eq(LE_EVENT_MASK_BIG_BROADCASTER, (1 << 26) | (1 << 27))
    test.assert_eq(LE_EVENT_MASK_BIG_RECEIVER, (1 << 28) | (1 << 29))
    test.assert_eq(LE_EVENT_MASK_BIG_BROADCASTER | LE_EVENT_MASK_BIG_RECEIVER, LE_EVENT_MASK_BIG)
    test.assert_eq(LE_EVENT_MASK_BIG_INFO_ADVERTISING_REPORT, 1 << 33)
    test.assert_eq(LE_EVENT_MASK_CIS_ESTABLISHED_V2, 1 << 41)
    test.assert_eq(LE_EVENT_MASK_ISOCHRONOUS,
        LE_EVENT_MASK_CIS_ESTABLISHED | LE_EVENT_MASK_CIS_REQUEST | LE_EVENT_MASK_BIG
        | LE_EVENT_MASK_BIG_INFO_ADVERTISING_REPORT | LE_EVENT_MASK_CIS_ESTABLISHED_V2)
    test.assert_eq(LE_EVENT_MASK_ISOCHRONOUS & (LE_EVENT_MASK_DEFAULT | LE_EVENT_MASK_PERIODIC_ADVERTISING | LE_EVENT_MASK_PERIODIC_ADVERTISING_RESPONSES),
        0)
    same_octets(build_set_event_mask(LE_EVENT_MASK_ISOCHRONOUS),
        [0x00, 0x00, 0x00, 0x3F, 0x02, 0x02, 0x00, 0x00])

@test
@satisfies("REQ-BLE-HCI-057")
fn test_le_octets_helpers()
    same_octets(le16_octets(0x1234), [0x34, 0x12])
    same_octets(le16_octets(0x11234), [0x34, 0x12])
    same_octets(le32_octets(0x01020304), [0x04, 0x03, 0x02, 0x01])
    same_octets(le32_octets(0xDEADBEEF), [0xEF, 0xBE, 0xAD, 0xDE])
