fn cig_fixture() -> CigParameters
    CigParameters {
        cig_id: 0x01,
        sdu_interval_c_to_p: 0x002710,
        sdu_interval_p_to_c: 0x004E20,
        worst_case_sca: 0x07,
        packing: ISO_PACKING_INTERLEAVED,
        framing: ISO_FRAMING_FRAMED_SEGMENTABLE,
        max_transport_latency_c_to_p: 0x0014,
        max_transport_latency_p_to_c: 0x0028 }

